diff --git a/scripts/pspexp.lua b/scripts/pspexp.lua
new file mode 100644
index 0000000..52fa338
--- /dev/null
+++ b/scripts/pspexp.lua
@@ -0,0 +1,31 @@
+--      pspexp.lua - maps played at their own screen size (PSPExp)
+--
+--      The menus are laid out for 640x480; a map can be played at another
+--      size, wc2.preferences.GameVideoWidth x GameVideoHeight (0: the menus'
+--      own): PSPExp plays at the PSP's 480x272, drawn pixel for pixel, with
+--      ui_small.lua's layout. The screen is resized before a map, a saved
+--      game or a replay starts, and back when it ends.
+--
+--      This program is free software; you can redistribute it and/or modify
+--      it under the terms of the GNU General Public License as published by
+--      the Free Software Foundation; either version 2 of the License, or
+--      (at your option) any later version.
+
+local function game_screen(on)
+  local w, h = wc2.preferences.GameVideoWidth or 0, wc2.preferences.GameVideoHeight or 0
+  if w <= 0 or h <= 0 then return end
+  if not on then w, h = wc2.preferences.VideoWidth, wc2.preferences.VideoHeight end
+  if Video.Width ~= w or Video.Height ~= h then Video:ResizeScreen(w, h) end
+end
+
+for _, name in ipairs({"StartMap", "StartSavedGame", "StartReplay"}) do
+  local start = _G[name]
+  if start then
+    _G[name] = function(...)
+      game_screen(true)
+      local r = start(...)
+      game_screen(false)
+      return r
+    end
+  end
+end
