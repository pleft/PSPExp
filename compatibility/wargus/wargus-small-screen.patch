new file mode 100644
index 0000000..914ff68
--- /dev/null
+++ b/scripts/pspexp.lua
@@ -0,0 +1,19 @@
+--      pspexp.lua - Wargus on a screen of its own size (PSPExp)
+--
+--      wc2.preferences.FixedVideoWidth x FixedVideoHeight (0: off), when set,
+--      is the screen's size whatever VideoWidth/Height say: PSPExp plays at
+--      the PSP's 480x272, drawn pixel for pixel (shrunk from 640x480 its text
+--      was unreadable). Under 400 lines the menus (SmallScreen in guichan.lua
+--      and the menus' files) and the game (ui_small.lua) are laid out for it.
+--      Loaded by stratagus.lua before SetVideoResolution: the first size set
+--      is the one kept.
+--
+--      This program is free software; you can redistribute it and/or modify
+--      it under the terms of the GNU General Public License as published by
+--      the Free Software Foundation; either version 2 of the License, or
+--      (at your option) any later version.
+
+local w, h = wc2.preferences.FixedVideoWidth or 0, wc2.preferences.FixedVideoHeight or 0
+if w > 0 and h > 0 then
+  SetVideoResolution(w, h)
+end
