+-- PSPExp: on a screen under 400 lines (the PSP's 480x272, pspexp.lua) the
+-- menus are laid out for it rather than for 640x480
+SmallScreen = Video.Height < 400
+
+-- a full-screen menu's buttons on a small screen (224x28, 34 apart), in one
+-- column or, past five, two read down, ending 8 above the bottom (under the
+-- background's title); buttons = {{caption, hotkey, callback}, ...}; a
+-- title above them; the top row's y
+function AddSmallMenuButtons(menu, buttons, title)
+  local cols = (#buttons > 5) and 2 or 1
+  local rows = math.ceil(#buttons / cols)
+  local y = Video.Height - 8 - 28 - (rows - 1) * 34
+  local x = (Video.Width - cols * 224 - (cols - 1) * 8) / 2
+  if title then
+    menu:addLabel(title, Video.Width / 2, y - 24)
+  end
+  for i, b in ipairs(buttons) do
+    local col, row = math.floor((i - 1) / rows), (i - 1) % rows
+    menu:addFullButton(b[1], b[2], x + col * 232, y + row * 34, b[3])
+  end
+  return y
+end
+
+-- a panel menu (panel(n), w x h) on a small screen: the panel's picture
+-- squeezed to the screen's height and the menu centred; the height used
+function SmallPanelHeight(h)
+  return math.min(h, Video.Height)
+end
+
+-- the map lists' own game setups (scripts/lists/maps: Skirmish Classic, Front
+-- Lines, For the Motherland) on a small screen, placed as the game setup's:
+-- the scenario along the top, the settings down the left with their labels
+-- beside them (k from 0), the three buttons down the right (i from 0)
+function SmallSetupScenario(menu)
+  menu:addLabel(_("Scenario:"), 4, 2, Fonts["game"], false)
+  local mapl = menu:addLabel(string.sub(mapname, 6), 4, 13, Fonts["game"], false)
+  local descriptionl = menu:addLabel("descriptionl", 70, 2, Fonts["game"], false)
+  return mapl, descriptionl
+end
+
+function SmallSetupButton(i)
+  return Video.Width - 224, Video.Height - 4 - 28 - 34 * (2 - i)
+end
+
+function SmallSetupOption(menu, k, label, list)
+  local y = 30 + 24 * k
+  menu:addLabel(label, 8, y + 6, Fonts["small"], false)
+  local dd = menu:addDropDown(list, 92, y, function(dd) end)
+  dd:setSize(148, 20)
+  return dd
+end
