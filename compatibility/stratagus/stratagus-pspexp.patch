+
+#ifndef PSPEXP_VIDEO_H
+#define PSPEXP_VIDEO_H
+
+//@{
+
+/*
+**  PSPExp backend: mirrors the engine's software rendering into PSPExp
+**  commands so a Sony PSP renders the game with its own GPU while the
+**  engine keeps running here. The software path into TheScreen is kept,
+**  so the desktop window shows the same frame for comparison.
+**
+**  Enabled by the PSPEXP environment variable: "usb" (a PSP over USB),
+**  "sdl" (the PSPExp SDL executor in a second window) or "null".
+**
+**  Hooks live at the leaves of CGraphic drawing (one blit each), the font
+**  glyph blit, the CVideo primitives, the legacy fog shroud, the minimap
+**  blit, and RealizeVideoMemory for the present.
+*/
+
+#include <SDL.h>
+
+namespace gcn { class SDLGraphics; }
+
+namespace PspExpVideo
+{
+/// A guisan graphics object that mirrors menu drawing into PSPExp commands.
+/// Falls back to a plain gcn::SDLGraphics when the backend is off.
+gcn::SDLGraphics *CreateGuiGraphics();
+
+/// Audio: install a post-mix tap on SDL_mixer's output (called from
+/// InitSound). The mixed stereo stream goes to the PSP; the local device
+/// is silenced.
+void AudioInstall();
+/// Read PSPEXP and connect. Returns true when the backend is active.
+bool Init();
+bool Active();
+void Shutdown();
+
+/// One frame's commands go out; paced on the PSP's PRESENT_DONE.
+void Present();
+/// Translate PSP controller samples into the engine's mouse/keyboard events.
+void PumpInput();
+
+/// A blit of surface rect (gx, gy, w, h) at screen (x, y). `clip` applies the
+/// engine's current clip rectangle, `alpha` 0..255, `flip` mirrors horizontally.
+void DrawSurface(SDL_Surface *surface, int gx, int gy, int w, int h, int x, int y,
+                 bool clip, int alpha, bool flip);
+void FillRect(Uint32 color, int x, int y, int w, int h, bool clip, int alpha);
+void DrawLine(Uint32 color, int x0, int y0, int x1, int y1, bool clip, int alpha);
+/// Screen-format colour helpers for the primitive hooks.
+void DrawRectOutline(Uint32 color, int x, int y, int w, int h, bool clip, int alpha);
+void DrawCircleOutline(Uint32 color, int cx, int cy, int r, bool clip, int alpha);
+void FillCircle(Uint32 color, int cx, int cy, int r, bool clip, int alpha);
+
+/// A surface whose pixels change (the minimap): re-uploaded only when its
+/// content differs from what the PSP holds.
+void DrawChangingSurface(SDL_Surface *surface, int x, int y);
+void MinimapChanged();
+/// A surface is being freed: release what the PSP holds for it.
+void SurfaceFreed(SDL_Surface *surface);
+
+/// Alpha the Trans* wrappers set around their delegated leaf blit.
+extern int PendingAlpha;
+} // namespace PspExpVideo
+
+//@}
+
+#endif // PSPEXP_VIDEO_H
