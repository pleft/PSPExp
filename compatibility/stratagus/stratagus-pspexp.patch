+namespace PspExpVideo
+{
+
+int PendingAlpha = 255;
+
+namespace
+{
+
+/*----------------------------------------------------------------------------
+--  State
+----------------------------------------------------------------------------*/
+
+enum class Mode { Off, Usb, Sdl, Null, Tcp };
+
+struct Page {
+	uint16_t tex = 0;
+	int x0 = 0, y0 = 0, w = 0, h = 0;   /// covered surface rectangle
+	int texw = 0, texh = 0;
+};
+
+struct PaletteVariant {
+	uint32_t hash;
+	uint16_t id;
+};
+
+struct Entry {
+	std::vector<Page> pages;
+	bool indexed = false;
+	std::vector<PaletteVariant> palettes;   /// FIFO of uploaded palette variants
+	uint32_t last_hash = 0;
+	uint16_t last_palette = PSPEXP_PALETTE_DEFAULT;
+	Uint32 last_used = 0;                   /// SDL ticks of the last draw
+	uint32_t pixel_hash = 0;                /// for surfaces re-uploaded on change (minimap)
+	uint32_t bytes = 0;                     /// bytes held on the PSP
+};
+
+Mode mode = Mode::Off;
+PspExpContext *ctx = nullptr;
+PspExpTransport *transport = nullptr;
+PspExpNullExecutor *nullExec = nullptr;
+#ifdef PSPEXP_HAVE_SDL
+PspExpSdlExecutor *sdlExec = nullptr;
+#endif
+#ifdef PSPEXP_HAVE_USB
+PspExpUsbOptions usbOpt;
+#endif
+PspExpTcpOptions tcpOpt;
+std::string tcpHost;
+Uint32 lastReconnectTry = 0;
+
+std::unordered_map<SDL_Surface *, Entry> entries;
+std::vector<uint16_t> freeHandles;
+uint16_t nextHandle = 1;
+
+bool frameOpen = false;
+bool clipValid = false;
+SDL_Rect lastClip = {0, 0, 0, 0};
+
+// pending quad batch
+std::vector<PspExpQuadRec> quads;
+uint16_t quadTex = 0, quadPal = PSPEXP_PALETTE_DEFAULT, quadFmt = PSPEXP_VTX_SPRITE_2D_5650;
+
+// an explicit clip rectangle (the GUI's) that overrides the engine's ClipX1..
+bool overrideClip = false;
+SDL_Rect overrideRect = {0, 0, 0, 0};
+
+// audio tap: SDL_mixer's post-mix callback fills a ring on its thread, the
+// main thread streams it to the PSP
+SDL_mutex *audioMutex = nullptr;
+std::vector<int16_t> audioRing;      /// stereo frames
+size_t audioHead = 0, audioTail = 0, audioBuffered = 0;
+bool audioInstalled = false;
+unsigned audioFramesSent = 0;
+
+// eviction: resources the game has not drawn for a while are released
+// (section 6.2: the host decides what to release; the PSP never evicts)
+constexpr Uint32 EvictAfterMs = 15000;
+Uint32 lastEvictScan = 0;
+uint32_t residentBytes = 0;
+
+// statistics for the log line
+Uint32 lastReport = 0;
+unsigned framesSinceReport = 0;
+unsigned uploadsSinceReport = 0;
+
+constexpr int MaxPaletteVariants = 64;
+constexpr int PageMax = 512;
+
+bool linkUp();
+
+/*----------------------------------------------------------------------------
+--  Helpers
+----------------------------------------------------------------------------*/
+
+uint16_t allocHandle()
+{
+	if (!freeHandles.empty()) {
+		uint16_t h = freeHandles.back();
+		freeHandles.pop_back();
+		return h;
+	}
+	if (nextHandle >= 65000) {
+		return 65000;   /// exhausted; uploads will fail with DUPLICATE_ID
+	}
+	return nextHandle++;
+}
+
+void freeHandle(uint16_t h)
+{
+	if (h != PSPEXP_PALETTE_DEFAULT && h < 65000) {
+		freeHandles.push_back(h);
+	}
+}
+
+void log(const char *msg)
+{
+	fprintf(stderr, "[pspexp] %s\n", msg);
+}
+
+void logFn(void *, const char *msg) { log(msg); }
+
+uint16_t screenColor5650(Uint32 color)
+{
+	Uint8 r, g, b;
+	SDL_GetRGB(color, TheScreen->format, &r, &g, &b);
+	return pspexp_color_5650(r, g, b);
+}
+
+int pow2ceil(int v, int minimum)
+{
+	int p = minimum;
+	while (p < v) {
+		p <<= 1;
+	}
+	return p;
+}
+
+uint32_t paletteHash(const SDL_Surface *s)
+{
+	const SDL_Palette *pal = s->format->palette;
+	uint32_t h = 2166136261u;
+	if (pal) {
+		const unsigned char *p = reinterpret_cast<const unsigned char *>(pal->colors);
+		const size_t n = size_t(pal->ncolors) * sizeof(SDL_Color);
+		for (size_t i = 0; i < n; ++i) {
+			h = (h ^ p[i]) * 16777619u;
+		}
+	}
+	Uint32 key = 0;
+	if (SDL_GetColorKey(const_cast<SDL_Surface *>(s), &key) == 0) {
+		h = (h ^ (key + 1)) * 16777619u;
+	}
+	return h;
+}
+
+/// Upload the surface's current palette as a 256-entry 5551 palette.
+uint16_t uploadPalette(const SDL_Surface *s)
+{
+	uint16_t colors[256];
+	memset(colors, 0, sizeof(colors));
+	const SDL_Palette *pal = s->format->palette;
+	Uint32 key = 0;
+	const bool hasKey = SDL_GetColorKey(const_cast<SDL_Surface *>(s), &key) == 0;
+	if (pal) {
+		const int n = std::min(pal->ncolors, 256);
+		for (int i = 0; i < n; ++i) {
+			const SDL_Color &c = pal->colors[i];
+			if (hasKey && Uint32(i) == key) {
+				continue;   /// transparent: alpha bit clear
+			}
+			colors[i] = uint16_t(0x8000 | ((c.b >> 3) << 10) | ((c.g >> 3) << 5) | (c.r >> 3));
+		}
+	}
+	const uint16_t id = allocHandle();
+	if (pspexp_upload_palette(ctx, id, PSPEXP_TEX_5551, 256, colors, sizeof(colors)) < 0) {
+		freeHandle(id);
+		return PSPEXP_PALETTE_DEFAULT;
+	}
+	++uploadsSinceReport;
+	return id;
+}
+
+/// Palette to draw an indexed surface with right now (its palette may have
+/// been changed for player colours, font colours or colour cycling).
+uint16_t currentPalette(Entry &e, const SDL_Surface *s)
+{
+	if (!e.indexed) {
+		return PSPEXP_PALETTE_DEFAULT;
+	}
+	const uint32_t h = paletteHash(s);
+	if (h == e.last_hash && e.last_palette != PSPEXP_PALETTE_DEFAULT) {
+		return e.last_palette;
+	}
+	for (const PaletteVariant &v : e.palettes) {
+		if (v.hash == h) {
+			e.last_hash = h;
+			e.last_palette = v.id;
+			return v.id;
+		}
+	}
+	const uint16_t id = uploadPalette(s);
+	if (id == PSPEXP_PALETTE_DEFAULT) {
+		return e.last_palette;
+	}
+	if (int(e.palettes.size()) >= MaxPaletteVariants) {
+		pspexp_release(ctx, e.palettes.front().id);
+		freeHandle(e.palettes.front().id);
+		e.palettes.erase(e.palettes.begin());
+	}
+	e.palettes.push_back({h, id});
+	e.last_hash = h;
+	e.last_palette = id;
+	return id;
+}
+
+/// Upload one page of a surface as a texture.
+bool uploadPage(SDL_Surface *s, Page &page, bool indexed, uint16_t palette)
+{
+	PspExpTextureDesc desc;
+	memset(&desc, 0, sizeof(desc));
+	desc.width = page.texw;
+	desc.height = page.texh;
+	desc.priority = PSPEXP_PRIORITY_NORMAL;
+	desc.palette = palette;
+	PspExpFrame frame = {0, 0, uint16_t(std::min(page.texw, 64)), uint16_t(page.texh)};
+
+	const bool locked = SDL_MUSTLOCK(s) && SDL_LockSurface(s) == 0;
+	std::vector<unsigned char> pixels;
+	int rc;
+	if (indexed) {
+		Uint32 key = 0;
+		const unsigned char fill = SDL_GetColorKey(s, &key) == 0 ? (unsigned char)key : 0;
+		std::vector<unsigned char> linear(size_t(page.texw) * page.texh, fill);
+		for (int y = 0; y < page.h; ++y) {
+			memcpy(&linear[size_t(y) * page.texw],
+			       static_cast<const unsigned char *>(s->pixels) + size_t(page.y0 + y) * s->pitch + page.x0,
+			       page.w);
+		}
+		pixels.resize(linear.size());
+		pspexp_swizzle(pixels.data(), linear.data(), page.texw, page.texh);
+		desc.format = PSPEXP_TEX_T8;
+		desc.layout = PSPEXP_LAYOUT_SWIZZLED;
+	} else {
+		Uint32 key = 0;
+		const bool hasKey = SDL_GetColorKey(s, &key) == 0;
+		pixels.assign(size_t(page.texw) * page.texh * 2, 0);
+		uint16_t *dst = reinterpret_cast<uint16_t *>(pixels.data());
+		const int bpp = s->format->BytesPerPixel;
+		for (int y = 0; y < page.h; ++y) {
+			const unsigned char *row = static_cast<const unsigned char *>(s->pixels) + size_t(page.y0 + y) * s->pitch;
+			for (int x = 0; x < page.w; ++x) {
+				const unsigned char *p = row + size_t(page.x0 + x) * bpp;
+				Uint32 pixel = 0;
+				switch (bpp) {
+					case 4: pixel = *reinterpret_cast<const Uint32 *>(p); break;
+					case 3: pixel = Uint32(p[0]) | (Uint32(p[1]) << 8) | (Uint32(p[2]) << 16); break;
+					case 2: pixel = *reinterpret_cast<const Uint16 *>(p); break;
+					default: pixel = *p; break;
+				}
+				Uint8 r, g, b, a;
+				SDL_GetRGBA(pixel, s->format, &r, &g, &b, &a);
+				if (hasKey && pixel == key) {
+					a = 0;
+				}
+				dst[size_t(y) * page.texw + x] = pspexp_color_4444(r, g, b, a);
+			}
+		}
+		desc.format = PSPEXP_TEX_4444;
+		desc.layout = PSPEXP_LAYOUT_LINEAR;
+	}
+	if (locked) {
+		SDL_UnlockSurface(s);
+	}
+	page.tex = allocHandle();
+	rc = pspexp_upload_texture(ctx, page.tex, &desc, pixels.data(), uint32_t(pixels.size()), &frame, 1);
+	if (rc < 0) {
+		char buf[160];
+		snprintf(buf, sizeof(buf), "texture upload rejected (%d) for %dx%d page", rc, page.texw, page.texh);
+		log(buf);
+		freeHandle(page.tex);
+		page.tex = 0;
+		return false;
+	}
+	++uploadsSinceReport;
+	residentBytes += uint32_t(pixels.size());
+	return true;
+}
+
+uint32_t pixelHash(const SDL_Surface *s)
+{
+	uint32_t h = 2166136261u;
+	const unsigned char *p = static_cast<const unsigned char *>(s->pixels);
+	for (int y = 0; y < s->h; ++y) {
+		const unsigned char *row = p + size_t(y) * s->pitch;
+		const size_t n = size_t(s->w) * s->format->BytesPerPixel;
+		for (size_t i = 0; i < n; ++i) {
+			h = (h ^ row[i]) * 16777619u;
+		}
+	}
+	return h;
+}
+
+Entry *ensureEntry(SDL_Surface *s)
+{
+	auto it = entries.find(s);
+	if (it != entries.end()) {
+		return &it->second;
+	}
+	Entry e;
+	e.indexed = s->format->BytesPerPixel == 1 && s->format->palette != nullptr;
+	uint16_t palette = PSPEXP_PALETTE_DEFAULT;
+	if (e.indexed) {
+		palette = currentPalette(e, s);
+		if (palette == PSPEXP_PALETTE_DEFAULT) {
+			return nullptr;
+		}
+	}
+	for (int y0 = 0; y0 < s->h; y0 += PageMax) {
+		for (int x0 = 0; x0 < s->w; x0 += PageMax) {
+			Page p;
+			p.x0 = x0;
+			p.y0 = y0;
+			p.w = std::min(PageMax, s->w - x0);
+			p.h = std::min(PageMax, s->h - y0);
+			p.texw = pow2ceil(p.w, 16);
+			p.texh = pow2ceil(p.h, 8);
+			if (!uploadPage(s, p, e.indexed, palette)) {
+				for (Page &q : e.pages) {
+					pspexp_release(ctx, q.tex);
+					freeHandle(q.tex);
+				}
+				return nullptr;
+			}
+			e.pages.push_back(p);
+		}
+	}
+	for (const Page &p : e.pages) {
+		e.bytes += uint32_t(p.texw) * p.texh * (e.indexed ? 1 : 2);
+	}
+	e.last_used = SDL_GetTicks();
+	return &entries.emplace(s, std::move(e)).first->second;
+}
+
+void releaseEntry(Entry &e)
+{
+	for (Page &p : e.pages) {
+		pspexp_release(ctx, p.tex);
+		freeHandle(p.tex);
+	}
+	for (PaletteVariant &v : e.palettes) {
+		pspexp_release(ctx, v.id);
+		freeHandle(v.id);
+	}
+	residentBytes -= std::min(residentBytes, e.bytes);
+}
+
+/// Release everything the game has not drawn for EvictAfterMs. Runs at most
+/// once a second; the next draw re-uploads (the engine keeps every surface).
+void evictStale()
+{
+	const Uint32 now = SDL_GetTicks();
+	if (now - lastEvictScan < 1000 || !linkUp()) {
+		return;
+	}
+	lastEvictScan = now;
+	for (auto it = entries.begin(); it != entries.end();) {
+		if (now - it->second.last_used > EvictAfterMs) {
+			releaseEntry(it->second);
+			it = entries.erase(it);
+		} else {
+			++it;
+		}
+	}
+}
+
+/*----------------------------------------------------------------------------
+--  Frame assembly
+----------------------------------------------------------------------------*/
+
+void flushQuads()
+{
+	if (!quads.empty()) {
+		pspexp_draw_quad_batch(ctx, quadTex, quads.data(), uint32_t(quads.size()), quadPal, quadFmt);
+		quads.clear();
+	}
+}
+
+void beginFrameIfNeeded()
+{
+	if (!frameOpen) {
+		pspexp_begin_frame(ctx);
+		frameOpen = true;
+		clipValid = false;
+	}
+}
+
+void applyClip(bool clip)
+{
+	SDL_Rect want;
+	if (overrideClip) {
+		want = overrideRect;
+	} else if (clip) {
+		want = {ClipX1, ClipY1, ClipX2 - ClipX1 + 1, ClipY2 - ClipY1 + 1};
+	} else {
+		want = {0, 0, Video.Width, Video.Height};
+	}
+	if (clipValid && want.x == lastClip.x && want.y == lastClip.y && want.w == lastClip.w && want.h == lastClip.h) {
+		return;
+	}
+	flushQuads();
+	pspexp_set_clip(ctx, int16_t(want.x), int16_t(want.y), int16_t(want.w), int16_t(want.h));
+	lastClip = want;
+	clipValid = true;
+}
+
+void pushQuad(uint16_t tex, uint16_t pal, uint16_t fmt, const PspExpQuadRec &rec)
+{
+	if (!quads.empty() && (tex != quadTex || pal != quadPal || fmt != quadFmt)) {
+		flushQuads();
+	}
+	quadTex = tex;
+	quadPal = pal;
+	quadFmt = fmt;
+	quads.push_back(rec);
+}
+
+bool linkUp()
+{
+	return ctx && pspexp_link_state(ctx) == PSPEXP_LINK_CONNECTED;
+}
+
+void tryReconnect()
+{
+	if (mode != Mode::Usb && mode != Mode::Tcp) {
+		return;
+	}
+	if (transport) {
+		// release the dead device right away; the context keeps the resources
+		pspexp_set_transport(ctx, nullptr);
+		transport = nullptr;
+		log("link lost; waiting for the PSP");
+	}
+	const Uint32 now = SDL_GetTicks();
+	if (now - lastReconnectTry < 1000) {
+		return;
+	}
+	lastReconnectTry = now;
+	char err[200];
+	PspExpTransport *t = nullptr;
+	if (mode == Mode::Tcp) {
+		t = pspexp_tcp_open(&tcpOpt, err, sizeof(err));
+	}
+#ifdef PSPEXP_HAVE_USB
+	else {
+		t = pspexp_usb_open(&usbOpt, err, sizeof(err));
+	}
+#endif
+	if (!t) {
+		return;
+	}
+	pspexp_set_transport(ctx, t);
+	transport = t;
+	if (pspexp_connect(ctx, 3000) == 0) {
+		log("reconnected; resources replayed");
+	}
+}
+
+/*----------------------------------------------------------------------------
+--  Controller -> engine events (same mapping as the native PSP port)
+----------------------------------------------------------------------------*/
+
+uint32_t prevButtons = 0;
+float pointerX = 0, pointerY = 0;
+Uint32 pointerTicks = 0;
+bool slowPointer = false, fastPointer = false;
+constexpr float PointerSpeed = 260.0f;   /// pixels per second at full deflection
+constexpr int DeadZone = 35;             /// of 127
+
+void pushKey(SDL_Keycode sym, bool down)
+{
+	SDL_Event ev;
+	SDL_zero(ev);
+	ev.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+	ev.key.state = down ? SDL_PRESSED : SDL_RELEASED;
+	ev.key.keysym.sym = sym;
+	SDL_PushEvent(&ev);
+}
+
+void pushMouseButton(Uint8 button, bool down)
+{
+	SDL_Event ev;
+	SDL_zero(ev);
+	ev.type = down ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+	ev.button.state = down ? SDL_PRESSED : SDL_RELEASED;
+	ev.button.button = button;
+	ev.button.clicks = 1;
+	ev.button.x = int(pointerX);
+	ev.button.y = int(pointerY * Video.VerticalPixelSize);
+	SDL_PushEvent(&ev);
+}
+
+void pushMouseMotion()
+{
+	SDL_Event ev;
+	SDL_zero(ev);
+	ev.type = SDL_MOUSEMOTION;
+	ev.motion.x = int(pointerX);
+	ev.motion.y = int(pointerY * Video.VerticalPixelSize);
+	SDL_PushEvent(&ev);
+}
+
+void buttonEdge(uint32_t pressed, uint32_t released, uint32_t bit, SDL_Keycode sym)
+{
+	if (pressed & bit) pushKey(sym, true);
+	if (released & bit) pushKey(sym, false);
+}
+
+void translateInput(const PspExpInput &in)
+{
+	// nothing sampled yet (or an executor without a controller): leave the
+	// engine's own mouse and keyboard alone
+	if (in.sequence == 0 && in.timestamp_us == 0) {
+		return;
+	}
+	const uint32_t pressed = in.buttons & ~prevButtons;
+	const uint32_t released = prevButtons & ~in.buttons;
+	prevButtons = in.buttons;
+
+	if (pressed & PSPEXP_BUTTON_CROSS) pushMouseButton(SDL_BUTTON_LEFT, true);
+	if (released & PSPEXP_BUTTON_CROSS) pushMouseButton(SDL_BUTTON_LEFT, false);
+	if (pressed & PSPEXP_BUTTON_CIRCLE) pushMouseButton(SDL_BUTTON_RIGHT, true);
+	if (released & PSPEXP_BUTTON_CIRCLE) pushMouseButton(SDL_BUTTON_RIGHT, false);
+	buttonEdge(pressed, released, PSPEXP_BUTTON_SQUARE, SDLK_LSHIFT);
+	buttonEdge(pressed, released, PSPEXP_BUTTON_TRIANGLE, SDLK_LCTRL);
+	buttonEdge(pressed, released, PSPEXP_BUTTON_UP, SDLK_UP);
+	buttonEdge(pressed, released, PSPEXP_BUTTON_DOWN, SDLK_DOWN);
+	buttonEdge(pressed, released, PSPEXP_BUTTON_LEFT, SDLK_LEFT);
+	buttonEdge(pressed, released, PSPEXP_BUTTON_RIGHT, SDLK_RIGHT);
+	buttonEdge(pressed, released, PSPEXP_BUTTON_START, SDLK_F10);
+	buttonEdge(pressed, released, PSPEXP_BUTTON_SELECT, SDLK_ESCAPE);
+	slowPointer = (in.buttons & PSPEXP_BUTTON_LTRIGGER) != 0;
+	fastPointer = (in.buttons & PSPEXP_BUTTON_RTRIGGER) != 0;
+
+	// analog nub drives the pointer, quadratic response
+	const Uint32 now = SDL_GetTicks();
+	const float dt = std::min<Uint32>(now - pointerTicks, 100) / 1000.0f;
+	pointerTicks = now;
+	const int ax = int(in.analog_x) - 128, ay = int(in.analog_y) - 128;
+	if (std::abs(ax) <= DeadZone && std::abs(ay) <= DeadZone) {
+		return;
+	}
+	float speed = PointerSpeed * dt;
+	if (slowPointer) speed *= 0.35f;
+	else if (fastPointer) speed *= 2.5f;
+	const float fx = std::abs(ax) > DeadZone ? ax / 127.0f : 0.0f;
+	const float fy = std::abs(ay) > DeadZone ? ay / 127.0f : 0.0f;
+	pointerX = std::clamp(pointerX + fx * std::abs(fx) * speed, 0.0f, Video.Width - 1.0f);
+	pointerY = std::clamp(pointerY + fy * std::abs(fy) * speed, 0.0f, Video.Height - 1.0f);
+	pushMouseMotion();
+}
+
+/*----------------------------------------------------------------------------
+--  Audio tap
+----------------------------------------------------------------------------*/
+
+void audioPostMix(void *, Uint8 *stream, int len)
+{
+	// SDL_mixer's thread: copy the final mix into the ring, then silence the
+	// local device (the PSP plays it).
+	const size_t frames = size_t(len) / 4;
+	const int16_t *src = reinterpret_cast<const int16_t *>(stream);
+	SDL_LockMutex(audioMutex);
+	const size_t capacity = audioRing.size() / 2;
+	for (size_t f = 0; f < frames && audioBuffered < capacity; ++f) {
+		audioRing[audioTail * 2] = src[f * 2];
+		audioRing[audioTail * 2 + 1] = src[f * 2 + 1];
+		audioTail = (audioTail + 1) % capacity;
+		++audioBuffered;
+	}
+	SDL_UnlockMutex(audioMutex);
+	memset(stream, 0, size_t(len));
+}
+
+void drainAudio()
+{
+	if (!audioInstalled || !linkUp()) {
+		return;
+	}
+	static std::vector<int16_t> chunk;
+	SDL_LockMutex(audioMutex);
+	const size_t capacity = audioRing.size() / 2;
+	size_t n = audioBuffered;
+	chunk.resize(n * 2);
+	for (size_t f = 0; f < n; ++f) {
+		chunk[f * 2] = audioRing[audioHead * 2];
+		chunk[f * 2 + 1] = audioRing[audioHead * 2 + 1];
+		audioHead = (audioHead + 1) % capacity;
+	}
+	audioBuffered = 0;
+	SDL_UnlockMutex(audioMutex);
+	// at most 4096 frames (16 KB) per message
+	for (size_t off = 0; off < n; off += 4096) {
+		const size_t m = std::min<size_t>(4096, n - off);
+		pspexp_audio_stream(ctx, chunk.data() + off * 2, uint32_t(m));
+		audioFramesSent += unsigned(m);
+	}
+}
+
+/*----------------------------------------------------------------------------
+--  GUI graphics: guisan draws menus with its own clip stack and offsets
+----------------------------------------------------------------------------*/
+
+class GuiGraphics : public gcn::SDLGraphics
+{
+public:
+	using gcn::SDLGraphics::drawImage;
+
+	void drawImage(const gcn::Image *image, int srcX, int srcY, int dstX, int dstY, int width, int height) override
+	{
+		if (Active() && !mClipStack.empty()) {
+			const gcn::ClipRectangle &top = mClipStack.top();
+			const auto *img = dynamic_cast<const gcn::SDLImage *>(image);
+			if (img && img->getSurface()) {
+				ScopedClip clip(top);
+				DrawSurface(img->getSurface(), srcX, srcY, width, height, dstX + top.xOffset, dstY + top.yOffset, true, 255, false);
+			}
+		}
+		gcn::SDLGraphics::drawImage(image, srcX, srcY, dstX, dstY, width, height);
+	}
+
+	void drawSDLSurface(SDL_Surface *surface, SDL_Rect source, SDL_Rect destination) override
+	{
+		if (Active() && !mClipStack.empty()) {
+			const gcn::ClipRectangle &top = mClipStack.top();
+			ScopedClip clip(top);
+			DrawSurface(surface, source.x, source.y, source.w, source.h, destination.x + top.xOffset, destination.y + top.yOffset, true, 255, false);
+		}
+		gcn::SDLGraphics::drawSDLSurface(surface, source, destination);
+	}
+
+	void fillRectangle(const gcn::Rectangle &rectangle) override
+	{
+		if (Active() && !mClipStack.empty()) {
+			const gcn::ClipRectangle &top = mClipStack.top();
+			ScopedClip clip(top);
+			FillRect(color(), rectangle.x + top.xOffset, rectangle.y + top.yOffset, rectangle.width, rectangle.height, true, alpha());
+		}
+		gcn::SDLGraphics::fillRectangle(rectangle);
+	}
+
+	void drawRectangle(const gcn::Rectangle &rectangle) override
+	{
+		if (Active() && !mClipStack.empty()) {
+			const gcn::ClipRectangle &top = mClipStack.top();
+			ScopedClip clip(top);
+			DrawRectOutline(color(), rectangle.x + top.xOffset, rectangle.y + top.yOffset, rectangle.width, rectangle.height, true, alpha());
+		}
+		gcn::SDLGraphics::drawRectangle(rectangle);
+	}
+
+	void drawLine(int x1, int y1, int x2, int y2) override
+	{
+		if (Active() && !mClipStack.empty()) {
+			const gcn::ClipRectangle &top = mClipStack.top();
+			ScopedClip clip(top);
+			DrawLine(color(), x1 + top.xOffset, y1 + top.yOffset, x2 + top.xOffset, y2 + top.yOffset, true, alpha());
+		}
+		gcn::SDLGraphics::drawLine(x1, y1, x2, y2);
+	}
+
+	void drawPoint(int x, int y) override
+	{
+		if (Active() && !mClipStack.empty()) {
+			const gcn::ClipRectangle &top = mClipStack.top();
+			ScopedClip clip(top);
+			FillRect(color(), x + top.xOffset, y + top.yOffset, 1, 1, true, alpha());
+		}
+		gcn::SDLGraphics::drawPoint(x, y);
+	}
+
+private:
+	struct ScopedClip {
+		explicit ScopedClip(const gcn::ClipRectangle &r)
+		{
+			overrideClip = true;
+			overrideRect = {r.x, r.y, r.width, r.height};
+		}
+		~ScopedClip() { overrideClip = false; }
+	};
+	Uint32 color() const { return SDL_MapRGB(TheScreen->format, Uint8(mColor.r), Uint8(mColor.g), Uint8(mColor.b)); }
+	int alpha() const { return mAlpha ? mColor.a : 255; }
+};
+
+} // anonymous namespace
+
+/*----------------------------------------------------------------------------
+--  Public interface
+----------------------------------------------------------------------------*/
+
+gcn::SDLGraphics *CreateGuiGraphics()
+{
+	return new GuiGraphics();
+}
+
+void AudioInstall()
+{
+	if (audioInstalled) {
+		return;
+	}
+	int freq = 0, channels = 0;
+	Uint16 format = 0;
+	if (!Mix_QuerySpec(&freq, &format, &channels)) {
+		return;
+	}
+	if (freq != 44100 || format != AUDIO_S16SYS || channels != 2) {
+		fprintf(stderr, "[pspexp] audio device is %d Hz format %#x x%d, not 44.1 kHz s16 stereo: not mirrored\n", freq, format, channels);
+		return;
+	}
+	audioMutex = SDL_CreateMutex();
+	audioRing.assign(size_t(freq) * 2, 0);   /// one second
+	Mix_SetPostMix(audioPostMix, nullptr);
+	audioInstalled = true;
+	fprintf(stderr, "[pspexp] audio mirrored to the PSP (44.1 kHz stereo stream)\n");
+}
+
+bool Init()
+{
+	const char *env = getenv("PSPEXP");
+	if (!env || !*env) {
+		return false;
+	}
+	std::string want(env);
+	char err[256] = "";
+	if (want == "usb") {
+#ifdef PSPEXP_HAVE_USB
+		pspexp_usb_options_default(&usbOpt);
+		fprintf(stderr, "[pspexp] waiting up to 15 s for a PSP over USB...\n");
+		transport = pspexp_usb_wait(&usbOpt, 15000, err, sizeof(err));
+		if (!transport) {
+			fprintf(stderr, "[pspexp] %s\n", err);
+			return false;
+		}
+		mode = Mode::Usb;
+#else
+		log("built without the USB transport");
+		return false;
+#endif
+	} else if (want == "sdl") {
+#ifdef PSPEXP_HAVE_SDL
+		PspExpSdlOptions o;
+		pspexp_sdl_options_default(&o);
+		o.title = "PSPExp executor (what the PSP would show)";
+		o.pump_events = 0;   /// the engine owns the SDL event loop
+		sdlExec = pspexp_sdl_create(&o, err, sizeof(err));
+		if (!sdlExec) {
+			fprintf(stderr, "[pspexp] %s\n", err);
+			return false;
+		}
+		transport = pspexp_sdl_transport(sdlExec);
+		mode = Mode::Sdl;
+#else
+		log("built without the SDL executor");
+		return false;
+#endif
+	} else if (want == "null") {
+		nullExec = pspexp_null_create(nullptr);
+		transport = pspexp_null_transport(nullExec);
+		mode = Mode::Null;
+	} else if (want.rfind("tcp", 0) == 0) {
+		// "tcp", "tcp:host" or "tcp:host:port"
+		pspexp_tcp_options_default(&tcpOpt);
+		if (want.size() > 4 && want[3] == ':') {
+			tcpHost = want.substr(4);
+			const size_t colon = tcpHost.rfind(':');
+			if (colon != std::string::npos) {
+				tcpOpt.port = uint16_t(atoi(tcpHost.c_str() + colon + 1));
+				tcpHost.erase(colon);
+			}
+			if (!tcpHost.empty()) {
+				tcpOpt.host = tcpHost.c_str();
+			}
+		}
+		fprintf(stderr, "[pspexp] connecting to %s:%u over TCP (up to 30 s)...\n", tcpOpt.host, tcpOpt.port);
+		transport = pspexp_tcp_wait(&tcpOpt, 30000, err, sizeof(err));
+		if (!transport) {
+			fprintf(stderr, "[pspexp] %s\n", err);
+			return false;
+		}
+		mode = Mode::Tcp;
+	} else {
+		fprintf(stderr, "[pspexp] PSPEXP=%s not understood (usb, sdl, null, tcp[:host[:port]])\n", env);
+		return false;
+	}
+
+	ctx = pspexp_create(transport, nullptr);
+	pspexp_set_log(ctx, logFn, nullptr);
+	if (pspexp_connect(ctx, 5000) < 0) {
+		log("no HELLO from the runtime");
+		pspexp_destroy(ctx);
+		ctx = nullptr;
+		mode = Mode::Off;
+		return false;
+	}
+	pointerX = Video.Width / 2.0f;
+	pointerY = Video.Height / 2.0f;
+	lastReport = SDL_GetTicks();
+	fprintf(stderr, "[pspexp] backend active (%s), %dx%d\n", env, Video.Width, Video.Height);
+	AudioInstall();   /// no-op until the mixer is open; InitSound calls it too
+	return true;
+}
+
+bool Active()
+{
+	return mode != Mode::Off && ctx != nullptr;
+}
+
+void Shutdown()
+{
+	if (!ctx) {
+		return;
+	}
+	pspexp_send_raw(ctx, PSPEXP_CH_SYSTEM, PSPEXP_OP_DISCONNECT, nullptr, 0);
+	pspexp_destroy(ctx);
+	ctx = nullptr;
+	if (nullExec) {
+		pspexp_null_destroy(nullExec);
+		nullExec = nullptr;
+	}
+#ifdef PSPEXP_HAVE_SDL
+	if (sdlExec) {
+		pspexp_sdl_destroy(sdlExec);
+		sdlExec = nullptr;
+	}
+#endif
+	entries.clear();
+	mode = Mode::Off;
+}
+
+void Present()
+{
+	if (!Active()) {
+		return;
+	}
+	if (!linkUp()) {
+		frameOpen = false;
+		quads.clear();
+		tryReconnect();
+		return;
+	}
+	beginFrameIfNeeded();
+	flushQuads();
+	drainAudio();
+	// One frame in flight: the previous PRESENT_DONE has normally arrived
+	// while the game logic ran; otherwise wait for it here.
+	pspexp_wait_present(ctx, 40);
+	if (pspexp_present(ctx) < 0) {
+		frameOpen = false;
+		return;
+	}
+	frameOpen = false;
+	pspexp_pump(ctx, 0);
+	++framesSinceReport;
+	evictStale();
+	{
+		// PSPEXP_SHOT_EVERY=N: ask the executor for a screenshot every N frames
+		static int shotEvery = -1;
+		static unsigned frameNo = 0, shotIndex = 0;
+		if (shotEvery < 0) { const char *e = getenv("PSPEXP_SHOT_EVERY"); shotEvery = e ? atoi(e) : 0; }
+		if (shotEvery > 0 && ++frameNo % unsigned(shotEvery) == 0) pspexp_request_screenshot(ctx, uint16_t(shotIndex++));
+	}
+
+	const Uint32 now = SDL_GetTicks();
+	if (now - lastReport >= 2000) {
+		const PspExpStats *st = pspexp_stats(ctx);
+		const PspExpAudioStatus *au = pspexp_audio_status(ctx);
+		fprintf(stderr, "[pspexp] %.1f fps  %u B/frame  %u batches  %u sprites  input->present %u us  psp cpu %u us  ge %u us  uploads %u  resident %zu surfaces %u KiB  errors %u  audio sent %u buffered %u underruns %u\n",
+		        framesSinceReport * 1000.0 / double(now - lastReport), st->last_frame_bytes, st->last_frame_batches,
+		        st->last_frame_sprites, st->last_input_to_present_us, st->last_execute_us, st->last_ge_us,
+		        uploadsSinceReport, entries.size(), residentBytes / 1024, st->resource_errors + st->protocol_errors,
+		        audioFramesSent, au->buffered_frames, au->underruns);
+		audioFramesSent = 0;
+		lastReport = now;
+		framesSinceReport = 0;
+		uploadsSinceReport = 0;
+	}
+}
+
+void PumpInput()
+{
+	if (!Active()) {
+		return;
+	}
+	if (!linkUp()) {
+		tryReconnect();
+		return;
+	}
+	pspexp_pump(ctx, 0);
+	drainAudio();
+	translateInput(*pspexp_input(ctx));
+}
+
+void DrawSurface(SDL_Surface *s, int gx, int gy, int w, int h, int x, int y, bool clip, int alpha, bool flip)
+{
+	if (!Active() || !linkUp() || !s || w <= 0 || h <= 0) {
+		return;
+	}
+	// clamp the source rectangle to the surface
+	if (gx < 0) { w += gx; x -= gx; gx = 0; }
+	if (gy < 0) { h += gy; y -= gy; gy = 0; }
+	if (gx + w > s->w) w = s->w - gx;
+	if (gy + h > s->h) h = s->h - gy;
+	if (w <= 0 || h <= 0) {
+		return;
+	}
+	Entry *e = ensureEntry(s);
+	if (!e) {
+		return;
+	}
+	e->last_used = SDL_GetTicks();
+	beginFrameIfNeeded();
+	applyClip(clip);
+	const uint16_t pal = currentPalette(*e, s);
+	const uint16_t fmt = alpha < 255 ? PSPEXP_VTX_SPRITE_2D_4444 : PSPEXP_VTX_SPRITE_2D_5650;
+	const uint16_t color = alpha < 255 ? uint16_t(0x0FFF | ((alpha >> 4) << 12)) : PSPEXP_COLOR_NONE;
+
+	for (const Page &p : e->pages) {
+		const int ix0 = std::max(gx, p.x0), ix1 = std::min(gx + w, p.x0 + p.w);
+		const int iy0 = std::max(gy, p.y0), iy1 = std::min(gy + h, p.y0 + p.h);
+		if (ix0 >= ix1 || iy0 >= iy1) {
+			continue;
+		}
+		PspExpQuadRec q;
+		q.reserved = 0;
+		q.color = color;
+		q.v0 = uint16_t(iy0 - p.y0);
+		q.v1 = uint16_t(iy1 - p.y0);
+		q.y = int16_t(y + (iy0 - gy));
+		if (flip) {
+			q.u0 = uint16_t(ix1 - p.x0);
+			q.u1 = uint16_t(ix0 - p.x0);
+			q.x = int16_t(x + (gx + w - ix1));
+		} else {
+			q.u0 = uint16_t(ix0 - p.x0);
+			q.u1 = uint16_t(ix1 - p.x0);
+			q.x = int16_t(x + (ix0 - gx));
+		}
+		pushQuad(p.tex, pal, fmt, q);
+	}
+}
+
+void FillRect(Uint32 color, int x, int y, int w, int h, bool clip, int alpha)
+{
+	if (!Active() || !linkUp() || w <= 0 || h <= 0) {
+		return;
+	}
+	beginFrameIfNeeded();
+	applyClip(clip);
+	flushQuads();
+	pspexp_fill_rect(ctx, int16_t(x), int16_t(y), int16_t(w), int16_t(h), screenColor5650(color), uint8_t(alpha));
+}
+
+void DrawLine(Uint32 color, int x0, int y0, int x1, int y1, bool clip, int alpha)
+{
+	if (!Active() || !linkUp()) {
+		return;
+	}
+	beginFrameIfNeeded();
+	applyClip(clip);
+	flushQuads();
+	pspexp_draw_line(ctx, int16_t(x0), int16_t(y0), int16_t(x1), int16_t(y1), screenColor5650(color), uint8_t(alpha));
+}
+
+void DrawRectOutline(Uint32 color, int x, int y, int w, int h, bool clip, int alpha)
+{
+	if (w <= 0 || h <= 0) {
+		return;
+	}
+	FillRect(color, x, y, w, 1, clip, alpha);
+	FillRect(color, x, y + h - 1, w, 1, clip, alpha);
+	if (h > 2) {
+		FillRect(color, x, y + 1, 1, h - 2, clip, alpha);
+		FillRect(color, x + w - 1, y + 1, 1, h - 2, clip, alpha);
+	}
+}
+
+void DrawCircleOutline(Uint32 color, int cx, int cy, int r, bool clip, int alpha)
+{
+	if (r <= 0) {
+		return;
+	}
+	const int segments = std::clamp(r, 8, 32);
+	int px = cx + r, py = cy;
+	for (int i = 1; i <= segments; ++i) {
+		const double a = 2.0 * M_PI * i / segments;
+		const int nx = cx + int(std::lround(r * std::cos(a)));
+		const int ny = cy + int(std::lround(r * std::sin(a)));
+		DrawLine(color, px, py, nx, ny, clip, alpha);
+		px = nx;
+		py = ny;
+	}
+}
+
+void FillCircle(Uint32 color, int cx, int cy, int r, bool clip, int alpha)
+{
+	if (r <= 0) {
+		return;
+	}
+	// rows of a disc as horizontal fills
+	for (int dy = -r; dy <= r; ++dy) {
+		const int half = int(std::lround(std::sqrt(double(r * r - dy * dy))));
+		FillRect(color, cx - half, cy + dy, 2 * half + 1, 1, clip, alpha);
+	}
+}
+
+void DrawChangingSurface(SDL_Surface *s, int x, int y)
+{
+	if (!Active() || !linkUp() || !s) {
+		return;
+	}
+	auto it = entries.find(s);
+	const uint32_t h = pixelHash(s);
+	if (it != entries.end() && it->second.pixel_hash != h) {
+		releaseEntry(it->second);
+		entries.erase(it);
+		it = entries.end();
+	}
+	DrawSurface(s, 0, 0, s->w, s->h, x, y, false, 255, false);
+	it = entries.find(s);
+	if (it != entries.end()) {
+		it->second.pixel_hash = h;
+	}
+}
+
+void MinimapChanged()
+{
+}
+
+void SurfaceFreed(SDL_Surface *s)
+{
+	if (!ctx) {
+		return;
+	}
+	auto it = entries.find(s);
+	if (it == entries.end()) {
+		return;
+	}
+	if (linkUp()) {
+		releaseEntry(it->second);
+	}
+	entries.erase(it);
+}
