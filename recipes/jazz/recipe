# Jazz Jackrabbit: Debian's OpenJazz, and the shareware episode from PSPExp's
# repository (Debian's route to the data is game-data-packager).

[package]
id=jazz
title=Jazz Jackrabbit (shareware)
description=Jazz Jackrabbit, Epic MegaGames' 1994 platformer, its shareware episode on OpenJazz: fast run-and-gun through colourful planets.
category=game
license=GPL-2.0 (OpenJazz); shareware (Jazz Jackrabbit, Epic MegaGames, 1994)
version=3

[debian]
apt=openjazz jazz-shareware-data


# the Omega2+: PSPExp's own static build (scripts/packages/recipes/jazz.sh, BOARD=omega), from the
# builds the Mac publishes to it (pspexp-pkg-build publish)
[omega]
build=jazz

[entry]
title=Jazz Jackrabbit
type=game
description=Epic MegaGames' 1994 platformer: Jazz, a green hare with a blaster, races through the shareware episode's planets at speed.
icon=rabbit
exec=/usr/games/OpenJazz /usr/share/games/jazz-shareware
keys=cross=space+return+y,square=lalt,circle=escape+n,triangle=rctrl,l=rctrl,r=rctrl,start=escape,select=p,up=up,down=down,left=left,right=right
nub=keys
graphics=sdl
