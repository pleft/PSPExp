# Beneath a Steel Sky: Debian's freeware game data on Debian's ScummVM, a point-and-click
# adventure played with the nub as the mouse.

# ScummVM's SDL surface mode comes from a settings file of PSPExp's own (first-run), not from
# --gfx-mode: that option opens a graphics change before there is any screen, and ScummVM 2.9's
# dirty-rectangle count, never set at first, then made about one start in two end at once
# ("SDL_BlitSurface failed", 2026-11-01)

[package]
id=beneath-a-steel-sky
title=Beneath a Steel Sky
description=Revolution's 1994 cyberpunk adventure: Robert Foster is snatched from the Gap and escapes into Union City with his robot friend Joey. Point and click with the nub; freeware since 2003.
category=game
license=Freeware (Revolution Software); ScummVM is GPL-3.0
version=5

[debian]
apt=scummvm beneath-a-steel-sky

[omega]
build=beneath-a-steel-sky

[entry]
title=Beneath a Steel Sky
type=game
description=Revolution's 1994 cyberpunk adventure: Robert Foster is snatched from the Gap and escapes into Union City with his robot friend Joey. Point and click with the nub; freeware since 2003.
icon=puzzle
exec=/usr/games/scummvm --config=$HOME/.config/pspexp/scummvm.ini --scaler=normal --scale-factor=1 --no-fullscreen -p /usr/share/scummvm/beneath-a-steel-sky sky
first-run=.config/pspexp/scummvm.ini:[scummvm]\ngfx_mode=surfacesdl\n
keys=start=f5,select=escape,triangle=period,square=space,up=up,down=down,left=left,right=right
nub=mouse
graphics=sdl
control=nub: Move the pointer
control=cross: Walk; look at a thing
control=circle: Use a thing: take, open, talk
control=triangle: Skip a line of speech
control=square: Pause
control=select: Skip a cutscene
control=start: Save, load, options
