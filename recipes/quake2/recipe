# Quake II: id Software's demo (1997) on Debian's Yamagi Quake II with its
# OpenGL 1 renderer, the world drawn by the PSP's GE through the SDL layer,
# as Quake's. The demo is downloaded at install from the Yamagi project's
# mirror of id's release (package quake2-demo). Controls as the PSP's own
# shooters have them (the gamepad off: Yamagi would read it as well):
# triangle / cross forward and back, square / circle strafe, the nub aims
# (the mouse), R fires (and selects in menus), L and the d-pad's right the
# next weapon, the d-pad up jumps, down crouches, left answers Y, SELECT the
# inventory, START the menu. Quake II binds no next weapon or crouch key by
# default: the first run adds them.

[package]
id=quake2
title=Quake II (demo)
description=id Software's 1997 first-person shooter against the Strogg, its demo levels on Yamagi Quake II: the 3D world drawn by the PSP.
category=game
license=GPL-2.0 (Yamagi Quake II); demo (Quake II, id Software, 1997), downloaded at install
version=2

[debian]
apt=quake2-demo

[entry]
title=Quake II
type=game
description=id Software's 1997 first-person shooter against the Strogg: the demo's levels on Yamagi Quake II, its 3D drawn by the PSP's graphics chip.
icon=swords
exec=/usr/games/quake2-demo
keys=triangle=up,cross=down,square=comma,circle=period,r=lctrl+return,l=slash,up=space,down=c,right=slash,left=y,start=escape,select=tab
nub=mouse
env=PSPEXP_MOUSE_BUTTONS=left=none,right=none
env=PSPEXP_JOYSTICK=0
first-run=.yq2/baseq2/autoexec.cfg:bind / weapnext\nbind c +movedown\n
graphics=opengl
