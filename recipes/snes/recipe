# The SNES: Debian's Snes9x core, played by pspexp-retro.

[package]
id=snes
title=SNES
description=Super Nintendo: Debian's Snes9x core; ROMs in ~/roms/snes
category=system
license=Snes9x licence (non-commercial); pspexp-retro is part of PSPExp
version=2

[package:gameshell]
description=Super Nintendo: PSPExp's Snes9x 2005 core (lighter; Debian armhf has no Snes9x); ROMs in ~/roms/snes

[package:omega]
description=Super Nintendo: PSPExp's static player with the Snes9x 2005 core; ROMs in ~/roms/snes

[debian]
apt=pspexp-retro libretro-snes9x
core=snes9x_libretro.so

# the GameShell: Debian armhf has no such core; PSPExp's lighter Snes9x 2005 plays at full speed there
[debian:gameshell]
apt=pspexp-retro pspexp-libretro-snes9x2005
core=snes9x2005_libretro.so


# the Omega2+: PSPExp's own static build (scripts/packages/recipes/snes.sh, BOARD=omega), from the
# builds the Mac publishes to it (pspexp-pkg-build publish)
[omega]
build=snes
warn=Too heavy for the Omega2+: runs far below full speed

[system]
id=snes
name=Super Nintendo
short=SNES
icon=gamepad-2
ext=sfc,smc
roms=~/roms/snes
thumbs=Nintendo - Super Nintendo Entertainment System
keys=cross=z,circle=x,square=a,triangle=s,l=q,r=w,start=return,select=rshift,up=up,down=down,left=left,right=right
nub=keys
graphics=sdl
