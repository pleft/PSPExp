# Neverball: Debian's package, an OpenGL game drawn by the PSP's GE. Tilt the
# floor with the nub; it reads the PSP as its game controller.

[package]
id=neverball
title=Neverball
description=Tilt the floor to roll a ball through obstacle courses to the goal, collecting coins against the clock, over many level sets.
category=game
license=GPL-2.0+ (Neverball)
version=2

[debian]
apt=neverball

[entry]
title=Neverball
type=game
description=Tilt the floor to roll a ball through obstacle courses to the goal, collecting coins against the clock, over many level sets.
icon=trophy
exec=/usr/games/neverball
graphics=opengl
