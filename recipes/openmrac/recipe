# openMrac: Debian's package, a GL 2 racing game whose shaders the SDL layer
# reads and the PSP's GE draws (lighting, reflections). Its settings window
# is skipped. Cross accelerates, square brakes.

[package]
id=openmrac
title=openMrac
description=3D arcade racing: pick a car and race laps on country tracks, chasing your best time.
category=game
license=BSD-2-Clause (openMrac)
version=3

[debian]
apt=openmrac

[entry]
title=openMrac
type=game
description=3D arcade racing: pick a car and race laps on country tracks, chasing your best time.
icon=gauge
exec=/usr/games/openmrac --skip-settings
keys=cross=up,square=down,start=return,select=escape,up=up,down=down,left=left,right=right
nub=keys
env=PSPEXP_JOYSTICK=0
graphics=opengl-shaders
control=dpad nub: Steer; up speeds up, down brakes
control=cross: Accelerate
control=square: Brake
control=start: Choose in menus
control=select: Pause menu: restart, quit
