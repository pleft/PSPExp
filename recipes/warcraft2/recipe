# Warcraft II: Tides of Darkness (Blizzard, 1995) on Wargus and Stratagus
# (GPL-2.0; packages pspexp-wargus and pspexp-stratagus, built by PSPExp),
# through the SDL layer like any other SDL2 game. Warcraft II is sold, not
# free: the player brings their own copy into ~/Warcraft2 (Apps > Files): the
# DOS CD's files, the Battle.net Edition's folder, or GOG's installer .exe
# (unpacked with innoextract); the first start extracts it, and without it
# the launcher says what goes there. Nothing of the game is hosted, not even
# a cover. Wargus's own size, 640x480, shrunk to the PSP's screen (a smaller
# one to be tried once a copy is at hand: its interface is laid out for
# 640x480 and up). The music: what the copy has (the DOS CD's is CD audio,
# which wartool can only rip from a real drive). The PSP's controls, as
# Warcraft's: the nub is the mouse (cross selects and orders, circle the
# right button), the d-pad scrolls the map, square Shift, triangle Ctrl,
# START the game menu (F10), SELECT Escape. Arm64 boards (Pi). Built and the
# missing-copy path tried on 2026-10-08; not yet played (no copy at hand).

[package]
id=warcraft2
title=Warcraft II
description=Blizzard's 1995 real-time strategy game on Stratagus and Wargus: humans against orcs on land, at sea and in the air. Needs your own copy (DOS CD, Battle.net Edition or GOG). Drawn by the PSP.
category=game
license=GPL-2.0 (Stratagus, Wargus); the game's data is your own copy's (Blizzard)
version=1

[debian]
apt=pspexp-wargus

[debian:gameshell]
apt=

[entry]
title=Warcraft II
type=game
description=Blizzard's 1995 strategy game on Stratagus: humans against orcs on land, sea and air. Put your own copy's files in the Warcraft2 folder of your home folder first.
icon=swords
exec=/usr/games/warcraft2
native=1
keys=square=lshift,triangle=lctrl,up=up,down=down,left=left,right=right,start=f10,select=escape,l=none,r=none
nub=mouse
env=PSPEXP_NUB_SPEED=400
graphics=sdl
