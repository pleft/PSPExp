# Warcraft II: Tides of Darkness (Blizzard, 1995) on Wargus and Stratagus
# (GPL-2.0; packages pspexp-wargus and pspexp-stratagus, built by PSPExp),
# through the SDL layer like any other SDL2 game. Warcraft II is sold, not
# free: the player brings their own copy into ~/Warcraft2 (Apps > Files): the
# DOS CD's files or a disc image of it (.cue with .img/.bin: its audio tracks
# become the music), the Battle.net Edition's folder, or GOG's installer .exe
# (unpacked with innoextract); the first start extracts it (4 min on a Pi 400
# from a disc image), and without it the launcher says what goes there. Nothing of the game is hosted, not even
# a cover: the launcher shows the title screen of the player's own copy once
# it is extracted (art=), a generated cover before. Played at the PSP's
# 480x272, the menus and the game laid out for it (the package's patch to
# Wargus's scripts). The music: the CD's recordings from a disc image,
# else the game's MIDI. The PSP's controls, as
# Warcraft's: the nub is the mouse (cross selects and orders, circle the
# right button), the d-pad scrolls the map, square Shift, triangle Ctrl,
# START the game menu (F10), SELECT Escape. Arm64 boards (Pi). Tried on
# 2026-10-08 from the launcher with the stand-in PSP: the user's copy (both
# CDs' images) extracted, menus and a game's setup reached.

[package]
id=warcraft2
title=Warcraft II
description=Blizzard's 1995 real-time strategy game on Stratagus and Wargus: humans against orcs on land, at sea and in the air. Needs your own copy (DOS CD or its image, Battle.net Edition or GOG). Drawn by the PSP.
category=game
license=GPL-2.0 (Stratagus, Wargus); the game's data is your own copy's (Blizzard)
version=2

[debian]
apt=pspexp-wargus

[debian:gameshell]
apt=

[entry]
title=Warcraft II
type=game
description=Blizzard's 1995 strategy game on Stratagus: humans against orcs on land, sea and air. Put your own copy's files in the Warcraft2 folder of your home folder first.
icon=swords
exec=/usr/games/warcraft2
art=~/.local/share/pspexp-warcraft2/graphics/ui/title.png
native=1
keys=square=lshift,triangle=lctrl,up=up,down=down,left=left,right=right,start=f10,select=escape,l=none,r=none
nub=mouse
env=PSPEXP_NUB_SPEED=400
graphics=sdl
