# Teeworlds: a fast 2D multiplayer shooter, Debian's package, at the PSP's
# size; its map tiles are 3D textures, which the SDL layer keeps as an atlas.
# Online servers or a LAN (it has no bots). The nub aims (the mouse), R fires,
# L throws the hook, the d-pad runs, cross jumps, square / triangle change
# weapon.

[package]
id=teeworlds
title=Teeworlds
description=Fast 2D multiplayer shooter with grappling hooks: deathmatch and capture the flag, online or on a LAN.
category=game
license=Zlib (Teeworlds)
version=3

[debian]
apt=teeworlds

[entry]
title=Teeworlds
type=game
description=Fast 2D multiplayer shooter with grappling hooks: deathmatch and capture the flag, online or on a LAN.
icon=swords
exec=/usr/games/teeworlds 'gfx_screen_width 480; gfx_screen_height 272; gfx_fullscreen 0; bind q +nextweapon; bind e +prevweapon'
keys=left=a,right=d,up=space,cross=space,square=q,triangle=e,start=escape,select=tab
nub=mouse
env=PSPEXP_JOYSTICK=0
env=PSPEXP_MOUSE_BUTTONS=left=r,right=l
graphics=opengl
control=nub: Aim; the pointer in menus
control=left right: Run left, right
control=cross up: Jump
control=r: Fire; click in menus
control=l: Throw the grappling hook
control=square triangle: Next, previous weapon
control=select: Scores, while held
control=start: The game's menu
