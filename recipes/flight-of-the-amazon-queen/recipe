# Flight of the Amazon Queen: Debian's freeware game data on Debian's ScummVM, a point-and-click
# adventure played with the nub as the mouse.

# ScummVM's SDL surface mode comes from a settings file of PSPExp's own (first-run), not from
# --gfx-mode: that option opens a graphics change before there is any screen, and ScummVM 2.9's
# dirty-rectangle count, never set at first, then made about one start in two end at once
# ("SDL_BlitSurface failed", 2026-11-01)

[package]
id=flight-of-the-amazon-queen
title=Flight of the Amazon Queen
description=A 1995 jungle adventure: pilot Joe King crash-lands in the Amazon and stumbles on a mad scientist's plot. Point and click with the nub, with full speech; freeware since 2004.
category=game
license=Freeware (John Passfield, Steven Stamatiadis); ScummVM is GPL-3.0
version=5

[debian]
apt=scummvm flight-of-the-amazon-queen

[omega]
build=flight-of-the-amazon-queen

[entry]
title=Flight of the Amazon Queen
type=game
description=A 1995 jungle adventure: pilot Joe King crash-lands in the Amazon and stumbles on a mad scientist's plot. Point and click with the nub, with full speech; freeware since 2004.
icon=puzzle
exec=/usr/games/scummvm --config=$HOME/.config/pspexp/scummvm.ini --scaler=normal --scale-factor=1 --no-fullscreen -p /usr/share/scummvm/flight-of-the-amazon-queen queen
first-run=.config/pspexp/scummvm.ini:[scummvm]\ngfx_mode=surfacesdl\n
keys=start=f5,select=escape,triangle=period,square=space,up=up,down=down,left=left,right=right
nub=mouse
graphics=sdl
control=nub: Move the pointer
control=cross: Click: walk, do the chosen action
control=circle: A thing's usual action
control=triangle: Skip a line of speech
control=select: Skip a scene
control=start: Menu: save, load, quit
