# Mr. Boom: a Bomberman clone for up to eight players (on the PSP: one, against
# the computer), Debian's package. Played as its first keyboard player (its
# manual's keys): the d-pad or nub moves, cross lays a bomb, circle ignites,
# square jumps, triangle adds a bot, START starts, L / R pause. No game
# controller: Mr. Boom makes every pad one more player, and the PSP's buttons
# then reached no player in the game (2026-10-02). -x 1: without its xBRZ
# smoothing (on by default on 64-bit ARM: a 640x400 picture of thousands of
# colours a frame, 150-170 KB over the link; its own 320x200 in 256 colours is
# 40 KB, and the PSP scales it to the screen).

[package]
id=mrboom
title=Mr. Boom
description=Bomberman-style action: lay bombs, blast walls and trap your rivals in maze arenas, against the computer.
category=game
license=MIT (Mr. Boom)
version=5

[debian]
apt=mrboom

[entry]
title=Mr. Boom
type=game
description=Bomberman-style action: lay bombs, blast walls and trap your rivals in maze arenas, against the computer.
icon=gamepad-2
exec=/usr/games/mrboom -x 1
keys=up=up,down=down,left=left,right=right,cross=rctrl,circle=ralt,square=rshift,triangle=space,start=return,select=escape,l=p,r=p
nub=keys
env=PSPEXP_JOYSTICK=0
graphics=sdl
control=nub dpad: Move
control=cross: Lay a bomb
control=circle: Set off your bombs (remote)
control=square: Jump
control=triangle: Add a computer player
control=start: Start the game
control=l r: Pause
