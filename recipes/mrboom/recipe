# Mr. Boom: a Bomberman clone for up to eight players (on the PSP: one, against
# the computer), Debian's package. Played as its first keyboard player (its
# manual's keys): the d-pad or nub moves, cross lays a bomb, circle ignites,
# square jumps, triangle adds a bot, START starts, L / R pause. No game
# controller: Mr. Boom makes every pad one more player, and the PSP's buttons
# then reached no player in the game (2026-10-02).

[package]
id=mrboom
title=Mr. Boom
description=Bomberman-style action: lay bombs, blast walls and trap your rivals in maze arenas, against the computer.
category=game
license=MIT (Mr. Boom)
version=3

[debian]
apt=mrboom

[entry]
title=Mr. Boom
type=game
description=Bomberman-style action: lay bombs, blast walls and trap your rivals in maze arenas, against the computer.
icon=gamepad-2
exec=/usr/games/mrboom
keys=up=up,down=down,left=left,right=right,cross=rctrl,circle=ralt,square=rshift,triangle=space,start=return,select=escape,l=p,r=p
nub=keys
env=PSPEXP_JOYSTICK=0
graphics=sdl
