# The Game Boy and Game Boy Color: Debian's Gambatte core, played by pspexp-retro.

[package]
id=gameboy
title=Game Boy
description=Game Boy and Game Boy Color: Debian's Gambatte core; ROMs in ~/roms/gb and ~/roms/gbc
category=system
license=GPL-2.0 (Gambatte); pspexp-retro is part of PSPExp
version=3

[package:omega]
description=Game Boy and Game Boy Color: PSPExp's static player with the Gambatte core; ROMs in ~/roms/gb and ~/roms/gbc

[debian]
apt=pspexp-retro libretro-gambatte
core=gambatte_libretro.so


# the Omega2+: PSPExp's own static build (scripts/packages/recipes/gameboy.sh, BOARD=omega), from the
# builds the Mac publishes to it (pspexp-pkg-build publish)
[omega]
build=gameboy

[system]
id=gb
name=Game Boy
short=GB
icon=gamepad-2
ext=gb
roms=~/roms/gb
thumbs=Nintendo - Game Boy
keys=cross=z,circle=x,square=a,triangle=s,l=q,r=w,start=return,select=rshift,up=up,down=down,left=left,right=right
nub=keys
graphics=sdl
control=dpad: D-pad (the nub too)
control=cross circle: B, A
control=start select: Start, Select

[system.gbc]
id=gbc
name=Game Boy Color
short=GBC
icon=gamepad-2
ext=gbc
roms=~/roms/gbc
thumbs=Nintendo - Game Boy Color
keys=cross=z,circle=x,square=a,triangle=s,l=q,r=w,start=return,select=rshift,up=up,down=down,left=left,right=right
nub=keys
graphics=sdl
control=dpad: D-pad (the nub too)
control=cross circle: B, A
control=start select: Start, Select
