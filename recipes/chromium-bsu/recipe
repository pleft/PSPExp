# Chromium B.S.U.: Debian's package, an OpenGL 1.x game drawn by the PSP's GE.
# The ship follows the mouse: the nub moves it, cross fires (the mouse button).

[package]
id=chromium-bsu
title=Chromium B.S.U.
description=Fast arcade space shooter: fly the cargo ship Chromium B.S.U. through waves of enemies, picking up power-ups, shields and repairs.
category=game
license=Clarified Artistic (Chromium B.S.U.)
version=3

[debian]
apt=chromium-bsu

[entry]
title=Chromium B.S.U.
type=game
description=Fast arcade space shooter: fly the cargo ship Chromium B.S.U. through waves of enemies, picking up power-ups, shields and repairs.
icon=rocket
exec=/usr/games/chromium-bsu -w -v 0
keys=start=return,select=escape,square=space,triangle=space,up=up,down=down,left=left,right=right
nub=mouse
env=PSPEXP_JOYSTICK=0
graphics=opengl
control=nub: Fly the ship
control=dpad: Fly; move in the menus
control=cross square triangle: Fire (hold)
control=circle: Twice quickly: blow up your ship
control=start: Choose in menus; twice, blow up
control=select: Pause; the menu
