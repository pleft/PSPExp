# Freedoom: Debian's Phase 1 and 2 data, played by Debian's Chocolate Doom
# (listed first: freedoom asks for "dsda-doom or any Doom engine").

[package]
id=freedoom
title=Freedoom
description=Free Doom-compatible games on Chocolate Doom: Phase 1, four episodes, and Phase 2, a 32-level megawad, with their own levels, monsters and art.
category=game
license=BSD-3-Clause (Freedoom); GPL-2.0 (Chocolate Doom)
version=2

[debian]
apt=chocolate-doom freedoom


# the Omega2+: PSPExp's own static build (scripts/packages/recipes/freedoom.sh, BOARD=omega), from the
# builds the Mac publishes to it (pspexp-pkg-build publish)
[omega]
build=freedoom

[entry]
id=freedoom1
title=Freedoom: Phase 1
type=game
description=Four episodes of fast Doom-compatible action: free levels, monsters and art, played on Chocolate Doom.
icon=swords
exec=/usr/games/chocolate-doom -iwad /usr/share/games/doom/freedoom1.wad
keys=cross=lctrl,circle=space,square=lshift,triangle=return+y,l=comma,r=period,start=escape,select=tab,up=up,down=down,left=left,right=right
nub=keys
cover=phase1.png
graphics=sdl

[entry.phase2]
id=freedoom2
title=Freedoom: Phase 2
type=game
description=A 32-level megawad, Doom II-compatible: free levels, monsters and art, played on Chocolate Doom.
icon=swords
exec=/usr/games/chocolate-doom -iwad /usr/share/games/doom/freedoom2.wad
keys=cross=lctrl,circle=space,square=lshift,triangle=return+y,l=comma,r=period,start=escape,select=tab,up=up,down=down,left=left,right=right
nub=keys
cover=phase2.png
graphics=sdl
