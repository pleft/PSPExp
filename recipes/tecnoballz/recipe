# TecnoballZ: breakout with a shop, gadgets, bosses and up to four paddles
# (Debian's; an SDL 1.2 game, run on SDL2 by sdl12-compat: pspexp-run's SDL
# 1.2 bridge). In its 320x200 mode (--320), drawn at 1.13x on the PSP: its
# 640x480 is the same pictures doubled, shown at 57%, its menus' text about 4
# pixels. The nub is the mouse: it moves the paddle and the menu's cursor;
# cross clicks (fires), circle is the right button (the Gigablitz),
# triangle releases the ball (Space), square the tilt (Alt), START pauses
# (P), SELECT its menu (Escape). Played on the PSP-1000 (2026-10-17): the menu,
# a game started, the paddle both ways, bricks broken, about 51 fps.
# On the GameShell (2026-10-17, the PSP-1000 on its USB): about 50 fps in play.

[package]
id=tecnoballz
title=TecnoballZ
description=Breakout with a shop between levels, gadgets, bosses and up to four paddles at once.
category=game
license=GPL-3.0+ (TecnoballZ)
version=1

[debian]
apt=tecnoballz


[entry]
title=TecnoballZ
type=game
description=Breakout with a shop between levels, gadgets, bosses and up to four paddles at once.
icon=gamepad-2
exec=/usr/games/tecnoballz --320
keys=triangle=space,square=lalt,start=p,select=escape
nub=mouse
env=PSPEXP_MOUSE_BUTTONS=left=cross,right=circle
env=PSPEXP_JOYSTICK=0
graphics=sdl
