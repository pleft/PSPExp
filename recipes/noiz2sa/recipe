# Noiz2sa: Kenta Cho's abstract shooter, waves of bullets on a pale field
# (Debian's; an SDL 1.2 game drawn in 2D, through the layer's build for SDL
# 1.2 programs). Its 640x480 window (-window) at the PSP's size. The d-pad or
# the nub move, cross fires (Z), circle slows the ship (X), START or SELECT
# pause (P; Escape, on START before, quit the game). Played on the PSP-1000 (2026-10-17): into a game, moving
# both ways and firing, 60 fps.
# On the GameShell (2026-10-17): 27 fps (60 on a Pi), which the user found very fluid.

[package]
id=noiz2sa
title=Noiz2sa
description=Abstract shooter: dodge the patterns of bullets on a pale field and shoot down the waves.
category=game
license=BSD-2-Clause (Noiz2sa, Kenta Cho)
version=2

[debian]
apt=noiz2sa


[entry]
title=Noiz2sa
type=game
description=Abstract shooter: dodge the patterns of bullets on a pale field and shoot down the waves.
icon=rocket
exec=/usr/games/noiz2sa -window
keys=cross=z,circle=x,start=p,select=p,up=up,down=down,left=left,right=right
nub=keys
env=PSPEXP_JOYSTICK=0
graphics=sdl
control=dpad nub: Move
control=cross: Fire
control=circle: Hold to move slowly
control=start select: Pause
