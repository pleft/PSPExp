# Heroes of Might and Magic III (New World Computing, 1999) on VCMI, Debian's
# open-source re-creation of its engine (package pspexp-heroes3: its start
# script). Heroes III is sold, not free: the player brings their own copy into
# ~/Heroes3 (Apps > Files): GOG's installer (the .exe and its .bin) or the
# game's folder; the first start copies it into VCMI's data folder (2-3
# minutes from GOG's installer on a Pi 400), and without it the launcher says
# what goes there. Nothing of the game is hosted; the cover is VCMI's icon.
# VCMI lays itself out at 1066x604 for the PSP's 480x272 (its smallest, 800x600
# at least, widened to the screen's shape), shown at 45%, each pixel the
# average of those under it (PSPEXP_TEX_FIT); its text small, R magnifies round
# the pointer to the game's own pixels. The nub is the mouse, cross clicks,
# circle is the right button (what a thing is), the d-pad scrolls the map.
# Played on the PSP-1000 (2026-10-17) with GOG's Complete edition: its menu,
# a scenario chosen and begun, its opening message, the hero moved into a
# fight, the battle; 55-60 fps.

[package]
id=heroes3
title=Heroes III
description=Turn-based fantasy strategy, the 1999 classic on VCMI: explore, build towns, recruit armies and fight with heroes. Put your own copy (GOG's installer) in the Heroes3 folder first.
category=game
license=GPL-2.0+ (VCMI); the game's data is your own copy's (Ubisoft)
version=1

[debian]
apt=pspexp-heroes3

# (a Pi only for now: not yet tried on the GameShell)
[debian:gameshell]
apt=

[entry]
title=Heroes III
type=game
description=Turn-based fantasy strategy on VCMI: towns, armies and heroes. Put your own copy (GOG's installer .exe and .bin) in the Heroes3 folder of your home folder first.
icon=swords
exec=/usr/games/heroes3
native=1
keys=up=up,down=down,left=left,right=right,start=escape,select=return
nub=mouse
env=PSPEXP_MOUSE_BUTTONS=left=cross,right=circle
env=PSPEXP_MAGNIFY=r
env=PSPEXP_TEX_FIT=1
env=PSPEXP_JOYSTICK=0
first-run=.config/vcmi/settings.json:{ "video" : { "resolution" : { "width" : 480, "height" : 272, "scaling" : 0 }, "fullscreen" : false, "showIntro" : false } }\n
graphics=sdl
