# The Mega Drive / Genesis, and the Master System and Game Gear, which the same cores play:
# Debian's Genesis Plus GX, played by pspexp-retro; the Sega CD and the 32X by PicoDrive,
# PSPExp's build (pspexp-libretro-picodrive), on every board: Genesis Plus GX has no 32X, and
# Debian's builds it without CHD (a .chd refused as "File is too large", 2026-11-01). On the
# Pi 400 both at 59.9 frames a second (Sonic CD to its title, Knuckles' Chaotix's intro).
# The Sega CD needs the player's own BIOS in ~/roms/segacd/bios (bios_CD_U.bin, bios_CD_E.bin,
# bios_CD_J.bin: the region of the disc's); its discs as .chd, or .cue with their tracks. The 32X
# needs no BIOS (PicoDrive's own).

[package]
id=megadrive
title=Mega Drive
description=Sega Mega Drive / Genesis, Sega CD and 32X: Debian's Genesis Plus GX core, PicoDrive for the Sega CD and 32X; ROMs in ~/roms/md, ~/roms/segacd (its BIOS in ~/roms/segacd/bios), ~/roms/32x
category=system
license=Genesis Plus GX and PicoDrive licences (non-commercial); pspexp-retro is part of PSPExp
version=5

[package:gameshell]
description=Sega Mega Drive / Genesis, Sega CD and 32X: PSPExp's PicoDrive core (lighter; Debian armhf has no Mega Drive core); ROMs in ~/roms/md, ~/roms/segacd (its BIOS in ~/roms/segacd/bios), ~/roms/32x

[package:omega]
description=Sega Mega Drive / Genesis: PSPExp's static player with the PicoDrive core; ROMs in ~/roms/md

[debian]
apt=pspexp-retro libretro-genesisplusgx pspexp-libretro-picodrive
core=genesis_plus_gx_libretro.so

# the GameShell: Debian armhf has no such core; PSPExp's lighter PicoDrive plays at full speed there
[debian:gameshell]
apt=pspexp-retro pspexp-libretro-picodrive
core=picodrive_libretro.so


# the Omega2+: PSPExp's own static build (scripts/packages/recipes/megadrive.sh, BOARD=omega), from the
# builds the Mac publishes to it (pspexp-pkg-build publish)
[omega]
build=megadrive
warn=Too heavy for the Omega2+: runs far below full speed

[system]
id=md
name=Mega Drive
short=MD
icon=gamepad-2
ext=md,gen,smd,bin
roms=~/roms/md
thumbs=Sega - Mega Drive - Genesis
keys=cross=z,circle=x,square=a,triangle=s,l=q,r=w,start=return,select=rshift,up=up,down=down,left=left,right=right
nub=keys
graphics=sdl
control=dpad: D-pad (the nub too)
control=square cross circle: A, B, C
control=l triangle r: X, Y, Z (six-button games)
control=start: Start
control=select: Mode

