# The Mega Drive / Genesis, and the Master System and Game Gear, which the same
# cores play: Debian's Genesis Plus GX, played by pspexp-retro.

[package]
id=megadrive
title=Mega Drive
description=Sega Mega Drive / Genesis: Debian's Genesis Plus GX core; ROMs in ~/roms/md
category=system
license=Genesis Plus GX licence (non-commercial); pspexp-retro is part of PSPExp
version=4

[package:gameshell]
description=Sega Mega Drive / Genesis: PSPExp's PicoDrive core (lighter; Debian armhf has no Mega Drive core); ROMs in ~/roms/md

[package:omega]
description=Sega Mega Drive / Genesis: PSPExp's static player with the PicoDrive core; ROMs in ~/roms/md

[debian]
apt=pspexp-retro libretro-genesisplusgx
core=genesis_plus_gx_libretro.so

# the GameShell: Debian armhf has no such core; PSPExp's lighter PicoDrive plays at full speed there
[debian:gameshell]
apt=pspexp-retro pspexp-libretro-picodrive
core=picodrive_libretro.so


# the Omega2+: PSPExp's own static build (scripts/packages/recipes/megadrive.sh, BOARD=omega), from the
# builds the Mac publishes to it (pspexp-pkg-build publish)
[omega]
build=megadrive
warn=Too heavy for the Omega2+: runs far below full speed

[system]
id=md
name=Mega Drive
short=MD
icon=gamepad-2
ext=md,gen,smd,bin
roms=~/roms/md
thumbs=Sega - Mega Drive - Genesis
keys=cross=z,circle=x,square=a,triangle=s,l=q,r=w,start=return,select=rshift,up=up,down=down,left=left,right=right
nub=keys
graphics=sdl
control=dpad: D-pad (the nub too)
control=square cross circle: A, B, C
control=l triangle r: X, Y, Z (six-button games)
control=start: Start
control=select: Mode

[system.sms]
id=sms
name=Master System
short=SMS
icon=gamepad-2
ext=sms
roms=~/roms/sms
thumbs=Sega - Master System - Mark III
keys=cross=z,circle=x,square=a,triangle=s,l=q,r=w,start=return,select=rshift,up=up,down=down,left=left,right=right
nub=keys
graphics=sdl
control=dpad: D-pad (the nub too)
control=cross circle: Button 1, button 2
control=start: Pause

[system.gg]
id=gg
name=Game Gear
short=GG
icon=gamepad-2
ext=gg
roms=~/roms/gg
thumbs=Sega - Game Gear
keys=cross=z,circle=x,square=a,triangle=s,l=q,r=w,start=return,select=rshift,up=up,down=down,left=left,right=right
nub=keys
graphics=sdl
control=dpad: D-pad (the nub too)
control=cross circle: Button 1, button 2
control=start: Start
