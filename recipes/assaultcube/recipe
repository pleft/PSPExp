# AssaultCube: the free online first-person shooter (1.3.0.2), its client
# built by PSPExp (package pspexp-assaultcube; Debian's arm64 build fails
# against its own local server) and its data downloaded at install from the
# project's release (assaultcube-release). Its fixed-function OpenGL is drawn by
# the PSP's GE through the SDL layer. Controls as the PSP's own shooters have
# them, on its default bindings: triangle / cross forward and back, square /
# circle strafe (the arrows), the nub aims (and points in menus), R fires (and
# clicks), L the scope (the right button); the d-pad up jumps, down crouches,
# right reloads, left the previous weapon; START the menu, SELECT the scores.
# Mouse sensitivity 15 (3 by default, for a desktop mouse; the nub moves far
# less: it seemed not to aim at all), as OpenArena's; -e runs after its saved
# settings.

[package]
id=assaultcube
title=AssaultCube
description=The free online first-person shooter: fast team matches on its own maps, against bots or real players on the Internet. Drawn by the PSP.
category=game
license=zlib (AssaultCube); its content under the licences in its README, downloaded at install
version=3

[debian]
apt=assaultcube-release

[entry]
title=AssaultCube
type=game
description=The free online first-person shooter: team matches against bots or real players online. Its 3D drawn by the PSP's graphics chip.
icon=swords
exec=/usr/games/assaultcube-release '-esensitivity 15'
keys=triangle=up,cross=down,square=left,circle=right,up=space,down=lshift,right=r,left=q,l=none,r=none,start=escape,select=tab
nub=mouse
env=PSPEXP_MOUSE_BUTTONS=left=r,right=l
env=PSPEXP_JOYSTICK=0
graphics=opengl
