# SRB2Kart: Kart Krew's free kart racer with Sonic and friends (1.6), its
# program built by PSPExp (package pspexp-srb2kart) and its assets downloaded at
# install from the project's release (srb2kart). Its software renderer at
# 640x400 (heights not a multiple of 200 crash it), drawn by the PSP as CLUT8
# pages, kept whole (PSPEXP_TEX_HALF=0). The PSP's controller is its gamepad,
# its defaults: nub steers, cross accelerates, circle brakes, L the item, R
# drifts, square looks back, triangle the camera, START the menu, SELECT
# pauses; the d-pad's left and right steer too (the arrow keys). Online races
# through the board's network.

[package]
id=srb2kart
title=SRB2Kart
description=Kart racing with Sonic and friends: items, drifting and 30+ tracks, against the computer or online. A free fan game, drawn by the PSP.
category=game
license=GPL-2.0 (SRB2Kart); freeware assets under their own licences, downloaded at install
version=1

[debian]
apt=srb2kart

[entry]
title=SRB2Kart
type=game
description=Kart racing with Sonic and friends: items, drifts and dozens of tracks, against the computer or online. Drawn by the PSP's graphics chip.
icon=gamepad-2
exec=/usr/games/srb2kart
keys=cross=none,circle=none,square=none,triangle=none,l=none,r=none,start=none,select=none,up=none,down=none,left=left,right=right
env=PSPEXP_TEX_HALF=0
graphics=sdl
