# Trackballs: Debian's 1.3.4, which asks for OpenGL 3.3: beyond the PSP's layer
# and beyond the Pi 400's V3D (3.1), but what it draws with V3D has; Mesa is
# told to offer 3.3 (MESA_GL_VERSION_OVERRIDE) and the board's own GPU draws it
# (PSPEXP_HOSTGL: SDL's offscreen driver, EGL), each finished frame sent to the
# PSP as a picture. In a 640x480 window (its smallest), shrunk to the PSP's
# screen. Its menus take the mouse: the nub moves the pointer, cross clicks. In
# play the d-pad steers the marble, square jumps, START is its menu (Escape).
# The GameShell's GPU has OpenGL ES 2 only: not offered there.

[package]
id=trackballs
title=Trackballs
description=Steer a marble through 3D labyrinths against the clock: ramps, traps, enemies and jumps, in the spirit of Marble Madness.
category=game
license=GPL-2.0+ (Trackballs and its data)
version=1

[debian]
apt=trackballs

[debian:gameshell]
apt=

[entry]
title=Trackballs
type=game
description=Steer a marble through 3D labyrinths against the clock, as in Marble Madness. Drawn by the board's GPU (Pi); menus by the nub as a pointer.
icon=gem
exec=/usr/games/trackballs -w -r 640
keys=square=space,start=esc,up=up,down=down,left=left,right=right
nub=mouse
env=PSPEXP_HOSTGL=1
env=MESA_GL_VERSION_OVERRIDE=3.3
env=MESA_GLSL_VERSION_OVERRIDE=330
env=PSPEXP_MOUSE_BUTTONS=left=cross,right=none
env=PSPEXP_JOYSTICK=0
graphics=board-gpu
