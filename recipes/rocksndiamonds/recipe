# Rocks'n'Diamonds: a Boulder Dash-style puzzle game with hundreds of levels,
# Debian's package; plays with the PSP as its gamepad. Its screen (672x560) is
# scaled to the PSP's: small, but whole.

[package]
id=rocksndiamonds
title=Rocks'n'Diamonds
description=A Boulder Dash-style puzzle game: dig for diamonds, dodge falling rocks and reach the exit, across many level sets.
category=game
license=GPL-2.0 (Rocks'n'Diamonds)
version=3

[debian]
apt=rocksndiamonds

[entry]
title=Rocks'n'Diamonds
type=game
description=A Boulder Dash-style puzzle game: dig for diamonds, dodge falling rocks and reach the exit, across many level sets.
icon=gamepad-2
exec=/usr/games/rocksndiamonds
keys=start=return,select=escape
graphics=sdl
control=dpad nub: Move, dig
control=cross: With a direction: dig or grab, stay put
control=start: OK in menus
control=select: Back; leave the level (asks)
