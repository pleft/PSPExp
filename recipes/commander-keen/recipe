# Commander Keen 1 and 4 (id Software / Apogee, 1990 and 1991), their freely
# distributed shareware episodes, on Commander Genius (GPL-2.0+), the
# open-source engine for Keen 1-6, which Debian does not package: our build
# (pspexp-commandergenius) and two installers that fetch the episodes from
# where Commander Genius' own store gets them (commander-keen1, commander-keen4).
# No native PSP port of Keen exists. Each entry starts its episode directly
# (pspexp-keen: no game picker) at the PSP's own 480x272, every pixel the
# game's: its text reads (Keen 4's menu lists dim green, its highlighted line
# clear). The d-pad moves (and moves in its menus), cross jumps (held longer,
# higher: the originals' own), circle pogos, square fires, triangle the status
# screen, L / R quick save and load, START its menu.
# Tried on the PSP-1000 from the Pi 400 (2026-10-18): both intros, menus, Keen 1's
# Mars map and first level, Keen 4's Shadowlands; 60 fps; the user played Keen
# 1 (its jump). On the GameShell with the PSP-1000 (2026-10-18): both
# episodes, Keen 1's map and Keen 4's Shadowlands, 55-60 fps.
# The user played both on the GameShell (2026-10-18): fine.

[package]
id=commander-keen
title=Commander Keen
description=id Software's platform classics: Keen 1, Marooned on Mars, and Keen 4, Secret of the Oracle, their free episodes on Commander Genius.
category=game
license=GPL-2.0+ (Commander Genius); the episodes: id Software / Apogee shareware, freely distributed
version=3

[debian]
apt=commander-keen1 commander-keen4


[entry]
id=keen1
title=Commander Keen 1
type=game
description=Marooned on Mars: find your ship's parts across the Martian cities. Cross jumps (hold for higher), circle pogos, square fires, triangle shows the status.
icon=rocket
exec=/usr/games/pspexp-keen keen1
keys=cross=lctrl,circle=lalt,square=space,triangle=return,l=f6,r=f9,start=escape,select=escape,up=up,down=down,left=left,right=right
nub=keys
env=PSPEXP_JOYSTICK=0
graphics=sdl
control=dpad nub: Move; choose in menus
control=cross: Jump; hold it for a higher jump
control=circle: Pogo stick
control=square: Shoot
control=triangle: Status screen
control=l r: Quick save, quick load
control=start select: The menu

[entry.keen4]
id=keen4
title=Commander Keen 4
cover=keen4.png
type=game
description=Secret of the Oracle: rescue the Council of Elders in the Shadowlands. Cross jumps (hold for higher), circle pogos, square fires, triangle shows the status.
icon=rocket
exec=/usr/games/pspexp-keen keen4
keys=cross=lctrl,circle=lalt,square=space,triangle=return,l=f6,r=f9,start=escape,select=escape,up=up,down=down,left=left,right=right
nub=keys
env=PSPEXP_JOYSTICK=0
graphics=sdl
control=dpad nub: Move; choose in menus
control=cross: Jump; hold it for a higher jump
control=circle: Pogo stick
control=square: Shoot
control=triangle: Status screen
control=l r: Quick save, quick load
control=start select: The menu
