# X-Moto: a physics motocross game, Debian's package, drawn by the PSP's GE
# through the SDL layer's OpenGL. The d-pad drives (up throttle, down brake,
# left / right lean), circle turns the bike round, cross selects in menus.
# Its first start asks for a player profile, whose New Profile button wants the
# mouse: the nub is its pointer, square its click, and triangle opens the PSP's
# keyboard for the name (X-Moto turns text input on at every event, so the
# keyboard does not open by itself: PSPEXP_TEXT=0, PSPEXP_TEXT_BUTTON).
# Until 2026-10-21 a first start stayed on that screen.

[package]
id=xmoto
title=X-Moto
description=Physics motocross: ride, lean and flip your bike through hundreds of levels, collecting strawberries on the way to the flower.
category=game
license=GPL-2.0+ (X-Moto)
version=4

[debian]
apt=xmoto

[entry]
title=X-Moto
type=game
description=Physics motocross: ride, lean and flip your bike through hundreds of levels, collecting strawberries on the way to the flower.
icon=gamepad-2
exec=/usr/games/xmoto
keys=up=up,down=down,left=left,right=right,cross=return,circle=space,start=escape,select=escape
nub=mouse
env=PSPEXP_JOYSTICK=0
env=PSPEXP_MOUSE_BUTTONS=left=square
env=PSPEXP_TEXT=0
env=PSPEXP_TEXT_BUTTON=triangle
graphics=opengl
control=up down: Accelerate, brake
control=left right: Lean left, right
control=nub: The pointer, in the menus
control=square: Click with the pointer
control=triangle: Type: the PSP's keyboard
control=circle: Turn the bike round
control=cross: Choose in menus
control=start select: The menu
