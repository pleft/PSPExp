# Red Alert: EA's freeware release (package redalert-freeware: downloaded at install from
# EA's release as archived, nothing hosted) on Vanilla Conquer (package
# pspexp-vanillaconquer: the original game from the source EA published, 8-bit
# frames drawn by the PSP as CLUT8 pages; its 640x400 kept whole,
# PSPEXP_TEX_HALF=0). Mouse as in the original: the nub is the pointer, cross
# the left button (select, order), circle the right (deselect), the d-pad
# scrolls the map (arrows), START its options menu.

[package]
id=redalert
title=Red Alert
description=Westwood's 1996 real-time strategy game: the Allies against the Soviets, both campaigns. EA's freeware, drawn by the PSP.
category=game
license=Freeware (Red Alert, EA, under EA's licence agreement), downloaded at install; GPL-3.0 (Vanilla Conquer)
version=5

[debian]
apt=redalert-freeware

[entry]
title=Red Alert
type=game
description=Westwood's 1996 real-time strategy game: the Allies against the Soviets, both campaigns. EA's freeware. Drawn by the PSP's graphics chip.
icon=swords
exec=/usr/games/redalert-freeware
keys=start=escape,up=up,down=down,left=left,right=right,square=none,triangle=none,l=none,r=none,select=none
nub=mouse
env=PSPEXP_MOUSE_BUTTONS=left=cross,right=circle
env=PSPEXP_TEX_HALF=0
env=PSPEXP_JOYSTICK=0
# R the magnifier: its menus and messages at the game's own size, round the pointer (the start
# script gives it a 640x400 window, which the layer shrinks; full screen it shrank itself)
env=PSPEXP_MAGNIFY=r
graphics=sdl
control=nub: Move the pointer
control=cross: Select, give orders, click
control=circle: Deselect
control=dpad: Scroll the map
control=start: Options menu
control=r: Magnifier for small text; again, off
