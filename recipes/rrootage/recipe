# rRootage: one of Kenta Cho's shooters (Debian's; SDL 1.2 and OpenGL 1, run
# through the layer's build for SDL 1.2 programs: the PSP draws its OpenGL).
# Its 640x480 window (-window) drawn at the PSP's size by the PSP itself, the
# lines and shapes sharp. The d-pad or the nub move, cross fires (Z), circle
# and square the second button (X), START or SELECT pause (P; Escape, on START before, quit the game). Played on
# the PSP-1000 (2026-10-17): from its title into a game, its beam firing and the score climbing,
# moving left, right and up, 60 fps.
# On the GameShell (2026-10-17): 35-47 fps, slower than on a Pi, which the user keeps.

[package]
id=rrootage
title=rRootage
description=Bullet-hell shooter: destroy each boss through its storm of bullets, with four ways to play.
category=game
license=BSD-3-Clause (rRootage, Kenta Cho)
version=2

[debian]
apt=rrootage


[entry]
title=rRootage
type=game
description=Bullet-hell shooter: destroy each boss through its storm of bullets, with four ways to play.
icon=rocket
exec=/usr/games/rrootage -window
keys=cross=z,circle=x,square=x,start=p,select=p,up=up,down=down,left=left,right=right
nub=keys
env=PSPEXP_JOYSTICK=0
graphics=opengl
control=nub dpad: Move the ship
control=cross: Fire the laser; start a game
control=square circle: Special; on the title, change mode
control=start select: Pause
