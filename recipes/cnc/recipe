# Command & Conquer: EA's freeware release (package cnc-freeware: downloaded at install from
# EA's release as archived, nothing hosted) on Vanilla Conquer (package
# pspexp-vanillaconquer: the original game from the source EA published, 8-bit
# frames drawn by the PSP as CLUT8 pages; its 640x400 kept whole,
# PSPEXP_TEX_HALF=0). Mouse as in the original: the nub is the pointer, cross
# the left button (select, order), circle the right (deselect), the d-pad
# scrolls the map (arrows), START its options menu.

[package]
id=cnc
title=Command & Conquer
description=Westwood's 1995 real-time strategy game: GDI against the Brotherhood of Nod, the Gold edition. EA's freeware, drawn by the PSP.
category=game
license=Freeware (Command & Conquer, EA, under EA's licence agreement), downloaded at install; GPL-3.0 (Vanilla Conquer)
version=2

[debian]
apt=cnc-freeware

[entry]
title=Command & Conquer
type=game
description=Westwood's 1995 real-time strategy game: GDI against the Brotherhood of Nod, the Gold edition. EA's freeware. Drawn by the PSP's graphics chip.
icon=swords
exec=/usr/games/cnc-freeware
keys=start=escape,up=up,down=down,left=left,right=right,square=none,triangle=none,l=none,r=none,select=none
nub=mouse
env=PSPEXP_MOUSE_BUTTONS=left=cross,right=circle
env=PSPEXP_TEX_HALF=0
env=PSPEXP_JOYSTICK=0
graphics=sdl
