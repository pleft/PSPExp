# OpenTTD: Debian's game with its free base sets (OpenGFX graphics, OpenSFX sounds,
# OpenMSX music), at the PSP's own 480x272. Mouse-driven, as Simutrans: the nub
# is the mouse (cross and circle its buttons), the d-pad scrolls the map, L / R
# zoom out / in (minus, equals), triangle closes the top window (Delete), START
# is Escape, square closes news and errors (Space). Its first run's survey question answered (no) by first-run,
# and its hardware acceleration off (video_hw_accel): with none on the board its first start showed
# a red "no compatible GPU found" box over the menu (the 2026-10-21 audit).

[package]
id=openttd
title=OpenTTD
description=Build a transport empire in Transport Tycoon Deluxe's world: trains, road vehicles, ships and aircraft, with free graphics, sounds and music.
category=game
license=GPL-2.0 (OpenTTD, OpenGFX, OpenMSX); CC Sampling Plus 1.0 (OpenSFX)
version=5

[debian]
apt=openttd openttd-opengfx openttd-opensfx openttd-openmsx

[entry]
title=OpenTTD
type=game
description=Build a transport empire in Transport Tycoon Deluxe's world: trains, road vehicles, ships and aircraft, with free graphics, sounds and music.
icon=train-front
exec=/usr/games/openttd -r 480x272
keys=up=up,down=down,left=left,right=right,l=minus,r=equals,triangle=del,start=escape,select=none,square=space
nub=mouse
env=PSPEXP_NUB_SPEED=180
first-run=.config/openttd/openttd.cfg:[misc]\nvideo_hw_accel = false\n[network]\nparticipate_survey = no\n
graphics=sdl
control=nub: Move the pointer
control=dpad: Scroll the map
control=l r: Zoom out, in
control=cross: Click: build, choose
control=circle: Right mouse button (button tips)
control=triangle: Close the top window
control=square: Close news and errors
control=start: Cancel the current tool
