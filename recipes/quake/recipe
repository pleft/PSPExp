# Quake: id Software's shareware episode (1996) on Debian's Quakespasm, its
# world drawn by the PSP's GE through the SDL layer's shaders (three texture
# units asked for: Quakespasm's fast path). Controls as the PSP's own
# shooters have them, on Quake's own bindings: triangle / cross forward and
# back, square / circle strafe, the nub aims (the mouse: Quakespasm looks
# with it), R fires (and selects in menus), L and the d-pad's right the next
# weapon, the d-pad up jumps, left answers Y (its questions), START the menu.

[package]
id=quake
title=Quake (shareware)
description=id Software's 1996 first-person shooter, its shareware episode on Quakespasm: the full 3D world drawn by the PSP.
category=game
license=GPL-2.0 (Quakespasm); shareware (Quake, id Software, 1996)
version=5

[debian]
apt=quake-shareware-data

[entry]
title=Quake
type=game
description=id Software's 1996 first-person shooter: the shareware episode, Dimension of the Doomed, on Quakespasm, its 3D drawn by the PSP's graphics chip.
icon=swords
exec=sh -c 'f=${XDG_DATA_HOME:-$HOME/.local/share}/quake-shareware/id1/autoexec.cfg; mkdir -p "${f%/*}"; grep -qs "^sensitivity" "$f" || echo "sensitivity 25 // PSPExp: aiming with the nub (3 is for a desktop mouse)" >> "$f"; exec /usr/games/quake-shareware "$@"' quake -width 480 -height 272 -window
keys=triangle=up,cross=down,square=comma,circle=period,r=lctrl+return,l=slash,up=space,right=slash,left=y,down=none,start=escape,select=tab
nub=mouse
env=PSPEXP_MOUSE_BUTTONS=left=none,right=none
env=PSPEXP_JOYSTICK=0
env=PSPEXP_GL_UNITS=3
graphics=opengl-shaders
