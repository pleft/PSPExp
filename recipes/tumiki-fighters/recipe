# Tumiki Fighters: one of Kenta Cho's shooters (Debian's; SDL 1.2 and OpenGL 1, run
# through the layer's build for SDL 1.2 programs: the PSP draws its OpenGL).
# Its 640x480 window (-window) drawn at the PSP's size by the PSP itself, the
# lines and shapes sharp. The d-pad or the nub move, cross fires (Z), circle
# and square the second button (X), START or SELECT pause (P; Escape, on START before, quit the game). Played on
# the PSP-1000 (2026-10-17): from its title into a game, the ship moving and firing at an enemy,
# moving left, right and up, 60 fps.
# On the GameShell (2026-10-17): 15-45 fps, which the user found very fluid.

[package]
id=tumiki-fighters
title=Tumiki Fighters
description=Side-scrolling shooter: catch the parts of the enemies you shoot down and stick them to your ship.
category=game
license=BSD-2-Clause (Tumiki Fighters, Kenta Cho)
version=2

[debian]
apt=tumiki-fighters


[entry]
title=Tumiki Fighters
type=game
description=Side-scrolling shooter: catch the parts of the enemies you shoot down and stick them to your ship.
icon=rocket
exec=/usr/games/tumiki-fighters -window
keys=cross=z,circle=x,square=x,start=p,select=p,up=up,down=down,left=left,right=right
nub=keys
env=PSPEXP_JOYSTICK=0
graphics=opengl
control=nub dpad: Move the ship
control=cross: Fire; start a game
control=square circle: Hold: slow, pull your pieces in
control=start select: Pause
