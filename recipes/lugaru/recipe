# Lugaru HD: Wolfire's 3D ninja-rabbit fighter, open source (OSS Lugaru 1.2,
# GPL-2.0+, its data CC BY-SA), from Debian, with pspexp-lugaru's launch
# script (a player and 480x272 settings on the first run: Lugaru wants a name
# typed). Its old fixed OpenGL is drawn by the PSP's GE through the SDL layer.
# Mouse and keyboard, as Lugaru wants: the nub looks (and points in menus),
# cross attacks (the left mouse button; it clicks in menus), the d-pad moves
# (WASD), circle jumps, square crouches and rolls (Shift), triangle draws a
# weapon (E), L throws (Q), START the menu.

[package]
id=lugaru
title=Lugaru HD
description=Wolfire's 3D action game: a rabbit warrior fights wolves and rats with kicks, reversals and knives across an island. Drawn by the PSP.
category=game
license=GPL-2.0+ (Lugaru); CC BY-SA 3.0 / 4.0 (its data)
version=1

[debian]
apt=pspexp-lugaru

[entry]
title=Lugaru HD
type=game
description=Wolfire's 3D action game: a rabbit warrior fights wolves and rats with kicks, reversals and knives. Its 3D drawn by the PSP's graphics chip.
icon=swords
exec=/usr/games/pspexp-lugaru
keys=circle=space,square=lshift,triangle=e,l=q,start=escape,up=w,down=s,left=a,right=d,select=none,r=none
nub=mouse
env=PSPEXP_MOUSE_BUTTONS=left=cross,right=none
env=PSPEXP_JOYSTICK=0
graphics=opengl
