# OpenArena: a free arena shooter on the Quake 3 engine (ioquake3), Debian's
# package with its data. Its classic OpenGL 1.x renderer (the newer one is all
# shaders), at the PSP's size, with the engine's own settings for weak
# hardware: vertex lighting instead of lightmaps (one pass), coarser curves and
# models, no marks, gibs, shadows, flares or dynamic lights, a plain sky. The
# nub aims (the mouse), cross fires; the d-pad moves and strafes.

[package]
id=openarena
title=OpenArena
description=Fast arena shooter on the Quake 3 engine, with bots
category=game
license=GPL-2.0 (ioquake3, OpenArena)
version=1

[debian]
apt=openarena

[entry]
title=OpenArena
type=game
description=Fast arena shooter on the Quake 3 engine, with bots
icon=swords
exec=/usr/games/openarena +set cl_renderer opengl1 +set r_mode -1 +set r_customwidth 480 +set r_customheight 272 +set r_fullscreen 0 +set r_vertexLight 1 +set r_lodbias 2 +set r_subdivisions 25 +set r_lodCurveError 1000 +set cg_simpleItems 1 +set r_dynamiclight 0 +set cg_marks 0 +set cg_gibs 0 +set r_fastsky 1 +set cg_shadows 0 +set r_flares 0 +set cg_brassTime 0 +set r_drawSun 0
keys=up=w,down=s,left=a,right=d,square=space,triangle=slash,l=c,r=lctrl,start=escape,select=tab
nub=mouse
env=PSPEXP_JOYSTICK=0
