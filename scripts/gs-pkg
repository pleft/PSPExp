#!/bin/sh
# PSPExp packages for the ClockworkPi GameShell, from the Mac.
#   scripts/gs-pkg recipes               what can be built (scripts/gameshell/pkg/*.sh)
#   scripts/gs-pkg build ID...           -> build/gameshell/pkg/ID.tar.gz
#   scripts/gs-pkg install ID...         build when missing, copy, pspexp-pkg install
#   scripts/gs-pkg remove ID...
#   scripts/gs-pkg list                  what the GameShell has installed
# GAMESHELL=user@host (default cpi@gameshell). A recipe is a shell script run
# as `recipe DIR` that fills DIR (the package's <id>/ directory) and writes
# DIR/package; it may use $ROOT (this repo), $CACHE (downloads, kept between
# builds), $GAMESHELL (for programs compiled on the GameShell) and fetch().
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
GS="${GAMESHELL:-cpi@gameshell}"
RECIPES="$ROOT/scripts/gameshell/pkg"
OUT="$ROOT/build/gameshell/pkg"
CACHE="$ROOT/build/gameshell/pkg-cache"
export ROOT CACHE GAMESHELL="$GS"
mkdir -p "$OUT" "$CACHE"

build() {
	id="$1"
	[ -f "$RECIPES/$id.sh" ] || { echo "gs-pkg: no recipe $RECIPES/$id.sh" >&2; exit 1; }
	w=$(mktemp -d)
	mkdir -p "$w/$id"
	if ! sh "$RECIPES/$id.sh" "$w/$id"; then rm -rf "$w"; echo "gs-pkg: $id failed" >&2; exit 1; fi
	[ -f "$w/$id/package" ] || { rm -rf "$w"; echo "gs-pkg: $id wrote no package file" >&2; exit 1; }
	ls "$w/$id"/*.entry >/dev/null 2>&1 || ls "$w/$id"/systems/*.system >/dev/null 2>&1 || { rm -rf "$w"; echo "gs-pkg: $id has no entry or system" >&2; exit 1; }
	COPYFILE_DISABLE=1 tar --no-xattrs -C "$w" -czf "$OUT/$id.tar.gz" "$id" 2>/dev/null || COPYFILE_DISABLE=1 tar -C "$w" -czf "$OUT/$id.tar.gz" "$id"
	rm -rf "$w"
	echo "built $OUT/$id.tar.gz ($(du -h "$OUT/$id.tar.gz" | cut -f1))"
}

cmd="$1"; [ $# -gt 0 ] && shift
case "$cmd" in
recipes) for r in "$RECIPES"/[!_]*.sh; do printf '%-14s %s\n' "$(basename "$r" .sh)" "$(sed -n 's/^# title: //p' "$r")"; done ;;
build) for id in "$@"; do build "$id"; done ;;
install)
	for id in "$@"; do
		[ -f "$OUT/$id.tar.gz" ] && [ "$OUT/$id.tar.gz" -nt "$RECIPES/$id.sh" ] || build "$id"
		scp -q "$OUT/$id.tar.gz" "$GS:/tmp/$id.tar.gz"
		ssh "$GS" "pspexp-pkg install /tmp/$id.tar.gz && rm -f /tmp/$id.tar.gz"
	done ;;
remove) ssh "$GS" "pspexp-pkg remove $*" ;;
list) ssh "$GS" pspexp-pkg list ;;
*) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
