#!/bin/sh /etc/rc.common
# /etc/init.d/pspexp-term: the PSP as the Omega's console (display,
# on-screen keyboard, sound). Waits for the SD card, then runs pspexp-term,
# which waits for a PSP on USB and reconnects whenever one appears.
#   /etc/init.d/pspexp-term enable|disable|start|stop
START=99
USE_PROCD=1
DIR=/mnt/mmcblk0p1/pspexp

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c "while [ ! -x $DIR/pspexp-term ]; do sleep 2; done; cd /root; exec $DIR/pspexp-term --shell /bin/ash"
	procd_set_param env HOME=/root SHELL=/bin/ash PATH=/usr/sbin:/usr/bin:/sbin:/bin:$DIR
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
