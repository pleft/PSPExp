LICENCE_NAME = re.compile(r"^(licen[cs]es?|copying|copyright|notice|gpl|lgpl)([-._].*)?$", re.I)


def sh(*a, cwd=None):
    return subprocess.run(a, cwd=cwd, check=True, capture_output=True, text=True).stdout.strip()


def fetch(name, url, ref, local, dest, submodules=False):
    """the component's tree at its commit, submodules included, in dest; returns the commit"""
    if os.path.exists(dest):
        shutil.rmtree(dest)
    if local:
        src = os.path.join(ROOT, local)
        sh("git", "clone", "-q", src, dest)
        commit = sh("git", "-C", src, "rev-parse", "HEAD")
        sh("git", "-C", dest, "checkout", "-q", commit)
        # the submodules at the commits the checkout records, from their own upstreams
        sh("git", "-C", dest, "submodule", "update", "-q", "--init", "--recursive")
        return commit
    if re.fullmatch(r"[0-9a-f]{7,39}", ref):   # a short commit: GitHub fetches only whole ones
        sh("git", "clone", "-q", "--filter=blob:none", url, dest)
        sh("git", "-C", dest, "checkout", "-q", ref)
    else:
        os.makedirs(dest)
        sh("git", "init", "-q", dest)
        sh("git", "-C", dest, "fetch", "-q", "--depth", "1", url, ref)
        sh("git", "-C", dest, "-c", "advice.detachedHead=false", "checkout", "-q", "FETCH_HEAD")
    if submodules:   # only where the build fetches them too (Hurrican); the others build without
        sh("git", "-C", dest, "submodule", "update", "-q", "--init", "--recursive", "--depth", "1")
    return sh("git", "-C", dest, "rev-parse", "HEAD")


def licence_files(tree):
    out = []
    for f in sorted(os.listdir(tree)):
        p = os.path.join(tree, f)
        if os.path.isfile(p) and LICENCE_NAME.match(f):
            out.append(p)
    for sub in ("docs", "doc", "LICENSES", "licenses"):
        d = os.path.join(tree, sub)
        if os.path.isdir(d):
            out += [os.path.join(d, f) for f in sorted(os.listdir(d)) if LICENCE_NAME.match(f) and os.path.isfile(os.path.join(d, f))]
    return out


def label(texts):
    t = " ".join(texts)[:200000]
    found = []
    for pat, name in ((r"GNU GENERAL PUBLIC LICENSE\s+Version 3", "GPL-3.0"), (r"GNU GENERAL PUBLIC LICENSE\s+Version 2", "GPL-2.0"),
                      (r"GNU LESSER GENERAL PUBLIC LICENSE\s+Version 2\.1", "LGPL-2.1"), (r"GNU LESSER GENERAL PUBLIC LICENSE\s+Version 3", "LGPL-3.0"),
                      (r"Permission is hereby granted, free of charge|under the MIT license", "MIT"), (r"This software is provided 'as-is'|ZLIB license|z-lib like", "zlib"),
                      (r"Redistribution and use in source and binary forms", "BSD"), (r"Apache License\s+Version 2\.0", "Apache-2.0")):
        if re.search(pat, t, re.I) and name not in found:
            found.append(name)
    return ", ".join(found) or "see the licence texts below"


def archive(pkg, version):
    """build/sources/out/PKG/PKG_VERSION.source.tar.xz (made once) and what it holds"""
    spec = PACKAGES[pkg]
    name = "%s_%s" % (pkg, version)
    out = os.path.join(OUT, pkg, name + ".source.tar.xz")
    meta = os.path.join(WORK, "meta", name + ".txt")
    if os.path.exists(out) and os.path.exists(meta):
        return out, open(meta).read()
    stage = os.path.join(WORK, "stage", name)
    if os.path.exists(stage):
        shutil.rmtree(stage)
    os.makedirs(stage)
    lines, licences = [], []
    for cname, url, ref, local in spec["comps"]:
        d = re.sub(r"[^A-Za-z0-9.+-]+", "-", cname).strip("-").lower()
        commit = fetch(cname, url, ref, local, os.path.join(stage, d), spec.get("submodules", False))
        files = licence_files(os.path.join(stage, d)) + [os.path.join(stage, d, f) for f in spec.get("licences", {}).get(cname, [])]
        texts = [open(f, errors="replace").read() for f in files]
        lines.append("%s|%s|%s|%s|%s|%s" % (cname, url, ref or "", commit, label(texts), d))
        for f in files:
            licences.append("%s|%s" % (cname, os.path.relpath(f, stage)))
        shutil.rmtree(os.path.join(stage, d, ".git"), ignore_errors=True)
        for g in glob.glob(os.path.join(stage, d, "**", ".git"), recursive=True):
            (shutil.rmtree if os.path.isdir(g) else os.remove)(g)
    os.makedirs(os.path.join(stage, "pspexp"))
    for f in spec["ours"] + ["scripts/packages/debs/%s/build" % pkg if os.path.exists(os.path.join(ROOT, "scripts/packages/debs/%s/build" % pkg)) else None]:
        if f:
            dst = os.path.join(stage, "pspexp", f)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(os.path.join(ROOT, f), dst)
    pspexp_commit = sh("git", "-C", ROOT, "rev-parse", "HEAD")
    readme = ["%s %s: its complete source" % (pkg, version), "",
              "The components, each at the commit the package was built from (with their submodules where the build fetches them):"]
    for l in lines:
        c, url, ref, commit, lic, d = l.split("|")
        readme.append("  %s/  %s, %s%s (%s)" % (d, url, commit, " (%s)" % ref if ref and ref != commit else "", lic))
    readme += ["", "pspexp/: the scripts that build and package it, and our patches to it (PSPExp, MIT;",
               "from PSPExp's repository at commit %s). %s" % (pspexp_commit, spec.get("note", "")), ""]
    open(os.path.join(stage, "README.txt"), "w").write("\n".join(readme))
    os.makedirs(os.path.dirname(out), exist_ok=True)
    os.makedirs(os.path.dirname(meta), exist_ok=True)
    tmp = out + ".part"
    with tarfile.open(tmp, "w:xz", preset=6) as t:
        t.add(stage, arcname=name + ".source")
    os.replace(tmp, out)
    m = "\n".join(lines) + "\n--\n" + "\n".join(licences) + "\n"
    open(meta, "w").write(m)
    return out, m


def copyright(pkg, version, docdir):
    spec = PACKAGES[pkg]
    out, m = archive(pkg, version)
    comps, lics = m.split("\n--\n")
    stage = os.path.join(WORK, "stage", "%s_%s" % (pkg, version))
    url = "%s/%s/%s" % (PUBLIC, pkg, os.path.basename(out))
    t = ["%s %s: %s, built by PSPExp." % (pkg, version, spec["what"]), "", "Built from:"]
    for l in comps.strip().splitlines():
        c, u, ref, commit, lic, d = l.split("|")
        t.append("  %s: %s, commit %s%s; %s" % (c, u, commit, " (%s)" % ref if ref and ref != commit else "", lic))
    if spec.get("own"):
        t += ["  PSPExp: https://github.com/pleft/PSPExp, commit %s; MIT" % sh("git", "-C", ROOT, "rev-parse", "HEAD")]
    t += ["", "The complete source (each component at that commit, our patches, and the scripts that",
          "build and package it):", "  " + url,
          "", "PSPExp's packaging and build scripts: MIT.", "" + spec.get("note", ""), ""]
    for l in lics.strip().splitlines():
        c, rel = l.split("|", 1)
        p = os.path.join(stage, rel)
        if os.path.exists(p):
            t += ["", "==== %s: %s ====" % (c, rel.split("/", 1)[1]), "", open(p, errors="replace").read().rstrip()]
    for f in spec.get("own_licences", []):
        t += ["", "==== PSPExp: %s ====" % f, "", open(os.path.join(ROOT, f), errors="replace").read().rstrip()]
    os.makedirs(docdir, exist_ok=True)
    open(os.path.join(docdir, "copyright"), "w").write("\n".join(t) + "\n")


def main():
    a = sys.argv[1:]
    if a[:1] == ["list"]:
        print("\n".join(sorted(PACKAGES)))
    elif a[:1] == ["archive"] and len(a) == 3:
        print(archive(a[1], a[2])[0])
    elif a[:1] == ["copyright"] and len(a) == 4:
        copyright(a[1], a[2], a[3])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
