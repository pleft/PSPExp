#!/usr/bin/env python3
"""
A PSP runtime set with its VERSION file (docs/Package_Manager.md §6.1), from the
build's dist/PSPExp:
  scripts/packages/runtime-slot OUTDIR            OUTDIR/pspexp_runtime.prx, pspexp_usb.prx, VERSION
  scripts/packages/runtime-slot --install OUTDIR  a whole slotted install for a memory stick:
                                                  EBOOT.PBP (the loader), slot-a/ (the set), active;
                                                  over an existing one (recovery) its slots, pending
                                                  update and flat modules are removed first
VERSION: version=..., then file=NAME size=N sha256=HEX per module.
"""
import hashlib, os, shutil, subprocess, sys, time

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
DIST = os.path.join(ROOT, "dist/PSPExp")
MODULES = ("pspexp_runtime.prx", "pspexp_usb.prx")


def version():
    g = subprocess.run(["git", "-C", ROOT, "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
    return time.strftime("%Y.%m.%d.%H%M%S", time.gmtime()) + "+g" + g


def make_set(out):
    os.makedirs(out, exist_ok=True)
    lines = ["version=" + version()]
    # a release (a tag vX.Y.Z on this very commit): its name for the PSP's status page; version= stays
    # the date, which the board compares for updates (the loader skips lines it does not know)
    tag = subprocess.run(["git", "-C", ROOT, "describe", "--tags", "--exact-match", "--match", "v[0-9]*", "HEAD"],
                         capture_output=True, text=True).stdout.strip()
    if tag:
        lines.append("release=" + tag)
    for m in MODULES:
        src = os.path.join(DIST, m)
        shutil.copy(src, os.path.join(out, m))
        data = open(src, "rb").read()
        lines.append("file=%s size=%d sha256=%s" % (m, len(data), hashlib.sha256(data).hexdigest()))
    lines.append("end")   # the last line: the loader refuses a VERSION without it (one cut short)
    open(os.path.join(out, "VERSION"), "w").write("\n".join(lines) + "\n")
    return lines[0]


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--install":
        out = sys.argv[2]
        os.makedirs(out, exist_ok=True)
        # also the recovery of a broken install: the loader prefers a pending
        # active.new (when its slot checks) and never looks at modules next to
        # the EBOOT while any slot file is there, so what was there goes first
        for name in ("active.new", "active", "fallback") + MODULES:
            p = os.path.join(out, name)
            if os.path.exists(p):
                os.remove(p)
        for slot in ("slot-a", "slot-b"):
            shutil.rmtree(os.path.join(out, slot), ignore_errors=True)
        shutil.copy(os.path.join(DIST, "EBOOT.PBP"), os.path.join(out, "EBOOT.PBP"))
        v = make_set(os.path.join(out, "slot-a"))
        open(os.path.join(out, "active"), "w").write("slot=a\ntries=0\n")
        print("%s: EBOOT.PBP, slot-a (%s), active" % (out, v))
    elif len(sys.argv) == 2:
        print(make_set(sys.argv[1]))
    else:
        print(__doc__.strip()); sys.exit(2)


if __name__ == "__main__":
    main()
