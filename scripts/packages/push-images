#!/bin/sh
# The card images as a download (docs/Package_Manager.md §8b): each image compressed (xz) with its
# SHA-256, dated, in its own R2 bucket behind its own address (dl.pspexp.dev; the package
# repository's bucket is apt-repo's, whose push replaces what it does not have), with the sources
# GPL asks for beside them, and an index page.
#   scripts/packages/push-images [DATE]        (DATE: the release's name, default today, UTC;
#                                               a second release the same day: DATE.2)
# Takes build/pi-image/pspexp-pi.img and build/gameshell-base/pspexp-gameshell.img as they are
# (build them first: scripts/pi/image/build-image.sh, scripts/gameshell/base/build-image.sh), and
# refuses one that holds an SSH key or a Wi-Fi connection (a build for your own card).
# ~/.pspexp/r2.env: R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_IMAGES_BUCKET,
# R2_IMAGES_URL (the keys reach rclone through its environment, as apt-repo's).
# Uploaded:
#   pspexp-pi-DATE.img.xz, pspexp-gameshell-DATE.img.xz, each with .sha256   (never change: cached)
#   sources/DATE/   Linux and U-Boot as the GameShell image was built from them (upstream archives,
#                   unchanged), our boot files (config, device tree, patch, scripts), and each
#                   image's package list with the source package of each (Debian's and Raspberry
#                   Pi's archives hold those sources), README.txt
#   index.html      the latest release (no-cache); older releases are removed (images, sums, sources)
set -e
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
DATE="${1:-$(date -u +%Y-%m-%d)}"
echo "$DATE" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}(\.[0-9]+)?$' || { echo "push-images: a release is named YYYY-MM-DD or YYYY-MM-DD.N" >&2; exit 2; }
OUT="$ROOT/build/release/$DATE"
PI="$ROOT/build/pi-image/pspexp-pi.img"
GS="$ROOT/build/gameshell-base/pspexp-gameshell.img"
GSB="$ROOT/build/gameshell-base"
KVER=$(sed -n 's/^KVER="\${KVER:-\(.*\)}"$/\1/p' "$ROOT/scripts/gameshell/base/build-kernel.sh")
UVER=$(sed -n 's/^UVER="\${UVER:-\(.*\)}"$/\1/p' "$ROOT/scripts/gameshell/base/build-uboot.sh")
for f in "$PI" "$GS" "$GSB/linux-$KVER.tar.xz" "$GSB/u-boot-$UVER.tar.bz2"; do
	[ -f "$f" ] || { echo "push-images: no $f (build it first)" >&2; exit 1; }
done
cfg="$HOME/.pspexp/r2.env"
[ -f "$cfg" ] || { echo "push-images: no $cfg" >&2; exit 1; }
v() { sed -n "s/^$1=//p" "$cfg" | head -1 | sed "s/^[\"']//; s/[\"']\$//"; }
for k in R2_ACCOUNT_ID R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY R2_IMAGES_BUCKET R2_IMAGES_URL; do
	[ -n "$(v $k)" ] || { echo "push-images: $k missing in $cfg" >&2; exit 1; }
done
URL=$(v R2_IMAGES_URL | sed 's#/*$##')
mkdir -p "$OUT/sources"

# each image's package list (and the check that it is a release build), read from the image itself
docker run --rm --privileged --platform linux/arm64 -v "$ROOT/build":/b:ro -v "$OUT":/o debian:trixie sh -ec '
for x in "pi 1064960 /b/pi-image/pspexp-pi.img" "gameshell 139264 /b/gameshell-base/pspexp-gameshell.img"; do
	set -- $x; mkdir -p /r; mount -o ro,loop,offset=$(($2 * 512)) $3 /r
	if ls /r/home/*/.ssh/authorized_keys >/dev/null 2>&1 || [ -n "$(ls /r/etc/NetworkManager/system-connections/ 2>/dev/null)" ]; then
		echo "push-images: $3 holds an SSH key or a Wi-Fi connection: not a release build" >&2; umount /r; exit 1
	fi
	dpkg-query --admindir=/r/var/lib/dpkg -W -f="\${Package} \${Version} \${Architecture} \${source:Package} \${source:Version}\n" > /o/sources/packages-$1.txt
	dpkg-query --admindir=/r/var/lib/dpkg -W -f="\${Version}" pspexp-core > /o/core-$1
	umount /r
done'

# the GameShell's boot: upstream sources as they were, and ours
cp "$GSB/linux-$KVER.tar.xz" "$GSB/u-boot-$UVER.tar.bz2" "$OUT/sources/"
cp "$GSB/kernel/config" "$OUT/sources/linux-$KVER-gameshell.config"   # the whole .config it was built with
( cd "$ROOT" && tar -czf "$OUT/sources/pspexp-gameshell-boot.tar.gz" \
	scripts/gameshell/base/build-kernel.sh scripts/gameshell/base/build-uboot.sh scripts/gameshell/base/build-image.sh \
	scripts/gameshell/base/image-setup.sh scripts/gameshell/base/kernel.config scripts/gameshell/base/uboot.config \
	scripts/gameshell/base/uboot-cpi3.patch scripts/gameshell/base/sun8i-r16-clockworkpi-cpi3.dts \
	"scripts/gameshell/base/brcmfmac43430a0-sdio.clockwork,clockworkpi-cpi3.txt" )
cat > "$OUT/sources/README.txt" <<R
PSPExp card images $DATE: their sources

The GameShell image's kernel and boot loader, built from:
  linux-$KVER.tar.xz        Linux $KVER as kernel.org publishes it (GPL-2.0), unchanged
  u-boot-$UVER.tar.bz2      U-Boot $UVER as denx.de publishes it (GPL-2.0), unchanged
  linux-$KVER-gameshell.config   the kernel's whole .config, as built (sunxi_defconfig + kernel.config)
  pspexp-gameshell-boot.tar.gz
      kernel.config, sun8i-r16-clockworkpi-cpi3.dts (the board's device tree), uboot.config,
      uboot-cpi3.patch (the one change to U-Boot), and the scripts that build them and the image
      (build-kernel.sh, build-uboot.sh, build-image.sh, image-setup.sh); the Wi-Fi chip's settings
      file (Ampak's AP6212 NVRAM, GPL-2.0 as linux-firmware carries it).
  Its Bluetooth firmware patch is ClockworkPi's (GPL-3.0): github.com/clockworkpi/bluetooth,
  commit 52feb7abb39a8e8b71b2a593851638c76a3e59c1.

Everything else on the cards is unmodified packages, listed with their source packages in
packages-pi.txt and packages-gameshell.txt (package, version, architecture, source, source version):
  Debian's: https://snapshot.debian.org/ and https://sources.debian.org/
  Raspberry Pi OS's own: https://archive.raspberrypi.com/debian/ (source packages beside the
  binaries); its kernel: https://github.com/raspberrypi/linux
  PSPExp's (pspexp-*): https://pkg.pspexp.dev
R

# the images: compressed, checked
for b in pi gameshell; do
	src=$PI; [ $b = gameshell ] && src=$GS
	f="pspexp-$b-$DATE.img.xz"
	if [ ! -f "$OUT/$f" ] || [ "$OUT/$f" -ot "$src" ]; then
		echo "compressing $f"
		xz -T0 -6 -c "$src" > "$OUT/$f.tmp" && mv "$OUT/$f.tmp" "$OUT/$f"
	fi
	( cd "$OUT" && shasum -a 256 "$f" > "$f.sha256" )
done
( cd "$OUT/sources" && shasum -a 256 * > SHA256SUMS.tmp && mv SHA256SUMS.tmp SHA256SUMS )

size() { du -m "$1" | cut -f1; }
row() {   # board title image-size core
	f="pspexp-$1-$DATE.img.xz"
	printf '<tr><td>%s</td><td><a href="%s">%s</a><br><small>%s MiB, SHA-256 <code>%s</code></small></td><td>%s</td></tr>\n' \
		"$2" "$f" "$f" "$(size "$OUT/$f")" "$(cut -d' ' -f1 "$OUT/$f.sha256")" "$(cat "$OUT/core-$1")"
}
cat > "$OUT/index.html" <<H
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>PSPExp downloads</title>
<style>
body { font: 16px/1.5 system-ui, sans-serif; max-width: 760px; margin: 2em auto; padding: 0 16px; color: #1f2430; background: #fff; }
@media (prefers-color-scheme: dark) { body { color: #dfe3ea; background: #141821; } a { color: #8ab4ff; } }
table { border-collapse: collapse; width: 100%; } td, th { text-align: left; padding: .5em .4em; border-bottom: 1px solid #8884; vertical-align: top; }
code { font-size: .8em; word-break: break-all; }
</style></head><body>
<h1>PSPExp downloads</h1>
<p>Card images for the boards a PSP plays on with PSPExp. Write one to a microSD card with
Raspberry Pi Imager (<em>Use custom</em>) or balenaEtcher (both take the <code>.img.xz</code> as it is),
put it in the board, plug in the PSP running PSPExp, and power on. Games come from
<em>Apps &gt; Packages</em> on the PSP.</p>
<h2>Release $DATE</h2>
<table><tr><th>Board</th><th>Image</th><th>PSPExp</th></tr>
$(row pi "Raspberry Pi 3, 4, 400, 5 (64-bit)")
$(row gameshell "ClockworkPi GameShell")
</table>
<p>Logins: Raspberry Pi <code>pi</code> / <code>pspexp</code>, GameShell <code>cpi</code> / <code>cpi</code>.
SSH is off until you turn it on (Settings &gt; This board &gt; SSH on the PSP); change the password first.</p>
<h2>Sources</h2>
<p>The sources these images are built from, as their licences ask:
<a href="sources/$DATE/README.txt">sources/$DATE/</a>
(Linux and U-Boot for the GameShell, our boot files, and every package with its source).</p>
<p>The package repository: <a href="https://pkg.pspexp.dev/dists/stable/InRelease">pkg.pspexp.dev</a>.</p>
</body></html>
H

# up: the images and sources first (they never change under their names), the page last
export RCLONE_CONFIG_R2_TYPE=s3 RCLONE_CONFIG_R2_PROVIDER=Cloudflare RCLONE_CONFIG_R2_ACL=private RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
export RCLONE_CONFIG_R2_ACCESS_KEY_ID="$(v R2_ACCESS_KEY_ID)" RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$(v R2_SECRET_ACCESS_KEY)"
export RCLONE_CONFIG_R2_ENDPOINT="https://$(v R2_ACCOUNT_ID).r2.cloudflarestorage.com"
D="R2:$(v R2_IMAGES_BUCKET)"
base="rclone --checksum --transfers 4 --stats-one-line --stats 0 -q"
# a published name never gets other content: the images are cached for good under it (a second
# release the same day is DATE.2)
for b in pi gameshell; do
	f="pspexp-$b-$DATE.img.xz"
	old=$(rclone cat "$D/$f.sha256" 2>/dev/null | cut -d' ' -f1)
	if [ -n "$old" ] && [ "$old" != "$(cut -d' ' -f1 "$OUT/$f.sha256")" ]; then
		echo "push-images: $f is published with other content: name this release $DATE.2 (or the next number)" >&2; exit 1
	fi
done
$base --header-upload "Cache-Control: public, max-age=31536000, immutable" copy "$OUT/sources" "$D/sources/$DATE"
for b in pi gameshell; do
	$base --header-upload "Cache-Control: public, max-age=31536000, immutable" copyto "$OUT/pspexp-$b-$DATE.img.xz" "$D/pspexp-$b-$DATE.img.xz"
	$base --header-upload "Cache-Control: no-cache" copyto "$OUT/pspexp-$b-$DATE.img.xz.sha256" "$D/pspexp-$b-$DATE.img.xz.sha256"
done
$base --header-upload "Cache-Control: no-cache" copyto "$OUT/index.html" "$D/index.html"
# kept out of search engines until the project is public (the user's choice, 2026-10-10: no
# rewrite of / to the page either); remove with the repository going public
printf 'User-agent: *\nDisallow: /\n' > "$OUT/robots.txt"
$base --header-upload "Cache-Control: no-cache" copyto "$OUT/robots.txt" "$D/robots.txt"
# only the latest release is kept (the user: no point keeping the older ones and their storage):
# the other dates' images, checksums and sources go, once this one and its page are up
for f in $(rclone lsf "$D" 2>/dev/null | grep -E '^pspexp-(pi|gameshell)-[0-9]{4}-[0-9]{2}-[0-9]{2}(\.[0-9]+)?\.img\.xz(\.sha256)?$' | grep -v -F -- "-$DATE.img"); do
	echo "removing $f (an older release)"
	rclone -q deletefile "$D/$f"
done
for d in $(rclone lsf --dirs-only "$D/sources" 2>/dev/null | tr -d / | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}(\.[0-9]+)?$' | grep -v -x -F -- "$DATE"); do
	echo "removing sources/$d (an older release)"
	rclone -q purge "$D/sources/$d"
done
echo "uploaded release $DATE to $URL: $(curl -s -o /dev/null -w '%{http_code}' "$URL/index.html") for index.html"
