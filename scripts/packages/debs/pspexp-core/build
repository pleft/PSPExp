#!/bin/sh
# pspexp-core: PSPExp on a Debian board, as a package (docs/Package_Manager.md §6):
# the console and launcher (pspexp-term), the SDL layer, pspexp-exec / -run /
# -pkg / -ms, the root helper pspexp-pkg-apt, the board setup script, the
# launcher's fonts. Its scripts never restart the running console: it notices
# the new file and offers System > Restart PSPExp.
#   build OUTDIR arm64 USER@PI      the Pi's own build (~/pspexp/src/build: scripts/pi/install.sh build)
#   build OUTDIR arm64 DIR          or one in a local folder (a Debian 13 arm64 container's)
#   build OUTDIR armhf              the GameShell's (scripts/gameshell/build.sh: build/gameshell)
set -e
ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
OUT="$1"; ARCH="$2"; SRC_HOST="$3"
W=$(mktemp -d); trap 'rm -rf "$W"' EXIT
mkdir -p "$W/b"
case "$ARCH" in
arm64)
	[ -n "$SRC_HOST" ] || { echo "arm64: give the Pi (user@host) whose build to package, or a local folder holding one" >&2; exit 2; }
	if [ -d "$SRC_HOST" ]; then   # a build made elsewhere (a Debian 13 arm64 container: the same libraries as Raspberry Pi OS)
		cp "$SRC_HOST/pspexp-term" "$SRC_HOST/libsdl-pspexp.so" "$W/b/"
		cp "$SRC_HOST/pspexp-ms" "$SRC_HOST/libsdl-pspexp-hostgl.so" "$W/b/" 2>/dev/null || true
	else
	scp -q "$SRC_HOST:pspexp/src/build/pspexp-term" "$SRC_HOST:pspexp/src/build/libsdl-pspexp.so" "$W/b/"
	scp -q "$SRC_HOST:pspexp/src/build/pspexp-ms" "$W/b/" 2>/dev/null || true
	scp -q "$SRC_HOST:pspexp/src/build/libsdl-pspexp-hostgl.so" "$W/b/" 2>/dev/null || true   # the board's GPU draws (pspexp-run PSPEXP_HOSTGL)
	fi ;;
armhf)
	cp "$ROOT/build/gameshell/bin/pspexp-term" "$W/b/"
	cp "$ROOT/build/gameshell/lib/libsdl-pspexp.so" "$W/b/" 2>/dev/null || true
	cp "$ROOT/build/gameshell/bin/pspexp-ms" "$W/b/" 2>/dev/null || true ;;
*) echo "arch: arm64 | armhf" >&2; exit 2 ;;
esac
V="$(date -u +%Y.%m.%d.%H%M%S)+g$(git -C "$ROOT" rev-parse --short HEAD)"
R="$W/root"
mkdir -p "$R/usr/bin" "$R/usr/sbin" "$R/usr/lib/pspexp" "$R/usr/share/pspexp/launcher" "$R/usr/share/doc/pspexp-core"
install -m 755 "$W/b/pspexp-term" "$R/usr/bin/pspexp-term"
[ -f "$W/b/pspexp-ms" ] && install -m 755 "$W/b/pspexp-ms" "$R/usr/bin/pspexp-ms"
[ -f "$W/b/libsdl-pspexp.so" ] && install -m 644 "$W/b/libsdl-pspexp.so" "$R/usr/lib/pspexp/libsdl-pspexp.so"
[ -f "$W/b/libsdl-pspexp-hostgl.so" ] && install -m 644 "$W/b/libsdl-pspexp-hostgl.so" "$R/usr/lib/pspexp/libsdl-pspexp-hostgl.so"
for f in pspexp-exec pspexp-run pspexp-pkg pspexp-bt pspexp-notify; do install -m 755 "$ROOT/scripts/board/$f" "$R/usr/bin/$f"; done
install -m 755 "$ROOT/scripts/board/pspexp-pkg-apt" "$R/usr/sbin/pspexp-pkg-apt"
mkdir -p "$R/etc/wireplumber/wireplumber.conf.d"   # (macOS install has no -D)
install -m 644 "$ROOT/scripts/board/80-pspexp-bluez.conf" "$R/etc/wireplumber/wireplumber.conf.d/80-pspexp-bluez.conf"   # Bluetooth audio without a login
install -m 755 "$ROOT/scripts/board/pspexp-apt-setup" "$R/usr/share/pspexp/pspexp-apt-setup"
for f in Inter-Regular.ttf Inter-SemiBold.ttf lucide.ttf Inter-LICENSE.txt lucide-LICENSE.txt; do
	install -m 644 "$ROOT/tools/pspexp-term/assets/$f" "$R/usr/share/pspexp/launcher/$f"
done
mkdir -p "$R/usr/share/pspexp/launcher/systems"   # the systems' icons (CC BY 4.0, their LICENSE.txt)
cp "$ROOT/tools/pspexp-term/assets/systems/"* "$R/usr/share/pspexp/launcher/systems/" && chmod 644 "$R/usr/share/pspexp/launcher/systems/"*
echo "PSPExp: the PSP as the screen, sound and controller of this board (docs in the PSPExp repository)." > "$R/usr/share/doc/pspexp-core/README"
# a route whose link is down is not used (scripts/board/90-pspexp-routes.conf): in the package, so a
# board already set up gets it with its update (a GameShell's USB-network route, left after the
# cable came out, had sent everything nowhere); applied at once by postinst
mkdir -p "$R/etc/sysctl.d" "$R/etc/dhcp/dhclient-exit-hooks.d" "$R/etc/dhcp/dhclient-enter-hooks.d"
install -m 644 "$ROOT/scripts/board/pspexp-usb0-dns" "$R/etc/dhcp/dhclient-enter-hooks.d/pspexp-usb0-dns"   # (its name servers after Wi-Fi's)
install -m 644 "$ROOT/scripts/board/pspexp-usb0-metric" "$R/etc/dhcp/dhclient-exit-hooks.d/pspexp-usb0-metric"   # (the GameShell's USB network after Wi-Fi)
install -m 644 "$ROOT/scripts/board/90-pspexp-routes.conf" "$R/etc/sysctl.d/90-pspexp-routes.conf"
cat > "$W/postinst" <<'P'
#!/bin/sh
set -e
[ "$1" = configure ] || exit 0
sysctl -q -p /etc/sysctl.d/90-pspexp-routes.conf >/dev/null 2>&1 || true
exit 0
P
# the board-GPU layer (libsdl-pspexp-hostgl: SuperTuxKart, Celeste 64, the N64...) draws through SDL's
# offscreen driver, which makes its GL context with EGL; Raspberry Pi OS Lite (the card image) has
# no EGL, and SuperTuxKart failed there ("Couldn't initialise irrlicht device"); GLES for the N64's
# video plugin (GLideN64)
GPU_DEPS=""; [ "$ARCH" = arm64 ] && GPU_DEPS=", libegl1, libegl-mesa0, libgles2"
cat > "$W/control" <<C
Package: pspexp-core
Version: $V
Architecture: $ARCH
Maintainer: PSPExp <info@pspexp.dev>
Section: games
Priority: optional
Depends: libc6, libusb-1.0-0, libsdl2-2.0-0, sudo, gpgv, pspexp-runtime$GPU_DEPS
Description: PSPExp: the PSP as this board's console
 The console and launcher that make a PSP the screen, sound and controller
 of this board, the SDL layer that puts SDL2 programs on the PSP, and the
 package tools behind Apps > Packages. Upgrading it never restarts the
 running console; the console offers a restart.
C
python3 "$ROOT/scripts/packages/sources" copyright pspexp-core "$V" "$R/usr/share/doc/pspexp-core"   # licences, and where the complete source is (Package_Manager §6.2)
python3 "$ROOT/scripts/packages/mkdeb.py" "$R" "$W/control" "$OUT/pspexp-core_${V}_$ARCH.deb"
