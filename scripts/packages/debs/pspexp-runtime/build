#!/bin/sh
# pspexp-runtime: the PSP's own runtime set (pspexp_runtime.prx, pspexp_usb.prx,
# VERSION with their checksums; docs/Package_Manager.md §6.1) in
# /usr/share/pspexp/runtime, from the build's dist/PSPExp (scripts/build.sh).
# The console installs it into the PSP's inactive slot over the link. The boot
# loader (EBOOT.PBP) is there too, for the manual route only. Arch all.
# Usage: build OUTDIR
set -e
ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
W=$(mktemp -d); trap 'rm -rf "$W"' EXIT
R="$W/root/usr/share/pspexp/runtime"
mkdir -p "$R" "$W/root/usr/share/doc/pspexp-runtime"
V=$("$ROOT/scripts/packages/runtime-slot" "$R" | sed 's/^version=//')
cp "$ROOT/dist/PSPExp/EBOOT.PBP" "$R/EBOOT.PBP"
echo "The PSP's PSPExp runtime; the console puts it in the PSP's inactive slot. EBOOT.PBP (the boot loader) is for the manual route: USB mode, ms0:/PSP/GAME/PSPExp/." > "$W/root/usr/share/doc/pspexp-runtime/README"
cat > "$W/control" <<C
Package: pspexp-runtime
Version: $V
Architecture: all
Maintainer: PSPExp <pspexp@localhost>
Section: games
Priority: optional
Description: PSPExp's runtime for the PSP
 The modules the PSP runs, with their checksums; the PSPExp console installs
 them into the PSP's inactive slot over the link, and the PSP boots them at
 its next start of PSPExp.
C
python3 "$ROOT/scripts/packages/mkdeb.py" "$W/root" "$W/control" "$1/pspexp-runtime_${V}_all.deb"
