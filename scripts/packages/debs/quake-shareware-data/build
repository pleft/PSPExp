#!/bin/sh
# quake-shareware-data: an installer for Quake's shareware episode (id Software, 1996), for
# Debian's Quakespasm. PSPExp hosts none of it (the user's rule, 2026-10-11): the board downloads
# id's quake106.zip, unaltered, from an idgames mirror (or one of the others; the SHA-256 decides)
# and keeps it whole, as id's licence (slicnse.txt, inside) asks of anyone passing it on;
# /usr/games/quake-shareware unpacks its id1/pak0.pak on the first start, into the user's data
# folder, and runs Quakespasm there (_installer.sh). Usage: build OUTDIR
set -e
. "$(dirname "$0")/../_installer.sh"
ID=quake-shareware-data TITLE="Quake (shareware)" VERSION=1.06-pspexp3 DIR=quake-shareware CMD=quake-shareware
URL=https://ftp.gwdg.de/pub/misc/ftp.idsoftware.com/idstuff/quake/quake106.zip
MIRRORS="https://youfailit.net/pub/idgames/idstuff/quake/quake106.zip http://ftp.fu-berlin.de/pc/games/idgames/idstuff/quake/quake106.zip https://web.archive.org/web/2015id_/ftp://ftp.idsoftware.com/idstuff/quake/quake106.zip https://web.archive.org/web/2020id_/https://youfailit.net/pub/idgames/idstuff/quake/quake106.zip"
SHA=ec6c9d34b1ae0252ac0066045b6611a7919c2a0d78a3a66d9387a8f597553239 SIZE="9 MB" KEEP=quake106.zip
RUN='if [ ! -s "$D/id1/pak0.pak" ]; then
	T=$(mktemp -d); trap '"'"'rm -rf "$T"'"'"' EXIT
	unzip -q "$G/quake106.zip" resource.1 -d "$T"
	(cd "$T" && lhasa -xq resource.1 >/dev/null)
	mkdir -p "$D/id1"
	mv "$T/id1/pak0.pak" "$D/id1/pak0.pak.part" && mv "$D/id1/pak0.pak.part" "$D/id1/pak0.pak"
	cp "$T/slicnse.txt" "$D/" 2>/dev/null || true
fi
# Liquids the old way: by default Quakespasm draws each into an image it makes by copying from the
# framebuffer (glCopyTexSubImage2D), which PSPExp'"'"'s OpenGL cannot do: the image kept what memory
# held when it was made, rainbow noise on water and slime. Set in autoexec.cfg (on the command line
# it did not hold), unless the player set it there.
if ! grep -qs "^r_oldwater" "$D/id1/autoexec.cfg"; then
	mkdir -p "$D/id1"
	echo "r_oldwater 1 // water warped by Quake itself (PSPExp: no framebuffer copies)" >> "$D/id1/autoexec.cfg"
fi
exec /usr/games/quakespasm -basedir "$D" "$@"'
DEPENDS="quakespasm, lhasa, unzip"
ABOUT=" id Software's freely distributable shareware release of Quake (1996), its
 archive unaltered; quake-shareware unpacks the game data on the first start
 and runs Quakespasm."
build_installer "$1"
