#!/bin/sh
# heroes2-demo: an installer for the demo of Heroes of Might and Magic II (New
# World Computing, 1996: one scenario, Broken Alliance) on Debian's fheroes2,
# the free re-creation of its engine: the board downloads the demo's original
# release from archive.org when it is installed (_installer.sh), the same file
# and SHA-256 as fheroes2's own script/demo/download_demo_version.sh, nothing of
# it hosted by PSPExp. fheroes2 reads its folders lowercase (data, maps) and an
# extra data folder from FHEROES2_DATA. Usage: build OUTDIR
set -e
. "$(dirname "$0")/../_installer.sh"
ID=heroes2-demo TITLE="Heroes of Might and Magic II (demo)" VERSION=1.0-pspexp1
URL=https://archive.org/download/HeroesofMightandMagicIITheSuccessionWars_1020/h2demo.zip
SHA=12048c8b03875c81e69534a3813aaf6340975e77b762dc1b79a4ff5514240e3c SIZE="22 MB" TOP=""
AFTER='mv "$G.new/DATA" "$G.new/data" && mv "$G.new/MAPS" "$G.new/maps"'
RUN='FHEROES2_DATA="$G" exec /usr/games/fheroes2 "$@"'
DEPENDS=fheroes2
ABOUT=" New World Computing's 1996 turn-based fantasy strategy game, its demo:
 the Broken Alliance scenario, for fheroes2."
build_installer "$1"
