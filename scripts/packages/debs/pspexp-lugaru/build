#!/bin/sh
# pspexp-lugaru: Lugaru HD (Debian's, OSS Lugaru 1.2) made ready for the PSP:
# /usr/games/pspexp-lugaru writes, on its first run, a player ("Player":
# Lugaru wants a name typed, which the PSP's buttons cannot) and settings at
# the PSP's 480x272, then starts Debian's lugaru. Its OpenGL is the old fixed
# kind: the SDL layer draws it on the PSP's GE. Usage: build OUTDIR
set -e
ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
OUT="$1"
V=1.2-pspexp1
W=$(mktemp -d); trap 'rm -rf "$W"' EXIT
mkdir -p "$W/root/usr/games" "$W/root/usr/share/doc/pspexp-lugaru"
cat > "$W/root/usr/games/pspexp-lugaru" <<'S'
#!/bin/sh
# Lugaru for the PSP (package pspexp-lugaru): a player and 480x272 settings on the first run
C="${XDG_CONFIG_HOME:-$HOME/.config}/lugaru"
D="${XDG_DATA_HOME:-$HOME/.local/share}/lugaru"
mkdir -p "$C" "$D"
if [ ! -f "$C/config.txt" ]; then
cat > "$C/config.txt" <<'CFG'
Screenwidth:
480
Screenheight:
272
Fullscreen:
0
Mouse sensitivity:
1
Blur(0,1):
1
Overall Detail(0,1,2) higher=better:
2
Floating jump:
0
Mouse jump:
0
Ambient sound:
1
Blood (0,1,2):
0
Auto slomo:
1
Foliage:
1
Music:
1
Trilinear:
1
Decals(shadows,blood puddles,etc):
1
Invert mouse:
0
Gamespeed:
1
Damage effects(blackout, doublevision):
0
Text:
1
Show Points:
0
Always Blur:
0
Immediate mode (turn on on G5):
0
Velocity blur:
0
Volume:
0.8
Forward key:
26
Back key:
22
Left key:
4
Right key:
7
Jump key:
44
Crouch key:
225
Draw key:
8
Throw key:
20
Attack key:
513
Console key:
53
Damage bar:
0
StereoMode:
0
StereoSeparation:
0.05
StereoReverse:
0
CFG
fi
if [ ! -s "$D/users" ]; then
	# Account::saveFile, big-endian: one account, active 0; difficulty 1, progress 0, the campaign
	# "main" (no time, scores or choices), current campaign "main", no points, 50 high scores and
	# times, 60 unlocked flags, the name "Player"
	{ printf '\000\000\000\001\000\000\000\000\000\000\000\001\000\000\000\000\000\000\000\001'
	  printf '\000\000\000\004main'; head -c 20 /dev/zero
	  printf '\000\000\000\004main'; head -c 464 /dev/zero
	  printf '\000\000\000\006Player'; } > "$D/users"
fi
exec /usr/games/lugaru "$@"
S
chmod 755 "$W/root/usr/games/pspexp-lugaru"
echo "Lugaru HD for PSPExp: a launch script that prepares a player and 480x272 settings for Debian's lugaru (OSS Lugaru, GPL-2.0+, data CC BY-SA)." > "$W/root/usr/share/doc/pspexp-lugaru/README"
cat > "$W/control" <<C
Package: pspexp-lugaru
Version: $V
Architecture: all
Maintainer: PSPExp <pspexp@localhost>
Section: games
Priority: optional
Depends: lugaru
Description: Lugaru HD, ready for the PSP
 A launch script for Debian's Lugaru that makes a player and settings for
 the PSP's screen on the first run. Packaged by PSPExp.
C
python3 "$ROOT/scripts/packages/mkdeb.py" "$W/root" "$W/control" "$OUT/pspexp-lugaru_${V}_all.deb"
