#!/bin/sh
# commander-keen1: an installer for Commander Keen 1 (id Software / Apogee, 1990:
# Invasion of the Vorticons, episode 1: Marooned on Mars), the freely distributed shareware episode, on Commander Genius
# (pspexp-commandergenius): the board downloads it when it is installed, from where
# Commander Genius' own in-game store fetches it (its catalogue on SourceForge, keen1.zip),
# into /usr/share/games/commandergenius/games/keen1, which the game searches; nothing of it
# hosted by PSPExp. Usage: build OUTDIR
set -e
. "$(dirname "$0")/../_installer.sh"
ID=commander-keen1 TITLE="Commander Keen 1 (shareware)" VERSION=1.0-pspexp1
URL=https://downloads.sourceforge.net/project/clonekeenplus/Downloads/keen1.zip
SHA=3d0730f7e4b7c10967609faf5290768eae40b9b6f685060a0ac17c258521a364 SIZE="150 KB" TOP=keen1
DIR=commandergenius/games/keen1
RUN='exec /usr/games/pspexp-keen keen1'
DEPENDS=pspexp-commandergenius
ABOUT=" Commander Keen 1, Invasion of the Vorticons, episode 1: Marooned on Mars (1990), its freely
 distributed shareware episode, played on Commander Genius."
build_installer "$1"
