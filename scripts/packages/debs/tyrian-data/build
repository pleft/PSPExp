#!/bin/sh
# tyrian-data: an installer for Tyrian 2.1 (freeware since 2004), its data where Debian's
# opentyrian reads it (/usr/share/games/tyrian; no game-data-packager and its GTK). PSPExp hosts
# none of it (the user's rule, 2026-10-11): the board downloads tyrian21.zip from OpenTyrian's
# site (or a mirror; the SHA-256 decides) and unpacks it as released (_installer.sh).
# Usage: build OUTDIR
set -e
. "$(dirname "$0")/../_installer.sh"
ID=tyrian-data TITLE="Tyrian 2.1" VERSION=2.1-pspexp2 DIR=tyrian
URL=https://camanis.net/tyrian/tyrian21.zip
MIRRORS="https://web.archive.org/web/2023id_/https://camanis.net/tyrian/tyrian21.zip https://web.archive.org/web/2015id_/http://sites.google.com/a/camanis.net/opentyrian/tyrian/tyrian21.zip"
SHA=7790d09a2a3addcd33c66ef063d5900eb81cc9c342f4807eb8356364dd1d9277 SIZE="4.5 MB" TOP=tyrian21
RUN='exec /usr/games/opentyrian "$@"'
DEPENDS=opentyrian
ABOUT=" The freeware data of the vertical shooter Tyrian 2.1 (1995; freeware since
 2004), in the folder Debian's opentyrian reads."
build_installer "$1"
