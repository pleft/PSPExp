#!/bin/sh
# pspexp-opensurge: Open Surge (GPL-3.0; its data under free licences, each
# listed in its licenses/ folder), which Debian 13 does not carry, built by
# scripts/packages/build-opensurge.sh ARCH with its private Allegro 5 (through
# SDL) and SurgeScript. Installs /usr/lib/pspexp/opensurge/ (the program, lib/)
# and its data in /usr/share/games/opensurge. Usage: build OUTDIR ARCH
set -e
ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
OUT="$1"; ARCH="$2"
B="$ROOT/build/$ARCH/opensurge"
[ -x "$B/opensurge" ] && [ -s "$B/depends.txt" ] || { echo "no $B/opensurge: scripts/packages/build-opensurge.sh $ARCH first" >&2; exit 1; }
V=0.6.1.3-pspexp1
W=$(mktemp -d); trap 'rm -rf "$W"' EXIT
mkdir -p "$W/root/usr/lib/pspexp/opensurge" "$W/root/usr/share/games" "$W/root/usr/share/doc/pspexp-opensurge"
cp "$B/opensurge" "$W/root/usr/lib/pspexp/opensurge/"
cp -RP "$B/lib" "$W/root/usr/lib/pspexp/opensurge/"
cp -R "$B/share" "$W/root/usr/share/games/opensurge"
cp "$B/COPYING" "$W/root/usr/share/doc/pspexp-opensurge/" 2>/dev/null || true
chmod -R u=rwX,go=rX "$W/root"
echo "Open Surge 0.6.1.3 (https://github.com/alemart/opensurge), GPL-3.0, with SurgeScript 0.6.1 (Apache-2.0) and Allegro 5.2.11 (zlib, built with its SDL2 backend; the dialog add-on a stand-in) by PSPExp. The data's licences are in /usr/share/games/opensurge/licenses and LICENSE." > "$W/root/usr/share/doc/pspexp-opensurge/README"
cat > "$W/control" <<C
Package: pspexp-opensurge
Version: $V
Architecture: $ARCH
Maintainer: PSPExp <pspexp@localhost>
Section: games
Priority: optional
Depends: $(cat "$B/depends.txt")
Description: Open Surge, for PSPExp
 A 2D platformer in the spirit of the classic Sonic games, and a game
 engine, which Debian does not carry. Built with Allegro 5 through SDL so
 that PSPExp's SDL layer takes its window. Packaged by PSPExp.
C
python3 "$ROOT/scripts/packages/mkdeb.py" "$W/root" "$W/control" "$OUT/pspexp-opensurge_${V}_$ARCH.deb"
