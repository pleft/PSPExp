#!/bin/sh
# alter-aila-genesis: an installer for Alter A.I.L.A. Genesis (Neok, 2010; RPG
# Maker 2003; freeware) on EasyRPG Player: its terms do not say PSPExp may pass
# it on, so the board downloads the developer's release of 24 Nov 2010 (the
# Internet Archive's copy of rpgmaker.net's download) when it is installed
# (_installer.sh). It needs no RTP (FullPackageFlag=1); saves go to the user's
# data folder. Usage: build OUTDIR
set -e
. "$(dirname "$0")/../_installer.sh"
ID=alter-aila-genesis TITLE="Alter A.I.L.A. Genesis" VERSION=2010.11.24-pspexp4
URL="https://archive.org/download/rmn-game-272-alter-a-i-l-a-genesis/272%2Fdownloads%2FAlter%20Aila%20Genesis%20-%20Nov%2024%2C%202010_1.rar"
SHA=1a832ab87a5d5e47e8949d9b4f5efdb123ad14d25a0c70ec655bcfbc7d474761 SIZE="76 MB" TOP="Alter Aila Genesis"
RUN='exec /usr/games/easyrpg-player --project-path "$G" --save-path "$D" "$@"'
DEPENDS=pspexp-easyrpg CONFLICTS=alter-aila-genesis-data
ABOUT=" Neok's 2010 science-fiction RPG made in RPG Maker 2003, freeware, for
 EasyRPG Player."
build_installer "$1"
