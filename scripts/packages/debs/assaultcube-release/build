#!/bin/sh
# assaultcube-release: an installer for AssaultCube 1.3.0.2's game data (its
# maps, models, sounds and settings, under the licences of its README): the
# board downloads the project's Linux release from GitHub when it is installed
# (_installer.sh) and runs it with pspexp-assaultcube's client. Not named
# assaultcube: Debian's package of that name would win. Usage: build OUTDIR
set -e
. "$(dirname "$0")/../_installer.sh"
ID=assaultcube-release TITLE="AssaultCube" VERSION=1.3.0.2-pspexp2
URL=https://github.com/assaultcube/AC/releases/download/v1.3.0.2/AssaultCube_v1.3.0.2_LockdownEdition_RC1.tar.bz2
SHA=9b3118e7929253f0114fa06cad8310faab646d177b4660406011152f34086b55 SIZE="52 MB" TOP=""
RUN='cd "$G" && exec /usr/lib/pspexp/assaultcube/native_client --home="$D" --init -w480 -h272 "$@"'
DEPENDS=pspexp-assaultcube
ABOUT=" AssaultCube, the free online first-person shooter: its release's data,
 run with PSPExp's build of its client."
build_installer "$1"
