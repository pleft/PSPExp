diff --git a/yabause/src/retro_arena/InputManager.cpp b/yabause/src/retro_arena/InputManager.cpp
index 12ce1b14e..7ba2ecc60 100644
--- a/yabause/src/retro_arena/InputManager.cpp
+++ b/yabause/src/retro_arena/InputManager.cpp
@@ -626,6 +626,14 @@ void InputManager::init( const std::string & fname )
     if( result.id == -1 ){
       it->second->getInputByName("hotkeyenable", &result);
     }
+    if( result.id == -1 ){
+      /* PSPExp: no EmulationStation input file, so the menu's button is the device's
+         "select" in keymapv2.json (otherwise only the Escape key opens the menu) */
+      std::string ng;
+      genJoyString( ng, it->second->getDeviceId(), it->second->getDeviceName(), it->second->getDeviceGUIDString() );
+      if( j.find(ng) != j.end() && j[ng].find("select") != j[ng].end() && j[ng]["select"]["type"] == "button" )
+        result.id = j[ng]["select"]["id"].get<int>();
+    }
     tmp.select_device_ = it->second->getDeviceId();    
     tmp.select_button_ = result.id;
     printf("select_device_ = %d, select_button_ = %d\n", tmp.select_device_, tmp.select_button_ );
diff --git a/yabause/src/retro_arena/main.cpp b/yabause/src/retro_arena/main.cpp
index b37528b51..8153161e9 100644
--- a/yabause/src/retro_arena/main.cpp
+++ b/yabause/src/retro_arena/main.cpp
@@ -367,6 +367,10 @@ int main(int argc, char** argv)
     printf("Fail to SDL_GetCurrentDisplayMode Bye! (%s)", SDL_GetError() );
     return -1;
   }
+  /* An OpenGL ES context: its shaders and formats are written for ES 3.1, and Mesa
+     otherwise gives a desktop context (the Pi 400's V3D: GL 3.1, where VDP1 sprites
+     with palette colours came out as one colour). */
+  SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
   SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
   SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 1);
   SDL_GL_SetSwapInterval(0);
@@ -385,8 +389,13 @@ int main(int argc, char** argv)
 #else
   int width = dsp.w;
   int height = dsp.h;
+  Uint32 wflags = SDL_WINDOW_OPENGL | SDL_WINDOW_SHOWN | SDL_WINDOW_FULLSCREEN_DESKTOP;
+  /* YABASANSHIRO_WINDOW=WxH: a window of that size instead of the whole display
+     (PSPExp: the PSP shows 480x272, so a smaller picture to read back each frame). */
+  const char * ws = getenv("YABASANSHIRO_WINDOW");
+  if( ws != nullptr && sscanf(ws, "%dx%d", &width, &height) == 2 ) wflags &= ~SDL_WINDOW_FULLSCREEN_DESKTOP;
   wnd = SDL_CreateWindow("Yaba Snashiro", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
-      width, height, SDL_WINDOW_OPENGL | SDL_WINDOW_SHOWN | SDL_WINDOW_FULLSCREEN_DESKTOP);
+      width, height, wflags);
   if(wnd == nullptr ) {
     printf("Fail to SDL_CreateWindow Bye! (%s)", SDL_GetError() );
     return -1;
