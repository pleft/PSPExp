#!/usr/bin/env python3
"""
Check PSPExp's recipes (recipes/<id>/recipe; format: docs/Package_Manager.md §4).
  scripts/packages/check-recipes [RECIPES_DIR]      0 when all are fine, 1 with the problems
"""
import os, re, sys

SECTIONS = {"package", "debian", "omega", "entry", "system"}
PACKAGE_KEYS = {"id", "title", "description", "category", "license", "version", "requires", "terms"}
BOARD_KEYS = {"apt", "core", "build", "data", "warn"}
ENTRY_KEYS = {"id", "title", "type", "description", "icon", "exec", "keys", "nub", "env", "first-run", "native", "cover", "art", "graphics", "control"}
SYSTEM_KEYS = {"id", "name", "short", "icon", "ext", "roms", "thumbs", "keys", "nub", "env", "native", "graphics", "exec", "control"}
GRAPHICS = {"sdl", "opengl", "opengl-shaders", "board-gpu"}   # how it draws: the launcher's details card and Packages say so
DESCRIPTION_MAX = 220                            # what the details card shows over its lines
CATEGORIES = {"game", "system", "app", "tool"}
KEY_NAME = re.compile(r"^[a-z0-9]+(\+[a-z0-9]+)*$")
BUTTONS = {"cross", "circle", "square", "triangle", "l", "r", "start", "select", "up", "down", "left", "right"}
CONTROL_BUTTONS = BUTTONS | {"nub", "dpad"}     # control=BUTTONS: what they do, the launcher's controls sheet
CONTROL_TEXT_MAX = 40                            # what fits the sheet's line
CONTROL_LINES_MAX = 11
ID = re.compile(r"^[a-z0-9][a-z0-9-]*$")
APT = re.compile(r"^[a-z0-9][a-z0-9+.-]+$")


def parse(path):
    """[(section, key, value, line)]; sections may carry a board: [debian:gameshell]"""
    out, sec = [], None
    with open(path, encoding="utf-8") as f:
        for n, raw in enumerate(f, 1):
            line = raw.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            m = re.match(r"^\[([a-z]+)(?:\.([a-z0-9-]+))?(?::([a-z0-9]+))?\]$", line.strip())
            if m:
                sec = m.group(0)[1:-1]
                continue
            if "=" not in line:
                out.append((sec, None, line, n))
                continue
            k, v = line.split("=", 1)
            out.append((sec, k.strip(), v.strip(), n))
    return out


def check(dirpath):
    errs = []
    rid = os.path.basename(dirpath.rstrip("/"))
    path = os.path.join(dirpath, "recipe")
    if not os.path.isfile(path):
        return ["%s: no recipe file" % rid]
    items = parse(path)
    sections, controls = {}, {}
    for sec, k, v, n in items:
        where = "%s/recipe:%d" % (rid, n)
        if sec is None:
            errs.append("%s: outside any section" % where); continue
        base = sec.split(":")[0].split(".")[0]   # [entry.phase2]: one more entry
        if base not in SECTIONS:
            errs.append("%s: unknown section [%s]" % (where, sec)); continue
        if k is None:
            errs.append("%s: not KEY=value: %s" % (where, v)); continue
        allowed = PACKAGE_KEYS if base == "package" else BOARD_KEYS if base in ("debian", "omega") else ENTRY_KEYS if base == "entry" else SYSTEM_KEYS
        if k not in allowed:
            errs.append("%s: [%s] has no key %s" % (where, sec, k))
        if k in ("keys",):
            for pair in v.split(","):
                if "=" not in pair or pair.split("=")[0] not in BUTTONS or not KEY_NAME.match(pair.split("=", 1)[1]):
                    errs.append("%s: keys: '%s' is not BUTTON=key" % (where, pair))
        if k == "control":
            b, _, t = v.partition(":")
            if not t.strip() or not b.split() or any(x not in CONTROL_BUTTONS for x in b.split()):
                errs.append("%s: control=%s is not 'BUTTONS: what they do' (buttons: %s)" % (where, v, ", ".join(sorted(CONTROL_BUTTONS))))
            elif len(t.strip()) > CONTROL_TEXT_MAX:
                errs.append("%s: control=%s: %d characters after the buttons (at most %d)" % (where, v, len(t.strip()), CONTROL_TEXT_MAX))
            controls[sec] = controls.get(sec, 0) + 1
            if controls[sec] == CONTROL_LINES_MAX + 1:
                errs.append("%s: [%s] has more than %d control= lines" % (where, sec, CONTROL_LINES_MAX))
        if base in ("debian", "omega") and k == "apt":
            for p in v.split():
                if not APT.match(p):
                    errs.append("%s: '%s' is not a package name" % (where, p))
        if k == "graphics" and v not in GRAPHICS:
            errs.append("%s: graphics=%s (one of %s)" % (where, v, ", ".join(sorted(GRAPHICS))))
        if k == "description" and len(v) > DESCRIPTION_MAX:
            errs.append("%s: description of %d characters (at most %d)" % (where, len(v), DESCRIPTION_MAX))
        if k == "art" and not (v.startswith("~/") or v.startswith("/")):
            errs.append("%s: art=%s: a picture on the board (~/... or /...); a cover hosted with the recipe is cover.png" % (where, v))
        if k == "data" and "sha256=" not in v:
            errs.append("%s: data without sha256=" % where)
        sections.setdefault(sec, {})[k] = v
    pk = sections.get("package", {})
    for need in ("id", "title", "description", "category", "license", "version"):
        if need not in pk:
            errs.append("%s: [package] needs %s" % (rid, need))
    if pk.get("id") and pk["id"] != rid:
        errs.append("%s: [package] id=%s, but the folder is %s" % (rid, pk["id"], rid))
    if pk.get("id") and not ID.match(pk["id"]):
        errs.append("%s: id '%s': lower case, digits and -" % (rid, pk["id"]))
    if pk.get("category") and pk["category"] not in CATEGORIES:
        errs.append("%s: category %s (one of %s)" % (rid, pk["category"], ", ".join(sorted(CATEGORIES))))
    if pk.get("version") and not pk["version"].isdigit():
        errs.append("%s: version counts the recipe's changes: a whole number" % rid)
    if not any(s.split(":")[0] in ("debian", "omega") for s in sections):
        errs.append("%s: no [debian] or [omega]: nothing to install" % rid)
    if "debian" in sections and "apt" not in sections["debian"]:
        errs.append("%s: [debian] needs apt=" % rid)
    # (a board's own section, [entry:gameshell], only changes some keys of its [entry])
    systems = [s for s in sections if ":" not in s and s.split(".")[0] == "system"]
    entries = [s for s in sections if ":" not in s and s.split(".")[0] == "entry"]
    if pk.get("category") == "system":
        if not systems: errs.append("%s: a system needs [system]" % rid)
        for sec in systems:
            for need in ("name", "short", "ext", "roms", "graphics"):
                if need not in sections[sec]: errs.append("%s: [%s] needs %s" % (rid, sec, need))
        own = all("exec" in sections[sec] and "%ROM%" in sections[sec]["exec"] for sec in systems)
        if "debian" in sections and "core" not in sections["debian"] and not own:
            errs.append("%s: a system's [debian] needs core= (or each [system] an exec= with %%ROM%%)" % rid)
    elif pk.get("category"):
        if not entries: errs.append("%s: needs [entry]" % rid)
        for sec in entries:
            for need in ("title", "exec", "graphics"):
                if need not in sections[sec]: errs.append("%s: [%s] needs %s" % (rid, sec, need))
    ids = [sections[s].get("id", rid) for s in systems + entries]
    if len(ids) != len(set(ids)):
        errs.append("%s: two entries or systems with the same id (give each an id=)" % rid)
    cover = os.path.join(dirpath, "cover.png")
    if os.path.exists(cover):
        with open(cover, "rb") as f:
            head = f.read(24)
        if head[:8] != b"\x89PNG\r\n\x1a\n":
            errs.append("%s: cover.png is not a PNG" % rid)
        else:
            w, h = int.from_bytes(head[16:20], "big"), int.from_bytes(head[20:24], "big")
            if (w, h) != (128, 128):
                errs.append("%s: cover.png is %dx%d, not 128x128" % (rid, w, h))
    return errs


def main():
    root = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))), "recipes")
    errs, n = [], 0
    for d in sorted(os.listdir(root)):
        p = os.path.join(root, d)
        if os.path.isdir(p) and not d.startswith("."):
            n += 1
            errs += check(p)
    for e in errs:
        print(e)
    print("%d recipes, %d problems" % (n, len(errs)))
    sys.exit(1 if errs else 0)


if __name__ == "__main__":
    main()
