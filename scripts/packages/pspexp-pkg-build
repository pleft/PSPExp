#!/bin/sh
# PSPExp packages for a board running the PSPExp launcher, built on the Mac.
#   scripts/packages/pspexp-pkg-build recipes       what can be built (scripts/packages/recipes/*.sh)
#   scripts/packages/pspexp-pkg-build build ID...   -> build/<board>/pkg/ID.tar.gz
#   scripts/packages/pspexp-pkg-build install ID... build when missing, copy, pspexp-pkg install
#   scripts/packages/pspexp-pkg-build remove ID...
#   scripts/packages/pspexp-pkg-build list          what the board has installed
# BOARD=gameshell (default) | omega | pi picks the build; HOST=user@host is the
# board to install on over SSH (default: cpi@gameshell, root@omega, pi@raspberrypi;
# GAMESHELL= is still read, its old name). A recipe
# is a shell script run as `recipe DIR` that fills DIR (the package's <id>/
# directory) and writes DIR/package; it may use $ROOT (this repo), $BOARD,
# $CACHE (downloads, kept between builds), $HOST (for programs compiled
# on the board) and fetch(). A recipe that has no build for $BOARD says
# so and exits 3.
set -e
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
RECIPES="$ROOT/scripts/packages/recipes"
BOARD="${BOARD:-gameshell}"
case "$BOARD" in omega) DEF=root@omega ;; pi) DEF=pi@raspberrypi ;; *) DEF=cpi@gameshell ;; esac
HOST="${HOST:-${GAMESHELL:-$DEF}}"
OUT="$ROOT/build/$BOARD/pkg"
CACHE="$ROOT/build/pkg-cache"   # downloads, shared by every board
export ROOT CACHE BOARD HOST
mkdir -p "$OUT" "$CACHE"

build() {
	id="$1"
	[ -f "$RECIPES/$id.sh" ] || { echo "pspexp-pkg-build: no recipe $RECIPES/$id.sh" >&2; exit 1; }
	w=$(mktemp -d)
	mkdir -p "$w/$id"
	if ! sh "$RECIPES/$id.sh" "$w/$id"; then rm -rf "$w"; echo "pspexp-pkg-build: $id failed" >&2; exit 1; fi
	[ -f "$w/$id/package" ] || { rm -rf "$w"; echo "pspexp-pkg-build: $id wrote no package file" >&2; exit 1; }
	ls "$w/$id"/*.entry >/dev/null 2>&1 || ls "$w/$id"/systems/*.system >/dev/null 2>&1 || { rm -rf "$w"; echo "pspexp-pkg-build: $id has no entry or system" >&2; exit 1; }
	# owned by root in the archive, not by whoever built it
	COPYFILE_DISABLE=1 tar --no-xattrs --uid 0 --gid 0 --uname root --gname root -C "$w" -czf "$OUT/$id.tar.gz" "$id" 2>/dev/null ||
		COPYFILE_DISABLE=1 tar -C "$w" -czf "$OUT/$id.tar.gz" "$id"
	rm -rf "$w"
	echo "built $OUT/$id.tar.gz ($(du -h "$OUT/$id.tar.gz" | cut -f1))"
}

cmd="$1"; [ $# -gt 0 ] && shift
case "$cmd" in
recipes) for r in "$RECIPES"/[!_]*.sh; do printf '%-14s %s\n' "$(basename "$r" .sh)" "$(sed -n 's/^# title: //p' "$r")"; done ;;
build) for id in "$@"; do build "$id"; done ;;
install)
	for id in "$@"; do
		[ -f "$OUT/$id.tar.gz" ] && [ "$OUT/$id.tar.gz" -nt "$RECIPES/$id.sh" ] || build "$id"
		scp -O -q "$OUT/$id.tar.gz" "$HOST:/tmp/$id.tar.gz"   # -O: dropbear (OpenWrt) speaks only the classic protocol
		ssh "$HOST" "pspexp-pkg install /tmp/$id.tar.gz && rm -f /tmp/$id.tar.gz"
	done ;;
remove) ssh "$HOST" "pspexp-pkg remove $*" ;;
list) ssh "$HOST" pspexp-pkg list ;;
*) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
