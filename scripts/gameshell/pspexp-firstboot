#!/bin/sh
# The first boot of a PSPExp GameShell card (pspexp-firstboot.service, once):
# the card image is smaller than the card, so the root partition grows to fill
# it. /etc/pspexp/firstboot-done marks it done; delete that file to run it
# again. Log: /var/log/pspexp-firstboot.log
DONE=/etc/pspexp/firstboot-done
[ -f "$DONE" ] && exit 0
exec >>/var/log/pspexp-firstboot.log 2>&1
echo "== $(date): PSPExp first boot"
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
src=$(findmnt -no SOURCE /)
case "$src" in
/dev/mmcblk*p[0-9]*)
	disk=${src%p*}; part=${src##*p}
	if command -v growpart >/dev/null && growpart "$disk" "$part"; then resize2fs "$src"; fi ;;
esac
echo "free: $(df -h / | awk 'NR == 2 {print $4}')"
mkdir -p /etc/pspexp
date > "$DONE"
echo "== done"
