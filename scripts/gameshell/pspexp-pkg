#!/bin/sh
# PSPExp packages on the GameShell: the titles the launcher shows.
#   pspexp-pkg install FILE.tar.gz...   install or update (FILE holds one <id>/ directory)
#   pspexp-pkg remove ID...
#   pspexp-pkg list
# A package is <id>/package (KEY=value: version, title, description, license,
# requires = commands that must exist), one or more <id>/*.entry files (the
# launcher's entries; exec runs in the package directory), optionally
# <id>/systems/*.system (emulated systems, copied to $ROOT/systems) and
# whatever files the entries run. The launcher notices installs and removals
# by itself. Runs as the owner of $ROOT (cpi), no root needed.
ROOT="${PSPEXP_ROOT:-/opt/pspexp}"
APPS="$ROOT/apps"
SYS="$ROOT/systems"
die() { echo "pspexp-pkg: $*" >&2; exit 1; }
field() { sed -n "s/^$2=//p" "$1/package" 2>/dev/null | head -1; }
[ -d "$APPS" ] && [ -w "$APPS" ] || die "$APPS missing or not writable"
mkdir -p "$SYS"

# never the archive's owners (root on a FAT SD card, the Omega, cannot set them)
untar() {
	if tar --help 2>&1 | grep -q no-same-owner; then tar --no-same-owner -C "$2" -xzf "$1"
	else tar -C "$2" -xzf "$1"; fi
}

install_one() {
	f="$1"
	[ -f "$f" ] || die "$f: no such file"
	tmp=$(mktemp -d "$ROOT/.install.XXXXXX") || die "no temp dir"
	if ! untar "$f" "$tmp"; then rm -rf "$tmp"; die "$f: not a package"; fi
	set -- "$tmp"/*
	if [ $# != 1 ] || [ ! -d "$1" ] || [ ! -f "$1/package" ]; then rm -rf "$tmp"; die "$f: expected one <id>/ directory with a package file"; fi
	dir="$1"; id=$(basename "$dir")
	for c in $(field "$dir" requires); do
		command -v "$c" >/dev/null 2>&1 || { rm -rf "$tmp"; die "$id needs '$c', which is not installed"; }
	done
	# the old version's systems go first (a new version may drop some)
	[ -d "$APPS/$id/systems" ] && for s in "$APPS/$id"/systems/*.system; do [ -f "$s" ] && rm -f "$SYS/$(basename "$s")"; done
	[ -d "$dir/systems" ] && for s in "$dir"/systems/*.system; do [ -f "$s" ] && cp "$s" "$SYS/"; done
	rm -rf "$APPS/.$id.old"
	[ -d "$APPS/$id" ] && mv "$APPS/$id" "$APPS/.$id.old"
	mv "$dir" "$APPS/$id"
	rm -rf "$APPS/.$id.old" "$tmp"
	echo "installed $id $(field "$APPS/$id" version)"
}

remove_one() {
	id="$1"
	case "$id" in ""|*/*|.*) die "bad id '$id'" ;; esac
	[ -d "$APPS/$id" ] || die "$id is not installed"
	[ -d "$APPS/$id/systems" ] && for s in "$APPS/$id"/systems/*.system; do [ -f "$s" ] && rm -f "$SYS/$(basename "$s")"; done
	rm -rf "$APPS/$id"
	echo "removed $id"
}

cmd="$1"; [ $# -gt 0 ] && shift
case "$cmd" in
install) [ $# -ge 1 ] || die "usage: pspexp-pkg install FILE.tar.gz..."; for f in "$@"; do install_one "$f"; done ;;
remove)  [ $# -ge 1 ] || die "usage: pspexp-pkg remove ID..."; for i in "$@"; do remove_one "$i"; done ;;
list)
	for d in "$APPS"/*/; do
		[ -f "$d/package" ] || continue
		d=${d%/}
		printf '%-14s %-10s %s\n' "$(basename "$d")" "$(field "$d" version)" "$(field "$d" title)"
	done ;;
*) echo "usage: pspexp-pkg install FILE.tar.gz... | remove ID... | list" >&2; exit 2 ;;
esac
