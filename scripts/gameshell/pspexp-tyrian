#!/bin/sh
# GameShell: OpenTyrian on the PSP. The launcher's own OpenTyrian is an SDL 1.2
# build the shim cannot reach (it only shows through the mirror, ~14 fps); this
# runs the SDL2 build (~/pspexp/opentyrian, compiled on the GameShell, see
# docs/GameShell_Launcher_and_Shim.md) through pspexp-run: 35 fps, PSP audio.
# Keys as scripts/pspexp-tyrian: cross fire, circle/L sidekick, square/R
# change mode, triangle enter, start pause, select Escape (menu).
#   pspexp-tyrian [opentyrian args...]
BIN="${OPENTYRIAN:-$HOME/pspexp/opentyrian}"
DATA="${TYRIAN_DATA:-$HOME/apps/Menu/21_Indie Games/34_OpenTyrian/OpenTyrian}"
[ -x "$BIN" ] || { echo "pspexp-tyrian: $BIN missing" >&2; exit 1; }
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/opentyrian"
mkdir -p "$CFG"
[ -f "$CFG/opentyrian.cfg" ] || printf 'section video\n\titem fullscreen -1\n\titem scaler None\n\titem scaling_mode integer\n\n' > "$CFG/opentyrian.cfg"
export PSPEXP_KEYS="${PSPEXP_KEYS:-cross=space,circle=lctrl,square=lalt,triangle=return,l=lctrl,r=lalt,start=p,select=escape,up=up,down=down,left=left,right=right}"
export PSPEXP_NUB="${PSPEXP_NUB:-keys}"
exec /usr/local/bin/pspexp-run "$BIN" --data="$DATA" --no-joystick "$@"
