# USB network to the computer the GameShell is plugged into: a fixed address,
# plus an address, route and DNS from that computer's Internet Sharing when it
# is on (PSPExp: the outside world while the Wi-Fi is the PSP's access point).
# brought up when the cable appears (hotplug); "auto" as well raced it at boot
allow-hotplug usb0
iface usb0 inet static
	address 192.168.10.1
	netmask 255.255.255.0
	# the route Internet Sharing gives (dhclient: IF_METRIC) goes after Wi-Fi's (600): a lease kept
	# after the cable came out had sent everything to it ("No route to host"; apt found nothing)
	metric 1000
	post-up (dhclient -nw usb0 > /dev/null 2>&1 &) || true
	pre-down dhclient -r usb0 > /dev/null 2>&1 || true
