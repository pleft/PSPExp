# U-Boot for the ClockworkPi GameShell (CPI3: Allwinner R16, AXP223): the settings
# of the board's own U-Boot (ClockworkOS), found from it:
#   - DRAM 600 MHz: its SPL holds 1200000000 (clock_set_pll11(DRAM_CLK * 2 MHz))
#     and not 864000000 (432 MHz), and a running board's PLL_DDR1 is at 1200 MHz;
#   - ZQ and ODT as both community configs have them;
#   - the AXP223's voltages as the running board has them (Linux keeps U-Boot's).
# The card-detect pin (PB3) comes from the device tree.
# build-uboot.sh turns this into configs/clockworkpi-cpi3_defconfig.
CONFIG_ARM=y
CONFIG_ARCH_SUNXI=y
CONFIG_MACH_SUN8I_A33=y
CONFIG_SPL=y
CONFIG_DEFAULT_DEVICE_TREE="sun8i-r16-clockworkpi-cpi3"
CONFIG_DRAM_CLK=600
CONFIG_DRAM_ZQ=15291
CONFIG_DRAM_ODT_EN=y
CONFIG_AXP221_POWER=y
CONFIG_AXP_DCDC1_VOLT=3000
CONFIG_AXP_DCDC2_VOLT=1100
CONFIG_AXP_DCDC3_VOLT=1200
CONFIG_AXP_DCDC4_VOLT=0
CONFIG_AXP_DCDC5_VOLT=1500
CONFIG_AXP_ALDO1_VOLT=3000
CONFIG_AXP_ALDO2_VOLT=2500
CONFIG_AXP_ALDO3_VOLT=3000
CONFIG_AXP_DLDO1_VOLT=3300
CONFIG_AXP_DLDO2_VOLT=3300
CONFIG_AXP_DLDO3_VOLT=3300
CONFIG_AXP_DLDO4_VOLT=3300
CONFIG_AXP_ELDO1_VOLT=0
CONFIG_AXP_ELDO2_VOLT=0
CONFIG_AXP_ELDO3_VOLT=0
# the boot script leaves breadcrumbs on the boot partition (fatwrite) and boots a uImage (bootm)
CONFIG_FAT_WRITE=y
CONFIG_LEGACY_IMAGE_FORMAT=y
CONFIG_BOOTDELAY=0
