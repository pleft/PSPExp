# PSPExp GameShell kernel: on top of sunxi_defconfig (Allwinner only). The
# board's U-Boot 2018.01 refuses kernel images over 8 MB (CONFIG_SYS_BOOTM_LEN),
# so this stays lean: no multi_v7.
CONFIG_LOCALVERSION="-pspexp"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# systemd, NetworkManager, logind, sandboxing
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_INOTIFY_USER=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_IPV6=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# the virtual keypad (pspexp-term keypad view)
CONFIG_INPUT_UINPUT=m
# Wi-Fi (AP6212: BCM43430 over SDIO) and the PSP access point
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_CFG80211=m
# /proc/net/wireless (link quality) for the launcher's Wi-Fi symbol
CONFIG_CFG80211_WEXT=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_RFKILL=y
# the micro-USB port: host for the PSP, gadget (USB network) for a computer
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_ETH=m
CONFIG_USB_ETH_RNDIS=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
# PMIC, battery, USB power, RTC
CONFIG_SUNXI_RSB=y
CONFIG_MFD_AXP20X_RSB=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_POWER_SUPPLY=y
CONFIG_AXP20X_POWER=y
CONFIG_BATTERY_AXP20X=y
CONFIG_CHARGER_AXP20X=y
CONFIG_AXP20X_ADC=y
CONFIG_RTC_DRV_SUN6I=y
