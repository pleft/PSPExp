#!/bin/sh
# On the development machine (Mac, Linux): run an unmodified SDL2 program with
# a PSP as display, speaker and controller, the SDL layer from build/host.
# (Boards have their own, installed: scripts/board/pspexp-run.)
#
#   scripts/dev/pspexp-run [--tcp[:host[:port]] | --null] <program> [args...]
#
# Environment passed through: PSPEXP_KEYS, PSPEXP_NUB, PSPEXP_LOCAL_AUDIO,
# PSPEXP_SHOT_EVERY (see compatibility/sdl-pspexp/README.md).
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
case "$1" in
	--tcp*) export PSPEXP="tcp${1#--tcp}"; shift ;;
	--null) export PSPEXP=null; shift ;;
	--usb) export PSPEXP=usb; shift ;;
esac
[ -n "$PSPEXP" ] || export PSPEXP=usb
[ $# -ge 1 ] || { echo "usage: pspexp-run [--tcp[:host[:port]]|--null|--usb] <program> [args...]" >&2; exit 2; }
case "$(uname -s)" in
	Darwin)
		LIB="$ROOT/build/host/libsdl-pspexp.dylib"
		[ -f "$LIB" ] || { echo "$LIB not built (scripts/build.sh)" >&2; exit 1; }
		DYLD_INSERT_LIBRARIES="$LIB" exec "$@" ;;
	*)
		LIB="$ROOT/build/host/libsdl-pspexp.so"
		[ -f "$LIB" ] || { echo "$LIB not built (scripts/build.sh)" >&2; exit 1; }
		# Headless host (no X11 / Wayland session, e.g. a Pi over SSH): SDL's dummy
		# drivers; the PSP is the screen and the speaker (the shim paces the audio).
		if [ -z "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]; then
			export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-dummy}" SDL_AUDIODRIVER="${SDL_AUDIODRIVER:-dummy}"
		fi
		LD_PRELOAD="$LIB" exec "$@" ;;
esac
