#!/bin/sh
# Chocolate Doom on the PSP through sdl-pspexp, with PSP controls mapped to
# Doom's keys:  nub / d-pad = move and turn, cross = fire, circle = use,
# square = run, L / R = strafe, triangle = enter, start = escape (menu),
# select = map. Sound plays on the PSP only (PSPEXP_LOCAL_AUDIO=1 for both);
# PSPEXP_WINDOW=hide hides the Mac window.
#
#   scripts/pspexp-doom [--tcp[:host[:port]]] [wad] [chocolate-doom args...]
#
# Default WAD: $DOOMWAD, else ../doom/freedoom-*/freedoom1.wad next to the
# PSPExp checkout (https://freedoom.github.io/), else Debian's freedoom
# package (/usr/share/games/doom/freedoom1.wad).
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TARGET=""
case "$1" in --tcp*|--null|--usb) TARGET="$1"; shift ;; esac
WAD="${DOOMWAD:-}"
case "$1" in *.wad|*.WAD) WAD="$1"; shift ;; esac
[ -n "$WAD" ] || WAD="$(ls "$ROOT"/../doom/freedoom-*/freedoom1.wad 2>/dev/null | head -1)"
[ -n "$WAD" ] || for f in /usr/share/games/doom/freedoom1.wad /usr/local/share/games/doom/freedoom1.wad "$(brew --prefix 2>/dev/null)/share/games/doom/freedoom1.wad"; do
	[ -f "$f" ] && { WAD="$f"; break; }
done   # Debian's freedoom package, Homebrew
[ -f "$WAD" ] || { echo "no WAD: pass one, set DOOMWAD, or unzip Freedoom into ../doom/" >&2; exit 1; }
command -v chocolate-doom >/dev/null || { echo "chocolate-doom not found (brew install chocolate-doom)" >&2; exit 1; }
export PSPEXP_KEYS="${PSPEXP_KEYS:-cross=lctrl,circle=space,square=lshift,triangle=return,l=comma,r=period,start=escape,select=tab,up=up,down=down,left=left,right=right}"
export PSPEXP_NUB="${PSPEXP_NUB:-keys}"
export PSPEXP_LOCAL_AUDIO="${PSPEXP_LOCAL_AUDIO:-0}"   # sound on the PSP only; =1 to hear it here too
exec "$ROOT/scripts/pspexp-exec" "$ROOT/scripts/pspexp-run" $TARGET chocolate-doom -iwad "$WAD" -window -nomouse -nograbmouse "$@"
