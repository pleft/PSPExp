#!/bin/sh
# pspexp-pkg-apt: the only part of PSPExp's packages that runs as root, through
# one sudoers rule (pspexp-apt-setup). Its whole contract is
# docs/Package_Manager.md §5.2; it takes recipe ids, never package names.
#
#   pspexp-pkg-apt update        the catalogue (signature and serial checked, §5.1), then apt's lists
#   pspexp-pkg-apt prepare ID V  the recipe's meta-package at version V, written before apt begins
#   pspexp-pkg-apt resume ID V   install from it (exit 3 when there is none: apt had not begun)
#   pspexp-pkg-apt install ID    both; the recipe's meta-package pspexp-recipe-ID, built here from the
#                                trusted recipe, installed (or upgraded) with apt; dependencies an
#                                older version had and nothing needs any more are removed (§5.4, §5.6)
#   pspexp-pkg-apt accept ID     the user accepted the terms the recipe names (terms=): recorded in
#                                /var/lib/pspexp/terms/ID, which that game's installer requires
#   pspexp-pkg-apt remove ID     the meta-package, then only its own dependencies apt reports unneeded
#   pspexp-pkg-apt upgrade       newer versions of what the installed recipes depend on, and pspexp-*
#   pspexp-pkg-apt repair        dpkg --configure -a, apt-get -f install
#   pspexp-pkg-apt ssh status    "on|off default|own": the SSH server, and whether the user's password
#                                is still a card image's published one (Settings > SSH on the PSP)
#   pspexp-pkg-apt ssh on        the SSH server started and kept on (the password is the user's
#                                choice: Settings warns while it is still the published one)
#   pspexp-pkg-apt ssh off       the SSH server stopped and kept off
#   (ssh: for sudo's user, the console's; here because this helper's sudo rule is on every board)
set -e
export PATH=/usr/sbin:/usr/bin:/sbin:/bin DEBIAN_FRONTEND=noninteractive LC_ALL=C
CAT=/usr/share/pspexp/catalogue
KEYRING=/usr/share/keyrings/pspexp-archive-keyring.gpg
META=/var/lib/pspexp/meta
REPO=$(cat /etc/pspexp/repo 2>/dev/null || true)
BOARD=$(cat /etc/pspexp/board 2>/dev/null || true)
APT="apt-get -y -q -o DPkg::Lock::Timeout=120 -o APT::Status-Fd=1"
die() { echo "pspexp-pkg-apt: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "runs as root (sudo)"

# the value of KEY in [SECTION] of recipe R, [SECTION:<board>] first (as pspexp-pkg reads it)
rget() {
	awk -v sec="$2" -v key="$3" -v board="$BOARD" '
	/^[ \t]*#/ || /^[ \t]*$/ { next }
	/^\[.*\][ \t]*$/ { s = $0; sub(/^\[/, "", s); sub(/\][ \t]*$/, "", s); next }
	{ i = index($0, "="); if (!i) next; k = substr($0, 1, i - 1); v = substr($0, i + 1)
	  gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v)
	  if (k != key) next
	  if (s == sec) base = v; else if (s == sec ":" board) { over = v; have = 1 } }
	END { if (have) print over; else print base }' "$1"
}

recipe() {   # a recipe id -> its trusted recipe file
	case "$1" in ""|*[!a-z0-9-]*) die "'$1' is not a recipe id" ;; esac
	[ -f "$CAT/recipes/$1/recipe" ] || die "no recipe $1 in the catalogue"
	echo "$CAT/recipes/$1/recipe"
}

pkg_names() { tr ', ' '\n\n' | sed 's/[ (].*//; s/|.*//' | grep -v '^$' | sort -u; }
deps_of() { dpkg-query -W -f='${Depends}' "$1" 2>/dev/null | pkg_names; }
installed() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"; }

# remove what apt reports unneeded, but only among CANDIDATES and, as those go,
# what they themselves depended on (never a general autoremove, §5.4)
prune() {
	cand=$(echo "$1" | tr ' ' '\n' | grep -v '^$' | sort -u)
	n=0
	while [ -n "$cand" ] && [ $n -lt 8 ]; do
		n=$((n + 1))
		unneeded=$(apt-get -s -q autoremove 2>/dev/null | sed -n 's/^Remv \([^ ]*\).*/\1/p' | sort -u)
		drop=""
		for p in $cand; do printf '%s\n' "$unneeded" | grep -qx "$p" && drop="$drop $p"; done
		[ -n "$drop" ] || break
		more=""
		for p in $drop; do more="$more $(deps_of "$p" | tr '\n' ' ')"; done
		echo "removing, no longer needed: $(echo $drop)"
		$APT remove $drop >/dev/null
		cand=$(echo "$more" | tr ' ' '\n' | grep -v '^$' | sort -u)
	done
}

# apt's package lists: a fresh card (the image ships none) or a cleaned cache has
# none, and apt then finds nothing to install; fetched once, when missing
lists() {
	ls /var/lib/apt/lists/*_Packages* >/dev/null 2>&1 && return 0
	echo "reading apt's package lists (the first time)"
	apt-get -q -o DPkg::Lock::Timeout=120 update >/dev/null 2>&1 || die "apt could not read its lists (no network?)"
}

# prepare_meta ID VERSION: the recipe's meta-package, pspexp-recipe-ID, built
# from the catalogue's recipe (refused unless it is at VERSION, the one the
# operation staged) and written whole (a rename) into $META before apt
# begins: the operation's own record of what it installs. resume_meta reads
# it, so finishing an operation cut short never depends on the catalogue,
# which may have changed meanwhile (docs/Package_Manager.md §5.3)
prepare_meta() {
	id="$1"; R=$(recipe "$id")
	pk=$(rget "$R" debian apt); [ -n "$pk" ] || die "$id has nothing for this board"
	v=$(rget "$R" package version); case "$v" in ""|*[!0-9]*) die "$id: bad version" ;; esac
	[ "$v" = "$2" ] || die "$id: the catalogue has version $v, not $2"
	mkdir -p "$META"; w=$(mktemp -d); trap 'rm -rf "$w"' EXIT
	mkdir -p "$w/p/DEBIAN" "$w/p/usr/share/doc/pspexp-recipe-$id"
	echo "The PSPExp recipe $id (docs/Package_Manager.md §5.4): it holds the recipe's packages." > "$w/p/usr/share/doc/pspexp-recipe-$id/README"
	cat > "$w/p/DEBIAN/control" <<C
Package: pspexp-recipe-$id
Version: $v
Architecture: all
Maintainer: PSPExp <info@pspexp.dev>
Section: metapackages
Priority: optional
Depends: $(echo $pk | sed 's/ /, /g')
Description: PSPExp recipe $id
 Installed by PSPExp's Packages: it depends on what the recipe $id needs,
 so apt keeps those while the recipe is installed.
C
	dpkg-deb --root-owner-group -b "$w/p" "$w/m.deb" >/dev/null && mv "$w/m.deb" "$META/pspexp-recipe-${id}_${v}_all.deb"
	echo "prepared pspexp-recipe-$id $v"
}

# resume_meta ID VERSION: install what the prepared meta-package names (exit 3
# when there is none: nothing was prepared, so apt had not begun)
resume_meta() {
	id="$1"; v="$2"
	case "$id" in ""|*[!a-z0-9-]*) die "'$id' is not a recipe id" ;; esac
	case "$v" in ""|*[!0-9]*) die "bad version" ;; esac
	deb="$META/pspexp-recipe-${id}_${v}_all.deb"
	pk=$(dpkg-deb -f "$deb" Depends 2>/dev/null | tr -d ',') || pk=""
	[ -n "$pk" ] || { echo "pspexp-pkg-apt: no meta-package for $id $v: apt had not begun" >&2; exit 3; }
	# an older version's dependencies, pruned after (§5.6); when an earlier try
	# already installed this version, none
	olddeps=""
	[ "$(dpkg-query -W -f='${Version}' "pspexp-recipe-$id" 2>/dev/null)" != "$v" ] && installed "pspexp-recipe-$id" && olddeps=$(deps_of "pspexp-recipe-$id" | tr '\n' ' ')
	lists
	install_meta "$id" "$pk" "$deb"
	[ -n "$olddeps" ] && prune "$olddeps"
	echo "installed pspexp-recipe-$id $v"
}

# install_meta ID "PACKAGES" DEB: the recipe's packages one at a time, in the
# order it lists them: a Debian package that asks for "A or B" (freedoom:
# dsda-doom | doom-engine; a core: retroarch | libretro-frontend) then finds
# the one the recipe listed before it (chocolate-doom, pspexp-retro) already
# installed, instead of apt adding its first choice; then the meta-package
install_meta() {
	for p in $2; do
		installed "$p" && continue
		$APT --no-install-recommends install "$p"
		apt-mark auto "$p" >/dev/null   # held by the meta-package below, like the rest
	done
	$APT --no-install-recommends install "$3"
	apt-mark manual "pspexp-recipe-$1" >/dev/null
}

cmd="$1"; [ $# -gt 0 ] && shift
case "$cmd" in
update)
	[ -n "$REPO" ] || die "no repository (/etc/pspexp/repo)"
	t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
	get() { curl -fsSL -o "$2" "$1" 2>/dev/null || wget -q -O "$2" "$1"; }
	get "$REPO/catalogue.tar.gz" "$t/c.tgz" || die "cannot fetch the catalogue"
	get "$REPO/catalogue.tar.gz.sig" "$t/c.sig" || die "cannot fetch its signature"
	gpgv --keyring "$KEYRING" "$t/c.sig" "$t/c.tgz" 2>/dev/null || die "the catalogue's signature does not check: refused"
	mkdir -p "$t/x" && tar -C "$t/x" -xzf "$t/c.tgz" && [ -d "$t/x/recipes" ] && [ -f "$t/x/serial" ] || die "the catalogue is not readable"
	new=$(tr -dc 0-9 < "$t/x/serial"); old=$( [ -f "$CAT/serial" ] && tr -dc 0-9 < "$CAT/serial" || echo 0)
	[ -n "$new" ] && [ "$new" -ge "${old:-0}" ] || die "the catalogue ($new) is older than the one installed ($old): refused"
	rm -rf "$CAT.new" && mkdir -p "$CAT.new" && mv "$t/x/recipes" "$CAT.new/recipes" && cp "$t/x/serial" "$CAT.new/serial"
	chown -R root:root "$CAT.new" && chmod -R u=rwX,go=rX "$CAT.new"
	rm -rf "$CAT.old"; [ -d "$CAT" ] && mv "$CAT" "$CAT.old"; mv "$CAT.new" "$CAT"; rm -rf "$CAT.old"
	echo "catalogue $new: $(ls "$CAT/recipes" | wc -l) recipes"
	# the repository moved: the signed catalogue names its address (repo); this board's apt source and
	# catalogue follow it (a home server first, the public one since; the key is the same)
	if [ -f "$t/x/repo" ]; then
		nr=$(head -1 "$t/x/repo" | tr -d '\r')
		if echo "$nr" | grep -Eq '^https?://[A-Za-z0-9.:/_-]+$' && [ "$nr" != "$REPO" ]; then
			echo "$nr" > /etc/pspexp/repo
			[ -f /etc/apt/sources.list.d/pspexp.sources ] && sed -i "s#^URIs: .*#URIs: $nr#" /etc/apt/sources.list.d/pspexp.sources
			echo "the repository moved: $nr"
		fi
	fi
	apt-get -q -o DPkg::Lock::Timeout=120 update >/dev/null 2>&1 || die "apt could not read its lists"
	echo "apt lists updated" ;;
accept)   # the user accepted the recipe's terms (Packages asked on the PSP): recorded for its installer
	r=$(recipe "$1"); t=$(rget "$r" package terms)
	[ -n "$t" ] || die "$1 has no terms to accept"
	mkdir -p /var/lib/pspexp/terms
	printf 'accepted %s: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$t" > "/var/lib/pspexp/terms/$1"
	echo "terms of $1 accepted" ;;
prepare)   # the meta-package for recipe ID at VERSION, before anything is installed
	prepare_meta "$1" "$2" ;;
resume)   # install from the meta-package prepare wrote (pspexp-pkg's apt step, and recover's), never the catalogue
	resume_meta "$1" "$2" ;;
install)   # both at once (by hand)
	id="$1"; v=$(rget "$(recipe "$id")" package version)
	prepare_meta "$id" "$v" && resume_meta "$id" "$v" ;;
remove)
	id="$1"; case "$id" in ""|*[!a-z0-9-]*) die "'$id' is not a recipe id" ;; esac
	if installed "pspexp-recipe-$id"; then
		d=$(deps_of "pspexp-recipe-$id" | tr '\n' ' ')
		$APT remove "pspexp-recipe-$id"
		prune "$d"
	fi
	rm -f "$META/pspexp-recipe-${id}_"*.deb "/var/lib/pspexp/terms/$id"   # (a new install asks again)
	echo "removed pspexp-recipe-$id" ;;
upgrade)
	lists
	list=$( { for m in $(dpkg-query -W -f='${Package} ${Status}\n' 'pspexp-recipe-*' 2>/dev/null | awk '/install ok installed/ {print $1}'); do deps_of "$m"; done
	          dpkg-query -W -f='${Package} ${Status}\n' 'pspexp-*' 2>/dev/null | awk '/install ok installed/ && $1 !~ /^pspexp-recipe-/ {print $1}'; } | sort -u | tr '\n' ' ')
	[ -n "$list" ] || { echo "nothing to upgrade"; exit 0; }
	$APT --no-install-recommends --only-upgrade install $list ;;
repair)
	dpkg --configure -a
	$APT -f install ;;
ssh)
	u=${SUDO_USER:-}
	[ -n "$u" ] && [ "$u" != root ] || die "ssh: through sudo, as the console's user"
	systemctl cat ssh.service >/dev/null 2>&1 || die "ssh: no SSH server on this board"
	# the password the card images publish (pi: pspexp, cpi: cpi; Raspberry Pi's old one):
	# compared through the system's crypt, the password file never leaves root
	default_pw() {
		h=$(getent shadow "$u" | cut -d: -f2)
		for p in pspexp cpi raspberry; do
			[ -n "$h" ] && PW="$p" H="$h" perl -e 'exit(crypt($ENV{PW}, $ENV{H}) eq $ENV{H} ? 0 : 1)' && return 0
		done
		return 1
	}
	case "$1" in
	status)
		if systemctl -q is-active ssh.service; then st=on; else st=off; fi
		if default_pw; then echo "$st default"; else echo "$st own"; fi ;;
	# started or stopped at once; kept so across restarts in the background: enable/disable also
	# rewrites the init script's links (systemd-sysv-install), 9 s on the GameShell (enable --now
	# took 20 s with its reloads). The latest wish is written first and applied under a lock,
	# so quick presses end as the last one asked
	on|off)
		echo "$1" > /run/pspexp-ssh.want
		# Debian's ssh.service stops only its main process (open sessions live on, as sshd-session);
		# a listener left behind kept port 22 and every later start failed ("Address already in
		# use", and the orphan, its /run/sshd gone, reset every login): off ends any sshd left
		if [ "$1" = on ]; then systemctl reset-failed ssh.service 2>/dev/null || true; systemctl start ssh.service
		else systemctl stop ssh.service; systemctl stop ssh.socket 2>/dev/null || true; pkill -x sshd || true; fi
		( exec 9>/run/pspexp-ssh.lock; flock 9
		  if [ "$(cat /run/pspexp-ssh.want 2>/dev/null)" = on ]; then systemctl enable --no-reload ssh.service
		  else systemctl disable --no-reload ssh.service; fi ) >/dev/null 2>&1 </dev/null &
		echo "ssh $1" ;;
	*) die "ssh: status | on | off" ;;
	esac ;;
*) echo "usage: pspexp-pkg-apt update | prepare ID VERSION | resume ID VERSION | install ID | remove ID | upgrade | repair | ssh status|on|off" >&2; exit 2 ;;
esac
