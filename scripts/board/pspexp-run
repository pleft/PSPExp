#!/bin/sh
# On a glibc board (GameShell, Raspberry Pi; installed as pspexp-run): run an
# unmodified SDL2 program with the PSP as its display,
# speaker and controller. libsdl-pspexp.so is preloaded into the program and
# pspexp-term hands the PSP over for the program's lifetime (pspexp-exec:
# SIGUSR1 to release, SIGUSR2 to take it back, however the program ends).
#   pspexp-run <program> [args...]
# Environment passed through: PSPEXP_KEYS, PSPEXP_NUB, PSPEXP_WINDOW,
# PSPEXP_LOCAL_AUDIO (see compatibility/sdl-pspexp/README.md). Defaults here:
# sound on the PSP only (the console's audio FIFO is not the game's), the
# headless SDL (dummy video and audio drivers): the X path costs chocolate-doom
# 20 fps (35 headless) and there is no LCD to show it on. PSPEXP_X=1 keeps X
# (hidden window) for programs that need it. PSPEXP_HOSTGL=1: the board's own GPU
# draws (OpenGL 3 games the PSP's layer cannot: SuperTuxKart on the Pi's V3D):
# libsdl-pspexp-hostgl.so instead, SDL's offscreen video driver (OpenGL through
# EGL, no display), each finished frame read back and sent as a picture.
# the SDL layer: an installer's copy (/usr/local) or the pspexp-core package's (/usr/lib/pspexp)
LIB=${PSPEXP_SHIM:-}
SHIM=libsdl-pspexp.so
[ "${PSPEXP_HOSTGL:-0}" = 1 ] && { SHIM=libsdl-pspexp-hostgl.so; export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-offscreen}"; }
[ -n "$LIB" ] || for LIB in /usr/local/lib/$SHIM /usr/lib/pspexp/$SHIM; do [ -f "$LIB" ] && break; done
[ -f "$LIB" ] || { echo "pspexp-run: $LIB missing" >&2; exit 1; }
[ $# -ge 1 ] || { echo "usage: pspexp-run <program> [args...]" >&2; exit 2; }
export PSPEXP="${PSPEXP:-usb}"
export PSPEXP_LOCAL_AUDIO="${PSPEXP_LOCAL_AUDIO:-0}"
export PSPEXP_WINDOW="${PSPEXP_WINDOW:-hide}"
if [ "${PSPEXP_X:-0}" = 1 ]; then
	export DISPLAY="${DISPLAY:-:0}"
else
	export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-dummy}" SDL_AUDIODRIVER="${SDL_AUDIODRIVER:-dummy}"
	# games that play through OpenAL (SuperTux): OpenAL Soft's "wave" output
	# into a pipe the SDL layer streams to the PSP (Debian's OpenAL has no SDL
	# output); nothing for the others
	if [ -z "$ALSOFT_CONF" ]; then
		T="${XDG_RUNTIME_DIR:-/tmp}/pspexp-openal-$$"
		printf '[general]\ndrivers=wave\nfrequency=44100\nchannels=stereo\nsample-type=int16\n[wave]\nfile=%s.fifo\n' "$T" > "$T.conf" &&
			export ALSOFT_CONF="$T.conf" ALSOFT_DRIVERS=wave PSPEXP_AUDIO_FIFO="$T.fifo"
		# the pipe made now, before the program: one that opens OpenAL before its window (Vanilla
		# Conquer's Red Alert) made a plain file of the name, never read (no sound)
		rm -f "$T.fifo"; mkfifo -m 600 "$T.fifo" 2>/dev/null || true
	fi
fi
# a setuid or setgid program (Debian's games that keep a shared high-score file:
# LTris, LBreakoutHD) runs in secure mode, where the loader ignores LD_PRELOAD:
# start it through the loader itself, as the user (no extra group: a shared
# score file may not be writable), and the SDL layer loads as for any other
PROG=$(command -v "$1" 2>/dev/null || echo "$1")
if [ -u "$PROG" ] || [ -g "$PROG" ]; then
	for LD in /lib/ld-linux-aarch64.so.1 /lib/ld-linux-armhf.so.3 /lib64/ld-linux-x86-64.so.2 /lib/ld-linux.so.3; do
		[ -x "$LD" ] && { shift; set -- "$LD" "$PROG" "$@"; break; }
	done
fi
# preload into the program only: the shim's SDL symbols resolve from the
# program's libSDL2, so a shell or env loading it would fail
EXEC=$(command -v pspexp-exec || echo /usr/local/bin/pspexp-exec)
exec "$EXEC" env LD_PRELOAD="$LIB${LD_PRELOAD:+:$LD_PRELOAD}" "$@"
