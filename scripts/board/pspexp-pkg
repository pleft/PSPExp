#!/bin/sh
# PSPExp packages on a board (installed on every board as pspexp-pkg): the
# titles the launcher shows. Two kinds (docs/Package_Manager.md):
#
#   recipes   (Debian boards) a recipe of the signed catalogue names what apt
#             installs, through a per-recipe meta-package, and says how the
#             title shows and plays on the PSP; this writes the launcher's files
#   archives  FILE.tar.gz holding one <id>/ folder, built on the Mac by
#             scripts/packages/pspexp-pkg-build: the Omega2+'s static builds, which
#             it installs through the same recipes (their [omega] build=, §9), and
#             older installs on the Debian boards (removable; a recipe replaces them)
#
#   pspexp-pkg install ID|FILE.tar.gz...   install or update
#   pspexp-pkg remove ID...                its launcher files, then what apt no longer needs
#   pspexp-pkg upgrade                     changed recipes, then newer versions of their packages
#   pspexp-pkg list                        installed
#   pspexp-pkg available                   the catalogue: id|recipe version|state|category|title|description
#                                          (first, on the Debian boards: pspexp, PSPExp itself; its install is the upgrade)
#   pspexp-pkg update                      the catalogue and apt's lists
#   pspexp-pkg check                       update, then "updates=N new=M": installed recipes that
#                                          changed, and recipes new since the last check (the
#                                          console runs it at start and daily, and says so)
#   pspexp-pkg recover                     finish or clean up an interrupted operation (the console
#                                          runs it at every start)
#
# One operation at a time (a lock); each recipe operation keeps a journal of
# checkpoints under <root>/state (§5.3), so an interruption anywhere is
# finished or cleaned up by recover. apt runs only through pspexp-pkg-apt
# (root, one sudoers rule, §5.2). Runs as the console's user.
# PSPEXP_ROOT: /opt/pspexp (GameShell, Pi), /mnt/mmcblk0p1/pspexp/opt (Omega2+).
# PSPEXP_BOARD: the board kind, else /etc/pspexp/board. On the Omega the catalogue and
# its builds are what the Mac last published over SSH: <root>/catalogue, <root>/repo.
# Tests: PSPEXP_PKG_CRASH=<point> stops the operation dead at that point (see crash()).
ROOT="${PSPEXP_ROOT:-/opt/pspexp}"
APPS="$ROOT/apps"
SYS="$ROOT/systems"
STATE="$ROOT/state"
BOARD=${PSPEXP_BOARD:-$(cat /etc/pspexp/board 2>/dev/null || echo "")}
case "$BOARD" in omega) FAMILY=omega; CATDIR="$ROOT/catalogue" ;; *) FAMILY=debian; CATDIR=/usr/share/pspexp/catalogue ;; esac
CAT="${PSPEXP_CATALOGUE:-$CATDIR}/recipes"
REPO="$ROOT/repo"
# the root helper: the pspexp-core package's (/usr/sbin) or an installer's (/usr/local/sbin)
if [ -z "${PSPEXP_PKG_APT:-}" ]; then
	for h in /usr/sbin/pspexp-pkg-apt /usr/local/sbin/pspexp-pkg-apt; do [ -x "$h" ] && break; done
	PSPEXP_PKG_APT="sudo -n $h"
fi
APT_HELPER="$PSPEXP_PKG_APT"
die() { echo "pspexp-pkg: $*" >&2; exit 1; }
field() { sed -n "s/^$2=//p" "$1/package" 2>/dev/null | head -1; }
[ -d "$APPS" ] && [ -w "$APPS" ] || die "$APPS missing or not writable"
mkdir -p "$SYS" "$STATE"

# ---- the lock: one operation at a time ------------------------------------------------
lock() {
	exec 9>"$STATE/lock"
	if command -v flock >/dev/null 2>&1; then   # -n and a retry: BusyBox's flock (the Omega) has no -w
		_w=0
		until flock -n 9; do
			_w=$((_w + 1)); [ $_w -le "${PSPEXP_PKG_WAIT:-600}" ] || die "busy: another package operation is running"
			sleep 1
		done
	fi
}

# ---- archives (the Omega2+, and packages installed before recipes) ---------------------

# never the archive's owners (root on a FAT SD card, the Omega, cannot set them)
untar() {
	if tar --help 2>&1 | grep -q no-same-owner; then tar --no-same-owner -C "$2" -xzf "$1"
	else tar -C "$2" -xzf "$1"; fi
}

install_one() {
	f="$1"
	[ -f "$f" ] || die "$f: no such file"
	tmp=$(mktemp -d "$ROOT/.install.XXXXXX") || die "no temp dir"
	if ! untar "$f" "$tmp"; then rm -rf "$tmp"; die "$f: not a package"; fi
	set -- "$tmp"/*
	if [ $# != 1 ] || [ ! -d "$1" ] || [ ! -f "$1/package" ]; then rm -rf "$tmp"; die "$f: expected one <id>/ directory with a package file"; fi
	dir="$1"; id=$(basename "$dir")
	for c in $(field "$dir" requires); do
		command -v "$c" >/dev/null 2>&1 || { rm -rf "$tmp"; die "$id needs '$c', which is not installed"; }
	done
	# the old version's systems go first (a new version may drop some)
	[ -d "$APPS/$id/systems" ] && for s in "$APPS/$id"/systems/*.system; do [ -f "$s" ] && rm -f "$SYS/$(basename "$s")"; done
	[ -d "$dir/systems" ] && for s in "$dir"/systems/*.system; do [ -f "$s" ] && cp "$s" "$SYS/"; done
	rm -rf "$APPS/.$id.old"
	[ -d "$APPS/$id" ] && mv "$APPS/$id" "$APPS/.$id.old"
	mv "$dir" "$APPS/$id"
	rm -rf "$APPS/.$id.old" "$tmp"
	echo "installed $id $(field "$APPS/$id" version)"
}

remove_one() {
	id="$1"
	case "$id" in ""|*/*|.*) die "bad id '$id'" ;; esac
	[ -d "$APPS/$id" ] || die "$id is not installed"
	[ -d "$APPS/$id/systems" ] && for s in "$APPS/$id"/systems/*.system; do [ -f "$s" ] && rm -f "$SYS/$(basename "$s")"; done
	rm -rf "$APPS/$id"
	echo "removed $id"
}

# ---- recipes: reading them ---------------------------------------------------------------

# rget FILE SECTION KEY: the value ([SECTION:<board>] over [SECTION]); rall: every value
rget() {
	awk -v sec="$2" -v key="$3" -v board="$BOARD" '
	/^[ \t]*#/ || /^[ \t]*$/ { next }
	/^\[.*\][ \t]*$/ { s = $0; sub(/^\[/, "", s); sub(/\][ \t]*$/, "", s); next }
	{ i = index($0, "="); if (!i) next; k = substr($0, 1, i - 1); v = substr($0, i + 1)
	  gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v)
	  if (k != key) next
	  if (s == sec) base = v; else if (s == sec ":" board) { over = v; have = 1 } }
	END { if (have) print over; else print base }' "$1"
}
rall() {
	awk -v sec="$2" -v key="$3" '
	/^\[.*\][ \t]*$/ { s = $0; sub(/^\[/, "", s); sub(/\][ \t]*$/, "", s); next }
	{ i = index($0, "="); if (!i) next; k = substr($0, 1, i - 1); gsub(/^[ \t]+|[ \t]+$/, "", k)
	  if (s == sec && k == key) { v = substr($0, i + 1); gsub(/^[ \t]+|[ \t]+$/, "", v); print v } }' "$1"
}

serial() { tr -dc 0-9 < "${CAT%/recipes}/serial" 2>/dev/null; }
# the recipe's sections of a kind, in order: [entry], [entry.phase2], ... (not the [x:board] overrides)
sections() { sed -n "s/^\[\($2\(\.[a-z0-9-]*\)\{0,1\}\)\][ \t]*\$/\1/p" "$1" | awk '!seen[$0]++'; }
meta_version() { [ "$FAMILY" = debian ] || return 0; dpkg-query -W -f='${Status} ${Version}' "pspexp-recipe-$1" 2>/dev/null | awk '/install ok installed/ {print $NF}'; }

# the Debian folder of libretro cores (Debian's cores install there)
libretro_dir() {
	case "$(dpkg --print-architecture 2>/dev/null)" in
	arm64) echo /usr/lib/aarch64-linux-gnu/libretro ;; armhf) echo /usr/lib/arm-linux-gnueabihf/libretro ;;
	amd64) echo /usr/lib/x86_64-linux-gnu/libretro ;; *) echo /usr/lib/libretro ;;
	esac
}

# ---- the journal (§5.3) ------------------------------------------------------------------
# <root>/state/txn: op, id, recipe version, catalogue serial, checkpoint; rewritten
# through a temporary file and a rename. Staging: <root>/state/stage/<id>/.

J="$STATE/txn"
jset() {   # jset CHECKPOINT: record it (the other fields from the current operation)
	cat > "$J.tmp" <<T
op=$OP
id=$ID
recipe_version=$RV
catalogue_serial=$SERIAL
checkpoint=$1
T
	mv "$J.tmp" "$J"
}
jget() { sed -n "s/^$1=//p" "$J" 2>/dev/null | head -1; }

# PSPEXP_PKG_CRASH=<point> (tests): stop dead there, as a power cut would
crash() { [ "${PSPEXP_PKG_CRASH:-}" = "$1" ] && { echo "pspexp-pkg: crash test at $1" >&2; kill -9 $$; }; return 0; }

# the manifest of a staging folder: every file's checksum
manifest() { (cd "$1" && find . -type f ! -name MANIFEST | sort | xargs sha256sum 2>/dev/null) ; }
# staged_ok: what the operation staged, as its manifest recorded it, wherever it is now: the app
# folder still in $STAGE, or already swapped into $APPS/$ID (nothing changes it there before finish)
staged_ok() {
	[ -f "$STAGE/MANIFEST" ] || return 1
	_now=$( { (cd "$STAGE" && find . -type f ! -name MANIFEST ! -path './app/*' | sort | xargs -r sha256sum)
		if [ -d "$STAGE/app" ]; then (cd "$STAGE" && find ./app -type f | sort | xargs -r sha256sum)
		elif [ -d "$APPS/$ID" ]; then (cd "$APPS/$ID" && find . -type f | sort | xargs -r sha256sum) | sed 's|  \./|  ./app/|'
		fi; } | sort -k2)
	[ "$_now" = "$(sort -k2 "$STAGE/MANIFEST")" ]
}

# ---- recipes: staging ---------------------------------------------------------------------

# stage ID: build everything the install will publish, under $STAGE
stage() {
	R="$CAT/$ID/recipe"
	rm -rf "$STAGE"; mkdir -p "$STAGE/app" "$STAGE/systems"
	A="$STAGE/app"
	cat > "$A/package" <<P
version=r$RV
title=$(rget "$R" package title)
description=$(rget "$R" package description)
license=$(rget "$R" package license)
recipe=$ID
catalogue=$SERIAL
requires=pspexp-run
P
	cat=$(rget "$R" package category)
	if [ "$cat" = system ]; then
		mkdir -p "$A/systems"
		for sec in $(sections "$R" system); do
			sid=$(rget "$R" "$sec" id); sid=${sid:-$ID}
			# a system file of another package's name is an error of the recipe (§5.5)
			if [ -f "$SYS/$sid.system" ]; then
				own=$(sed -n 's/^pkg=//p' "$SYS/$sid.system" | head -1)
				[ "$own" = "$ID" ] || die "$ID: the system $sid belongs to $own"
			fi
			core=$(rget "$R" "$sec" core); [ -n "$core" ] || core=$(rget "$R" "$FAMILY" core)
			# a system with a program of its own (exec=, %ROM% in it) instead of a libretro core
			# for pspexp-retro: Mupen64Plus; its video driver is left to pspexp-run (PSPEXP_HOSTGL)
			sexec=$(rget "$R" "$sec" exec)
			keys=$(rget "$R" "$sec" keys); nub=$(rget "$R" "$sec" nub)
			{ echo "name=$(rget "$R" "$sec" name)"
			  echo "short=$(rget "$R" "$sec" short)"
			  icon=$(rget "$R" "$sec" icon); [ -n "$icon" ] && echo "icon=$icon"
			  echo "roms=$(rget "$R" "$sec" roms)"
			  echo "ext=$(rget "$R" "$sec" ext)"
			  if [ -n "$sexec" ]; then echo "exec=pspexp-run $sexec"
			  else echo "exec=pspexp-run pspexp-retro $(libretro_dir)/$core %ROM%"; fi
			  echo "pkg=$ID"
			  [ -n "$sexec" ] || echo "env=SDL_VIDEODRIVER=dummy"; echo "env=SDL_AUDIODRIVER=dummy"
			  [ -n "$keys" ] && echo "env=PSPEXP_KEYS=$keys"
			  [ -n "$nub" ] && echo "env=PSPEXP_NUB=$nub"
			  rall "$R" "$sec" env | sed 's/^/env=/'
			  th=$(rget "$R" "$sec" thumbs); [ -n "$th" ] && echo "thumbs=$th"
			  g=$(rget "$R" "$sec" graphics); [ -n "$g" ] && echo "graphics=$g"
			  echo "pspexp=1"; } > "$A/systems/$sid.system"
			cp "$A/systems/$sid.system" "$STAGE/systems/"
		done
	else
		for sec in $(sections "$R" entry); do
			eid=$(rget "$R" "$sec" id); eid=${eid:-$ID}
			keys=$(rget "$R" "$sec" keys); nub=$(rget "$R" "$sec" nub)
			exec=$(rget "$R" "$sec" exec)
			[ "$(rget "$R" "$sec" native)" = 1 ] || exec="pspexp-run $exec"
			first=$(rall "$R" "$sec" first-run)
			if [ -n "$first" ]; then   # settings files (one first-run= line each) written once, when missing, then the program
				{ echo '#!/bin/sh'; echo "# written by pspexp-pkg from the recipe $ID: first-run settings, then the program"
				  printf '%s\n' "$first" | while IFS= read -r one; do
					[ -n "$one" ] || continue
					f=${one%%:*}; body=${one#*:}
					echo "[ -f \"\$HOME/$f\" ] || { mkdir -p \"\$(dirname \"\$HOME/$f\")\"; printf '%b' '$body' > \"\$HOME/$f\"; }"
				  done
				  echo "exec $exec \"\$@\""; } > "$A/run-$eid.sh"
				chmod 755 "$A/run-$eid.sh"
				exec=./run-$eid.sh
			fi
			{ echo "title=$(rget "$R" "$sec" title)"
			  echo "type=$(rget "$R" "$sec" type)"
			  echo "description=$(rget "$R" "$sec" description)"
			  icon=$(rget "$R" "$sec" icon); [ -n "$icon" ] && echo "icon=$icon"
			  echo "exec=$exec"
			  [ -n "$keys" ] && echo "env=PSPEXP_KEYS=$keys"
			  [ -n "$nub" ] && echo "env=PSPEXP_NUB=$nub"
			  rall "$R" "$sec" env | sed 's/^/env=/'
			  g=$(rget "$R" "$sec" graphics); [ -n "$g" ] && echo "graphics=$g"
			  art=$(rget "$R" "$sec" art); [ -n "$art" ] && echo "art=$art"
			  echo "pspexp=1"; } > "$A/$eid.entry"
			cov=$(rget "$R" "$sec" cover); cov=${cov:-cover.png}
			[ -f "$CAT/$ID/$cov" ] && cp "$CAT/$ID/$cov" "$A/$eid.png"
		done
	fi
	# the published system files this package owns that the new version drops
	: > "$STAGE/unpublish"
	for s in "$SYS"/*.system; do
		[ -f "$s" ] || continue
		[ "$(sed -n 's/^pkg=//p' "$s" | head -1)" = "$ID" ] || continue
		[ -f "$STAGE/systems/$(basename "$s")" ] || basename "$s" >> "$STAGE/unpublish"
	done
	manifest "$STAGE" > "$STAGE/MANIFEST"
}

# ---- recipes: publishing (§5.3, §5.5) ---------------------------------------------------

# publish: the staged app folder and systems, checkpoint by checkpoint; every step can be redone
publish() {
	: > "$STATE/publishing"
	jset app-swap-started; crash app-swap-started
	if [ -d "$STAGE/app" ]; then   # not yet swapped in
		if [ -d "$APPS/$ID" ]; then   # (after an interruption between the renames, the old one is already aside)
			rm -rf "$APPS/.$ID.old"
			mv "$APPS/$ID" "$APPS/.$ID.old"
		fi
		crash app-swap-half
		mv "$STAGE/app" "$APPS/$ID"
	fi
	crash app-swap-unrecorded
	jset app-swapped; crash app-swapped
	publish_systems
	finish
}

publish_systems() {
	jset systems-started; crash systems-started
	for s in "$STAGE"/systems/*.system; do
		[ -f "$s" ] || continue
		n=$(basename "$s")
		cp "$s" "$SYS/.$n.tmp" && mv "$SYS/.$n.tmp" "$SYS/$n"
		crash system-renamed
	done
	while read -r n; do [ -n "$n" ] && rm -f "$SYS/$n"; done < "$STAGE/unpublish"
	jset systems-published
}

finish() {
	rm -rf "$APPS/.$ID.old" "$STAGE"
	rm -f "$STATE/publishing" "$J"
}

# ---- recipes: the operations ---------------------------------------------------------------

begin() {   # begin OP ID
	OP="$1"; ID="$2"; STAGE="$STATE/stage/$ID"
	case "$ID" in ""|*[!a-z0-9-]*) die "'$ID' is not a recipe id" ;; esac
	ABANDONED=""
	if [ -f "$J" ]; then
		# removing the recipe an interrupted operation was about abandons that operation (§5.3:
		# a broken one recover cannot finish); anything else finishes it first (it had said "run
		# pspexp-pkg recover", a command a PSP user has no way to type)
		if [ "$OP" = remove ] && [ "$(jget id)" = "$ID" ]; then
			echo "abandoning the interrupted $(jget op) of $ID (at $(jget checkpoint))"
			rm -rf "$STAGE"; rm -f "$J" "$STATE/publishing"; ABANDONED=1
		else
			_w="$(jget op) of $(jget id)"
			echo "finishing the interrupted $_w first"
			( recover ) || die "the interrupted $_w could not be finished: is the board online? Try again in a moment"
			[ ! -f "$J" ] || die "the interrupted $_w could not be finished: try again in a moment"
			STAGE="$STATE/stage/$ID"
		fi
	fi
	SERIAL=$(serial); RV=""
}

# the Omega: a recipe names our static build ([omega] build=), an archive the Mac
# published to <root>/repo; installed as any archive, then marked as the recipe's
build_version() { awk -F'|' -v id="$1" '$1 == id { print $2 }' "$REPO/index" 2>/dev/null | head -1; }
install_build() {
	ID="$1"; R="$CAT/$ID/recipe"
	[ -f "$R" ] || die "$ID: not in the catalogue (publish it from the Mac: pspexp-pkg-build publish)"
	b=$(rget "$R" omega build); [ -n "$b" ] || die "$ID: nothing for this board"
	[ -f "$REPO/$b.tar.gz" ] || die "$ID: its build $b is not in $REPO (pspexp-pkg-build publish)"
	install_one "$REPO/$b.tar.gz" >/dev/null
	[ "$b" = "$ID" ] || { rm -rf "$APPS/$ID"; mv "$APPS/$b" "$APPS/$ID"; }
	printf 'recipe=%s\nrecipe_version=%s\ncatalogue=%s\nbuild=%s\n' "$ID" "$(rget "$R" package version)" "$(serial)" "$b" >> "$APPS/$ID/package"
	echo "installed $ID ($b $(field "$APPS/$ID" version))"
}

install_recipe() {
	[ "$FAMILY" = omega ] && { install_build "$1"; return; }
	begin install "$1"
	R="$CAT/$ID/recipe"
	[ -f "$R" ] || die "$ID: not in the catalogue (pspexp-pkg update?)"
	[ "$FAMILY" = debian ] || die "$ID: recipes install through apt, on the Debian boards; this board takes archives"
	[ -n "$(rget "$R" debian apt)" ] || die "$ID: nothing for this board"
	RV=$(rget "$R" package version)
	T=$(rget "$R" package terms)
	if [ -n "$T" ]; then   # terms the user must accept first (an Epic Games ToS): recorded as root for the installer
		[ -n "$ACCEPT" ] || [ -f "/var/lib/pspexp/terms/$ID" ] || die "$ID: its terms must be accepted first ($T): pspexp-pkg install --accept-terms $ID"
		[ -z "$ACCEPT" ] || $APT_HELPER accept "$ID" >/dev/null || die "$ID: could not record the accepted terms"
	fi
	stage
	# what apt will install, recorded by the helper before the journal says staged:
	# recover finishes from it, not from the catalogue
	$APT_HELPER prepare "$ID" "$RV" >/dev/null || die "$ID: could not prepare its meta-package"
	jset staged; crash staged
	jset apt-started; crash apt-started
	$APT_HELPER resume "$ID" "$RV" || { echo "pspexp-pkg: the download or install did not finish (is the board online?): install it again, and it carries on" >&2; exit 1; }
	crash apt-unrecorded
	jset apt-done; crash apt-done
	# a system's core must now exist where the system file says
	for s in "$STAGE"/systems/*.system; do
		[ -f "$s" ] || continue
		c=$(sed -n 's/^exec=pspexp-run pspexp-retro \([^ ]*\) .*/\1/p' "$s")
		[ -z "$c" ] || [ -f "$c" ] || die "$ID: its core $c is not where Debian puts cores"
	done
	publish
	echo "installed $ID (recipe $RV)"
}

remove_recipe() {
	begin remove "$1"
	if [ ! -f "$APPS/$ID/package" ] || [ -z "$(field "$APPS/$ID" recipe)" ]; then
		if [ ! -d "$APPS/$ID" ] && [ ! -d "$APPS/.$ID.old" ] && [ -z "$(meta_version "$ID")" ]; then
			# (packages apt installed for it before its record was lost stay, marked automatic: apt autoremove)
			[ -n "$ABANDONED" ] && { echo "removed $ID (nothing of it was installed)"; return 0; }
			die "$ID is not installed"
		fi
	fi
	RV=$(field "$APPS/$ID" version | tr -dc 0-9)
	# staged: nothing to publish, and every system file it owns to unpublish
	rm -rf "$STAGE"; mkdir -p "$STAGE/systems"
	: > "$STAGE/unpublish"
	for s in "$SYS"/*.system; do [ -f "$s" ] && [ "$(sed -n 's/^pkg=//p' "$s" | head -1)" = "$ID" ] && basename "$s" >> "$STAGE/unpublish"; done
	manifest "$STAGE" > "$STAGE/MANIFEST"
	jset staged; crash staged
	# the launcher's files go first: no entry is left pointing at a removed program
	: > "$STATE/publishing"
	jset app-swap-started; crash app-swap-started
	rm -rf "$APPS/.$ID.old"; [ -d "$APPS/$ID" ] && mv "$APPS/$ID" "$APPS/.$ID.old"
	jset app-swapped
	publish_systems
	rm -rf "$APPS/.$ID.old"; rm -f "$STATE/publishing"
	jset apt-started; crash apt-started
	if [ -n "$(meta_version "$ID")" ]; then $APT_HELPER remove "$ID" || { echo "pspexp-pkg: the removal did not finish: remove it again, and it carries on" >&2; exit 1; }; fi
	crash apt-unrecorded
	rm -rf "$STAGE"; rm -f "$J"
	echo "removed $ID"
}

# ---- recover (§5.3) --------------------------------------------------------------------

recover() {
	[ -f "$J" ] || { rm -f "$STATE/publishing"; return 0; }
	OP=$(jget op); ID=$(jget id); RV=$(jget recipe_version); SERIAL=$(jget catalogue_serial); CP=$(jget checkpoint)
	STAGE="$STATE/stage/$ID"
	echo "recovering: $OP $ID (recipe $RV, catalogue $SERIAL) from $CP"
	if [ "$OP" = remove ]; then
		case "$CP" in
		staged) rm -rf "$STAGE"; rm -f "$J" "$STATE/publishing"; echo "nothing had changed"; return 0 ;;
		esac
		# the launcher's files: finish removing them
		rm -rf "$APPS/$ID" "$APPS/.$ID.old"
		[ -f "$STAGE/unpublish" ] && while read -r n; do [ -n "$n" ] && rm -f "$SYS/$n"; done < "$STAGE/unpublish"
		rm -f "$STATE/publishing"
		$APT_HELPER repair >/dev/null 2>&1 || true
		[ -n "$(meta_version "$ID")" ] && { $APT_HELPER remove "$ID" || { echo "$ID: apt could not remove it (still broken)" >&2; return 1; }; }
		rm -rf "$STAGE"; rm -f "$J"; echo "removed $ID"; return 0
	fi
	case "$CP" in
	staged)
		rm -rf "$STAGE"; rm -f "$J" "$STATE/publishing"; echo "nothing had changed"; return 0 ;;
	apt-started)   # did apt do it? ask dpkg (after finishing anything half-installed)
		$APT_HELPER repair >/dev/null 2>&1 || true
		if [ "$(meta_version "$ID")" != "$RV" ]; then
			# once more (Retry), from the meta-package the helper prepared for
			# this operation, not the catalogue, which may have changed since
			rc=0; $APT_HELPER resume "$ID" "$RV" >/dev/null 2>&1 || rc=$?
			if [ $rc = 3 ]; then
				# the helper's record is gone (prepare wrote it before the journal said staged):
				# apt may have installed part of it, so the operation stays open, broken
				echo "$ID is broken: the record of what apt was to install is missing, and apt may have begun (remove it: pspexp-pkg remove $ID)" >&2
				return 1
			fi
		fi
		[ "$(meta_version "$ID")" = "$RV" ] || { echo "$ID: its programs were not installed (is the board online?): install it again, or remove it" >&2; return 1; }
		jset apt-done ;;
	esac
	CP=$(jget checkpoint)
	if [ "$CP" = apt-done ] || [ "$CP" = app-swap-started ] || [ "$CP" = app-swapped ] || [ "$CP" = systems-started ] || [ "$CP" = systems-published ]; then
		if [ -d "$STAGE/app" ] || [ -d "$APPS/$ID" ]; then
			if ! staged_ok; then
				# the staged files are damaged (in the staging or already published): back to
				# exactly the old install, or to none
				if [ -d "$STAGE/app" ]; then   # not swapped in: $APPS/$ID is the old one, or it is aside
					[ -d "$APPS/.$ID.old" ] && { rm -rf "$APPS/$ID"; mv "$APPS/.$ID.old" "$APPS/$ID"; }
				else   # swapped in: $APPS/$ID is the damaged new one
					rm -rf "$APPS/$ID"; [ -d "$APPS/.$ID.old" ] && mv "$APPS/.$ID.old" "$APPS/$ID"
				fi
				for s in "$STAGE"/systems/*.system; do   # the new system files out (by name: theirs may be the damage)
					[ -f "$s" ] || continue; n=$(basename "$s")
					[ "$(sed -n 's/^pkg=//p' "$SYS/$n" 2>/dev/null | head -1)" = "$ID" ] && rm -f "$SYS/$n"
				done
				[ -d "$APPS/$ID/systems" ] && for s in "$APPS/$ID"/systems/*.system; do [ -f "$s" ] && cp "$s" "$SYS/"; done
				rm -rf "$STAGE"; rm -f "$J" "$STATE/publishing"
				if [ -d "$APPS/$ID" ]; then echo "$ID: its staged files were damaged; the previous install is back" >&2
				else echo "$ID: its staged files were damaged; nothing of it is published (its programs stay: pspexp-pkg remove $ID)" >&2; fi
				return 1
			fi
			case "$CP" in systems-started|systems-published) publish_systems; finish ;; *) publish ;; esac
			echo "installed $ID (recipe $RV)"
		fi
	fi
}

# ---- the catalogue for the Packages app ------------------------------------------------------

state_of() {   # installed | update | new | broken
	if [ "$FAMILY" = omega ]; then   # installed from the build the recipe names, at the version published
		[ -f "$APPS/$1/package" ] || { echo new; return; }
		b=$(rget "$CAT/$1/recipe" omega build)
		[ -n "$(field "$APPS/$1" recipe)" ] && [ "$(field "$APPS/$1" build)" = "$b" ] &&
			[ "$(field "$APPS/$1" version)" = "$(build_version "$b")" ] && [ "$(field "$APPS/$1" recipe_version)" = "$(rget "$CAT/$1/recipe" package version)" ] && echo installed || echo update
		return
	fi
	[ -f "$APPS/$1/package" ] || { [ -n "$(meta_version "$1")" ] && echo broken || echo new; return; }
	m=$(meta_version "$1")
	[ -z "$(field "$APPS/$1" recipe)" ] && { echo update; return; }   # an archive install of the same title: the recipe replaces it
	[ -n "$m" ] || { echo broken; return; }
	[ "$m" = "$(rget "$CAT/$1/recipe" package version)" ] && echo installed || echo update
}

# the catalogue for this board: id|recipe version|state|category|title|description|graphics|terms
# (graphics: how its first entry or system draws, "" not said; terms: what must be accepted before
# installing, "NAME URL", "" none)
# PSPExp itself (Debian boards): the console and launcher (pspexp-core) and the PSP's runtime
# (pspexp-runtime), one entry in Packages' Apps: "update" when apt has a newer one of either
# (installed through upgrade, as `pspexp-pkg upgrade`); never removed from here
self_line() {
	[ "$FAMILY" = debian ] || return 0
	v=$(dpkg-query -W -f='${Version}' pspexp-core 2>/dev/null) || return 0
	[ -n "$v" ] || return 0
	st=installed
	# both in one apt-cache call (each call is ~1 s on the GameShell)
	apt-cache policy pspexp-core pspexp-runtime 2>/dev/null | awk '
		/^[^ ]/ { p = $1 } /Installed:/ { i[p] = $2 } /Candidate:/ { c[p] = $2 }
		END { for (k in i) if (i[k] != "(none)" && c[k] != "" && c[k] != "(none)" && i[k] != c[k]) u = 1; exit !u }' && st=update
	printf 'pspexp|%s|%s|app|PSPExp|The console and launcher on this board and the PSP'"'"'s own runtime: an update brings both, then Settings > Restart PSPExp and Settings > Update the PSP.|sdl|\n' "$v" "$st"
}

# on a Debian board, every recipe in one awk pass, with one dpkg-query for the installed ones: as the
# loop below prints it, which forked ~14 programs a recipe (16 s for 48 lines on the GameShell, 5 s
# on the Pi, while Packages opened)
available_debian() {
	t=$(mktemp -d) || return 1
	dpkg-query -W -f='${Package} ${Status} ${Version}\n' 'pspexp-recipe-*' 2>/dev/null |
		awk '/install ok installed/ { sub(/^pspexp-recipe-/, "", $1); print $1, $NF }' > "$t/meta"
	: > "$t/apps"
	for f in "$APPS"/*/package; do [ -f "$f" ] && echo "$f"; done > "$t/list"
	[ -s "$t/list" ] && xargs awk 'FNR == 1 { if (id != "") print id, r; id = FILENAME; sub(/\/package$/, "", id); sub(/.*\//, "", id); r = 0 }
		/^recipe=./ { r = 1 } END { if (id != "") print id, r }' < "$t/list" > "$t/apps"
	awk -v fam="$FAMILY" -v board="$BOARD" -v metaf="$t/meta" -v appsf="$t/apps" '
	function get(sec, key) { return ((sec ":" board, key) in ov) ? ov[sec ":" board, key] : base[sec, key] }
	function flush(   id, g, w, st, v, terms) {
		if (file == "") return
		id = file; sub(/\/recipe$/, "", id); sub(/.*\//, "", id)
		if (get(fam, "apt") get(fam, "build") != "") {
			w = get(fam, "warn")
			g = get("entry", "graphics"); if (g == "") g = get("system", "graphics")
			v = get("package", "version")
			if (!(id in app)) st = (id in meta) ? "broken" : "new"
			else if (!app[id]) st = "update"
			else if (!(id in meta)) st = "broken"
			else st = (meta[id] == v) ? "installed" : "update"
			terms = get("package", "terms"); gsub(/\|/, " ", terms)
			printf "%s|%s|%s|%s|%s|%s%s|%s|%s\n", id, v, st, get("package", "category"), get("package", "title"), (w != "" ? w ". " : ""), get("package", "description"), g, terms
		}
		split("", base); split("", ov)
	}
	BEGIN { while ((getline l < metaf) > 0) { split(l, a, " "); meta[a[1]] = a[2] }
	        while ((getline l < appsf) > 0) { split(l, a, " "); app[a[1]] = a[2] + 0 } }
	FNR == 1 { flush(); file = FILENAME; s = "" }
	/^[ \t]*#/ || /^[ \t]*$/ { next }
	/^\[.*\][ \t]*$/ { s = $0; sub(/^\[/, "", s); sub(/\][ \t]*$/, "", s); next }
	{ i = index($0, "="); if (!i) next; k = substr($0, 1, i - 1); v = substr($0, i + 1)
	  gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v)
	  if (s ~ /:/) ov[s, k] = v; else base[s, k] = v }
	END { flush() }' "$CAT"/*/recipe
	rm -rf "$t"
}

available() {
	[ -d "$CAT" ] || die "no catalogue (pspexp-pkg update)"
	self_line
	[ "$FAMILY" = debian ] && { available_debian; return; }
	for r in "$CAT"/*/recipe; do
		[ -f "$r" ] || continue
		id=$(basename "$(dirname "$r")")
		[ -n "$(rget "$r" "$FAMILY" apt)$(rget "$r" "$FAMILY" build)" ] || continue   # nothing for this board
		w=$(rget "$r" "$FAMILY" warn)   # e.g. too heavy for this board: said first
		g=$(rget "$r" entry graphics); [ -n "$g" ] || g=$(rget "$r" system graphics)
		printf '%s|%s|%s|%s|%s|%s%s|%s|%s\n' "$id" "$(rget "$r" package version)" "$(state_of "$id")" "$(rget "$r" package category)" "$(rget "$r" package title)" "${w:+$w. }" "$(rget "$r" package description)" "$g" "$(rget "$r" package terms | tr '|' ' ')"
	done
}

cmd="$1"; [ $# -gt 0 ] && shift
case "$cmd" in
install)
	ACCEPT=; [ "$1" = --accept-terms ] && { ACCEPT=1; shift; }   # Packages asked the user to accept the recipe's terms=
	[ $# -ge 1 ] || die "usage: pspexp-pkg install [--accept-terms] ID|FILE.tar.gz..."
	lock
	for f in "$@"; do
		case "$f" in pspexp) [ "$FAMILY" = debian ] || die "pspexp: the Debian boards' entry"; $APT_HELPER upgrade ;;
		*.tar.gz|*.tgz|*/*) install_one "$f" ;; *) install_recipe "$f" ;; esac
	done ;;
remove)
	[ $# -ge 1 ] || die "usage: pspexp-pkg remove ID..."
	for i in "$@"; do [ "$i" = pspexp ] && die "PSPExp itself is not removed from Packages"; done
	lock
	for i in "$@"; do
		# a recipe's: installed by one, or the subject of an interrupted operation (abandoned, §5.3)
		if [ "$FAMILY" = debian ] && { [ -n "$(field "$APPS/$i" recipe)" ] || [ -n "$(meta_version "$i")" ] || [ "$(jget id)" = "$i" ]; }; then remove_recipe "$i"; else remove_one "$i"; fi
	done ;;
upgrade)
	lock
	for r in "$CAT"/*/recipe; do
		[ -f "$r" ] || continue
		i=$(basename "$(dirname "$r")")
		if [ "$FAMILY" = omega ]; then [ -f "$APPS/$i/package" ] && [ "$(state_of "$i")" = update ] && install_build "$i"
		else [ "$(state_of "$i")" = update ] && [ -n "$(meta_version "$i")" ] && install_recipe "$i"; fi
	done
	if [ "$FAMILY" = debian ]; then $APT_HELPER upgrade; fi ;;
recover) lock; if [ "$FAMILY" = debian ]; then recover; fi ;;
update)
	[ "$FAMILY" = debian ] || { echo "catalogue $(serial): $(ls "$CAT" 2>/dev/null | wc -l) recipes (the Mac publishes it: pspexp-pkg-build publish)"; exit 0; }
	lock; $APT_HELPER update ;;
list)
	for d in "$APPS"/*/; do
		[ -f "$d/package" ] || continue
		d=${d%/}
		printf '%-14s %-10s %s\n' "$(basename "$d")" "$(field "$d" version)" "$(field "$d" title)"
	done ;;
available) available ;;
check)
	# the recipes this board is offered, before the update: the first check's baseline
	seen="$STATE/seen-recipes"
	[ -f "$seen" ] || { available | cut -d'|' -f1 | sort > "$seen"; }
	if [ "$FAMILY" = debian ]; then ( lock; $APT_HELPER update >/dev/null 2>&1 ) || { echo "updates=0 new=0 error=update"; exit 1; }; fi
	list=$(available)
	new=$(printf '%s\n' "$list" | cut -d'|' -f1 | sort | comm -23 - "$seen" | grep -c . || true)
	updates=$(printf '%s\n' "$list" | awk -F'|' '$3 == "update"' | grep -c . || true)
	printf '%s\n' "$list" | cut -d'|' -f1 | grep . | sort > "$seen.new" && mv "$seen.new" "$seen"
	# PSPExp itself (its console or the PSP's runtime) said apart: the launcher names it
	self=$(printf '%s\n' "$list" | awk -F'|' '$1 == "pspexp" { print $3 }')
	echo "updates=$updates new=$new pspexp=${self:-none}" ;;
*) echo "usage: pspexp-pkg install ID|FILE.tar.gz... | remove ID... | upgrade | list | available | update | check | recover" >&2; exit 2 ;;
esac
