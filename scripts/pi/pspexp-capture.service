# systemd unit: PSPExp Capture's receiver (tools/pspexp-capture) beside the console. A native PSP
# game with the Capture plugin on (game.txt) reaches it under the plugin's own USB product, which
# the console leaves alone; the note button's clips (note+R, note+L) go to ~/Videos/PSPExp.
# For the invoking user, e.g. with @USER@, @HOME@ and @BIN@ filled in:
#   sudo cp scripts/pi/pspexp-capture.service /etc/systemd/system/ && systemctl enable --now pspexp-capture
[Unit]
Description=PSPExp Capture receiver (pspexp-capture)
After=multi-user.target

[Service]
User=@USER@
WorkingDirectory=@HOME@
ExecStart=@BIN@/pspexp-capture -k -s @HOME@/Videos/PSPExp
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
